{
  "$comment": "Fronteiras de import (D32/ADR-0002, docs/ARCHITECTURE.md). Allowlist = teto: importar menos é sempre permitido. STDLIB = pacotes da stdlib. '*' = tudo (só cmd/eon, a raiz de composição). Pacote interno não registrado aqui = violação. Dependência externa = violação a menos que esteja em allowed_external (D19: dependência é decisão deliberada com ADR). max_lines conta só código de produção (_test.go segue as MESMAS regras de import).",
  "module": "github.com/brook-sys/eon",
  "max_file_lines": 1500,
  "allowed_external": [],
  "packages": {
    "cmd/eon": { "imports": ["*"], "max_lines": 1000 },

    "internal/domain": { "imports": ["STDLIB"], "max_lines": 2000 },
    "internal/port": { "imports": ["STDLIB", "internal/domain"], "max_lines": 3000 },

    "internal/core": { "imports": ["STDLIB", "internal/domain", "internal/port", "internal/statefile"], "max_lines": 6000 },

    "internal/fronts/project": { "imports": ["STDLIB", "internal/domain", "internal/port", "internal/cognition"], "max_lines": 4000 },
    "internal/fronts/thoughts": { "imports": ["STDLIB", "internal/domain", "internal/port", "internal/cognition"], "max_lines": 4000 },
    "internal/fronts/self": { "imports": ["STDLIB", "internal/domain", "internal/port", "internal/cognition"], "max_lines": 4000 },

    "internal/cognition": { "imports": ["STDLIB", "internal/domain", "internal/port"], "max_lines": 8000 },

    "internal/capabilities/model": { "imports": ["STDLIB", "internal/domain", "internal/port", "internal/cognition"], "max_lines": 4000 },
    "internal/capabilities/web": { "imports": ["STDLIB", "internal/domain", "internal/port"], "max_lines": 3000 },
    "internal/capabilities/file": { "imports": ["STDLIB", "internal/domain", "internal/port"], "max_lines": 3000 },
    "internal/capabilities/git": { "imports": ["STDLIB", "internal/domain", "internal/port"], "max_lines": 3000 },
    "internal/capabilities/exec": { "imports": ["STDLIB", "internal/domain", "internal/port"], "max_lines": 3000 },

    "internal/storage": { "imports": ["STDLIB", "internal/domain", "internal/port"], "max_lines": 8000 },

    "internal/supervisor": { "imports": ["STDLIB", "internal/statefile"], "max_lines": 4000 },
    "internal/sandbox": { "imports": ["STDLIB", "internal/domain"], "max_lines": 4000 },
    "internal/worker": { "imports": ["STDLIB", "internal/domain", "internal/sandbox", "internal/statefile"], "max_lines": 4000 },
    "internal/statefile": { "imports": ["STDLIB"], "max_lines": 1000 },

    "tools/boundary": { "imports": ["STDLIB"], "max_lines": 2000 }
  }
}
