package views

templ Resources() {
	@layout("Recursos & Quotas", "/dash/resources", StandardNav("/dash/resources")) {
		<div x-data="resourcesState()" x-init="start()" class="space-y-8">
			<div class="flex items-center gap-4 text-sm bg-[var(--panel)] border border-[var(--border)] rounded-2xl px-5 py-4 shadow-sm">
				<span class="inline-flex items-center gap-3 font-bold">
					<span
						class="w-3 h-3 rounded-full"
						x-bind:class="connected ? 'bg-[var(--ok)] shadow-[0_0_8px_var(--ok)]' : 'bg-[var(--err)] shadow-[0_0_8px_var(--err)]'"
					></span>
					<span class="text-[var(--text)]" x-text="connected ? 'Conectado à API' : 'Sem conexão'"></span>
				</span>
				<span class="text-[var(--muted)] border-l border-[var(--border)] pl-4 font-medium" x-show="generatedAt">
					atualizado <span x-text="generatedAgo"></span>
				</span>
				<button
					class="ml-auto px-4 py-2 rounded-xl border border-[var(--border)] bg-[var(--bg)] text-[var(--muted)] hover:text-[var(--text)] hover:bg-[var(--panel-hover)] transition-all font-bold text-sm shadow-sm cursor-pointer"
					x-on:click="refresh()"
				>↻ Atualizar</button>
			</div>

			@card("Estado Global de Quotas") {
				<div class="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
					<template x-if="resources.length === 0">
						<div class="col-span-full">
							@EmptyState("Nenhum recurso de quota monitorado.")
						</div>
					</template>
					<template x-for="r in resources" x-bind:key="r.name ?? Math.random()">
						<div class="p-5 rounded-2xl bg-[var(--bg)] border border-[var(--border)] shadow-sm hover:border-[var(--border-focus)]/30 transition-colors space-y-4">
							<div class="flex justify-between items-center text-sm font-mono">
								<span class="font-bold text-[var(--text)] truncate mr-2" x-text="r.name ?? '–'"></span>
								<span
									class="px-2 py-1 rounded-md text-xs font-bold tracking-widest"
									x-bind:class="(r.usage_ratio ?? 0) > 0.8 ? 'bg-[var(--err)]/20 text-[var(--err)]' : 'bg-[var(--ok)]/20 text-[var(--ok)]'"
									x-text="((r.usage_ratio ?? 0) * 100).toFixed(1) + '%'"
								></span>
							</div>
							<div class="w-full bg-[var(--panel)] rounded-full h-2.5 overflow-hidden border border-[var(--border)]">
								<div
									class="h-full rounded-full transition-all duration-500 ease-out"
									x-bind:class="(r.usage_ratio ?? 0) > 0.8 ? 'bg-[var(--err)] shadow-[0_0_8px_var(--err)]' : 'bg-[var(--ok)] shadow-[0_0_8px_var(--ok)]'"
									x-bind:style="'width: ' + Math.min(100, Math.max(0, (r.usage_ratio ?? 0) * 100)) + '%'"
								></div>
							</div>
							<div class="flex justify-between text-xs text-[var(--muted)] font-mono font-medium">
								<span>Usado: <strong class="text-[var(--text)]" x-text="r.used ?? 0"></strong></span>
								<span>Limite: <strong class="text-[var(--text)]" x-text="r.limit ?? 0"></strong></span>
							</div>
							<div class="text-[10px] text-[var(--subtle)] font-mono truncate" x-show="r.reset_at" x-text="'Reseta: ' + r.reset_at"></div>
						</div>
					</template>
				</div>
			}
		</div>
		<script>
			function resourcesState() {
				return {
					connected: false,
					generatedAt: null,
					resources: [],
					
					get generatedAgo() {
						if (!this.generatedAt) return '';
						const s = Math.max(0, (Date.now() - this.generatedAt) / 1000 | 0);
						return s < 60 ? `${s}s atrás` : `${s/60|0}min atrás`;
					},
					
					fmt(n) { return n == null ? '0' : Number(n).toLocaleString('pt-BR'); },
					
					async refresh() {
						try {
							const res = await fetch('/dash/api/resources');
							const data = await res.json();
							this.resources = data?.resources || [];
							this.generatedAt = Date.now();
							this.connected = true;
						} catch (e) {
							this.connected = false;
						}
					},
					
					start() {
						this.refresh();
						setInterval(() => this.refresh(), 10000);
					}
				};
			}
		</script>
	}
}
