package views

templ Resources() {
	@layout("Recursos & Quotas", "/dash/resources", StandardNav("/dash/resources")) {
		<div x-data="resourcesState()" x-init="start()" class="space-y-8">
			<div class="flex items-center justify-between gap-4 bg-[var(--panel)] border border-[var(--border)] rounded-[20px] p-6 shadow-sm">
				<div class="flex items-center gap-5">
					<div class="relative flex h-3 w-3 items-center justify-center">
						<span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75" x-bind:class="connected ? 'bg-[var(--ok)]' : 'bg-[var(--err)]'"></span>
						<span class="relative inline-flex rounded-full h-3 w-3" x-bind:class="connected ? 'bg-[var(--ok)] shadow-[0_0_8px_var(--ok)]' : 'bg-[var(--err)] shadow-[0_0_8px_var(--err)]'"></span>
					</div>
					<div class="flex flex-col">
						<span class="text-[15px] font-bold text-[var(--text)]" x-text="connected ? 'Conectado à API' : 'Sem conexão'"></span>
						<span class="text-[13px] text-[var(--muted)]" x-show="generatedAt">Último sync há <span x-text="generatedAgo"></span></span>
					</div>
				</div>
				<button
					class="px-5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--panel-sub)] text-[var(--text)] hover:bg-[var(--panel-hover)] transition-all font-semibold text-[13px] shadow-sm flex items-center gap-2 cursor-pointer"
					x-on:click="refresh()"
				>
					<svg class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
					Atualizar
				</button>
			</div>

			@card("Monitoramento Global de Quotas") {
				<div class="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
					<template x-if="resources.length === 0">
						<div class="col-span-full">
							@EmptyState("Nenhuma política de quota atrelada a esse projeto.")
						</div>
					</template>
					<template x-for="r in resources" x-bind:key="r.name ?? Math.random()">
						<div class="p-6 rounded-[20px] bg-[var(--bg)] border border-[var(--border)] shadow-sm hover:border-[var(--border-focus)] transition-colors space-y-5">
							<div class="flex justify-between items-center text-[14px] font-mono">
								<span class="font-bold text-[var(--text)] truncate mr-3" x-text="r.name ?? '–'"></span>
								<span
									class="px-2.5 py-1 rounded-md text-[12px] font-bold tracking-wider"
									x-bind:class="(r.usage_ratio ?? 0) > 0.8 ? 'bg-[var(--err)]/20 text-[var(--err)]' : 'bg-[var(--ok)]/10 text-[var(--ok)]'"
									x-text="((r.usage_ratio ?? 0) * 100).toFixed(1) + '%'"
								></span>
							</div>
							
							<!-- Custom Progress Bar -->
							<div class="w-full bg-[var(--panel)] rounded-full h-3 overflow-hidden border border-[var(--border)]">
								<div
									class="h-full rounded-full transition-all duration-1000 ease-out"
									x-bind:class="(r.usage_ratio ?? 0) > 0.8 ? 'bg-[var(--err)]' : 'bg-white'"
									x-bind:style="'width: ' + Math.min(100, Math.max(0, (r.usage_ratio ?? 0) * 100)) + '%'"
								></div>
							</div>
							
							<div class="flex justify-between text-[12px] text-[var(--muted)] font-mono">
								<span>Usado: <strong class="text-[var(--text)] font-semibold" x-text="r.used ?? 0"></strong></span>
								<span>Limite: <strong class="text-[var(--text)] font-semibold" x-text="r.limit ?? 0"></strong></span>
							</div>
							
							<div class="text-[11px] text-[var(--subtle)] font-mono truncate pt-3 border-t border-[var(--border)]" x-show="r.reset_at" x-text="'Reseta: ' + r.reset_at"></div>
						</div>
					</template>
				</div>
			}

			@card("Pressão de Retenção — Event Log") {
				<template x-if="!retentionLoaded">
					<div class="col-span-full">
						@EmptyState("Carregando dados de retenção...")
					</div>
				</template>
				<template x-if="retentionLoaded">
					<div class="space-y-6">
						<!-- KPI row -->
						<div class="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
							<div class="p-5 rounded-[16px] bg-[var(--bg)] border border-[var(--border)] space-y-2">
								<div class="text-[12px] font-semibold text-[var(--muted)] uppercase tracking-wider">Event Head</div>
								<div class="text-2xl font-extrabold font-mono text-[var(--text)]" x-text="retention.event_head_sequence ?? 0"></div>
							</div>
							<div class="p-5 rounded-[16px] bg-[var(--bg)] border border-[var(--border)] space-y-2">
								<div class="text-[12px] font-semibold text-[var(--muted)] uppercase tracking-wider">Pressão</div>
								<div class="text-2xl font-extrabold font-mono"
									x-bind:class="retention.event_head_pressure === 'warn' ? 'text-[var(--warn)]' : retention.event_head_pressure === 'info' ? 'text-[var(--info)]' : 'text-[var(--ok)]'"
									x-text="retention.event_head_pressure || 'normal'"></div>
							</div>
							<div class="p-5 rounded-[16px] bg-[var(--bg)] border border-[var(--border)] space-y-2">
								<div class="text-[12px] font-semibold text-[var(--muted)] uppercase tracking-wider">Artefatos Obsoletos</div>
								<div class="text-2xl font-extrabold font-mono"
									x-bind:class="(retention.stale_artifact_count ?? 0) > 0 ? 'text-[var(--warn)]' : 'text-[var(--ok)]'"
									x-text="(retention.stale_artifact_count ?? 0) + ' / ' + (retention.artifact_count ?? 0)"></div>
							</div>
							<div class="p-5 rounded-[16px] bg-[var(--bg)] border border-[var(--border)] space-y-2">
								<div class="text-[12px] font-semibold text-[var(--muted)] uppercase tracking-wider">Prune Autorizado</div>
								<div class="text-2xl font-extrabold font-mono"
									x-bind:class="retention.allow_event_log_prune ? 'text-[var(--warn)]' : 'text-[var(--ok)]'"
									x-text="retention.allow_event_log_prune ? 'SIM' : 'NÃO'"></div>
							</div>
						</div>

						<!-- Findings -->
						<template x-if="(retention.findings ?? []).length > 0">
							<div class="space-y-3">
								<div class="text-[13px] font-bold text-[var(--muted)] uppercase tracking-wider">Achados</div>
								<div class="space-y-2">
									<template x-for="f in retention.findings" x-bind:key="f">
										<div class="text-[13px] font-mono text-[var(--subtle)] bg-[var(--bg)] rounded-lg px-4 py-2.5 border border-[var(--border)]" x-text="f"></div>
									</template>
								</div>
							</div>
						</template>

						<!-- Refresh candidates -->
						<template x-if="(retention.refresh_candidates ?? []).length > 0">
							<div class="space-y-3">
								<div class="text-[13px] font-bold text-[var(--muted)] uppercase tracking-wider">
									Candidatos a Refresh
									<span class="text-[11px] font-normal text-[var(--subtle)] ml-2" x-text="'(' + retention.refresh_candidate_count + ' total)'"></span>
								</div>
								<div class="overflow-x-auto">
									<table class="w-full text-[13px] font-mono">
										<thead>
											<tr class="text-left text-[var(--muted)] border-b border-[var(--border)]">
												<th class="pb-3 pr-4">Artefato</th>
												<th class="pb-3 pr-4">Tipo</th>
												<th class="pb-3 pr-4">Regenerável</th>
												<th class="pb-3">Razão</th>
											</tr>
										</thead>
										<tbody>
											<template x-for="c in retention.refresh_candidates" x-bind:key="c.artifact_id">
												<tr class="border-b border-[var(--border)]/50 hover:bg-[var(--panel-sub)]/50 transition-colors">
													<td class="py-2.5 pr-4 text-[var(--text)] truncate max-w-[200px]" x-text="c.artifact_id"></td>
													<td class="py-2.5 pr-4 text-[var(--subtle)]" x-text="c.kind"></td>
													<td class="py-2.5 pr-4">
														<span class="px-2 py-0.5 rounded-md text-[11px] font-bold"
															x-bind:class="c.regenerable ? 'bg-[var(--ok)]/10 text-[var(--ok)]' : 'bg-[var(--subtle)]/10 text-[var(--subtle)]'"
															x-text="c.regenerable ? 'Sim' : 'Não'"></span>
													</td>
													<td class="py-2.5 text-[var(--subtle)]" x-text="c.reason"></td>
												</tr>
											</template>
										</tbody>
									</table>
								</div>
							</div>
						</template>

						<!-- Observed at -->
						<div class="text-[11px] text-[var(--subtle)] font-mono pt-3 border-t border-[var(--border)]" x-show="retention.observed_at" x-text="'Observado em: ' + retention.observed_at"></div>
					</div>
				</template>
			}
		</div>
		<script>
			function resourcesState() {
				return {
					connected: false,
					generatedAt: null,
					resources: [],
					retention: {},
					retentionLoaded: false,
					
					get generatedAgo() {
						if (!this.generatedAt) return '';
						const s = Math.max(0, (Date.now() - this.generatedAt) / 1000 | 0);
						return s < 60 ? `${s}s atrás` : `${s/60|0}min atrás`;
					},
					
					fmt(n) { return n == null ? '0' : Number(n).toLocaleString('pt-BR'); },
					
					async refresh() {
						try {
							const [resData, retData] = await Promise.all([
								fetch('/dash/api/resources').then(r => r.json()),
								fetch('/dash/api/store/retention').then(r => r.json()).catch(() => ({}))
							]);
							this.resources = resData?.resources || [];
							this.retention = retData || {};
							this.retentionLoaded = true;
							this.generatedAt = Date.now();
							this.connected = true;
						} catch (e) {
							this.connected = false;
						}
					},
					
					start() {
						this.refresh();
						setInterval(() => this.refresh(), 10000);
					}
				};
			}
		</script>
	}
}
