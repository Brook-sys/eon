package views

templ Knowledge() {
	@layout("Base de Conhecimento", "/dash/knowledge", StandardNav("/dash/knowledge")) {
		<div x-data="knowledgeState()" x-init="start()" class="space-y-8">
			<div class="flex items-center justify-between gap-4 bg-[var(--panel)] border border-[var(--border)] rounded-[20px] p-6 shadow-sm">
				<div class="flex items-center gap-5">
					<div class="relative flex h-3 w-3 items-center justify-center">
						<span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75" x-bind:class="connected ? 'bg-[var(--ok)]' : 'bg-[var(--err)]'"></span>
						<span class="relative inline-flex rounded-full h-3 w-3" x-bind:class="connected ? 'bg-[var(--ok)] shadow-[0_0_8px_var(--ok)]' : 'bg-[var(--err)] shadow-[0_0_8px_var(--err)]'"></span>
					</div>
					<div class="flex flex-col">
						<span class="text-[15px] font-bold text-[var(--text)]" x-text="connected ? 'Conectado à API' : 'Sem conexão'"></span>
						<span class="text-[13px] text-[var(--muted)]" x-show="generatedAt">Último sync há <span x-text="generatedAgo"></span></span>
					</div>
				</div>
				<button
					class="px-5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--panel-sub)] text-[var(--text)] hover:bg-[var(--panel-hover)] transition-all font-semibold text-[13px] shadow-sm flex items-center gap-2 cursor-pointer"
					x-on:click="refresh()"
				>
					<svg class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
					Atualizar
				</button>
			</div>

			<div class="grid gap-6 grid-cols-1 sm:grid-cols-3">
				@StatCardAlpine("Documentos Indexados", "fmt(totalDocs)", "na base de conhecimento", "text-[var(--text)]")
				@StatCardAlpine("Consultas (24h)", "fmt(recentQueries)", "últimas consultas", "text-[var(--info)]")
				@StatCardAlpine("Miss Hits", "fmt(missHits)", "termos não encontrados", "text-[var(--warn)]")
			</div>

			@card("Busca Exploratória na Base") {
				<div class="space-y-6">
					<div class="flex flex-col md:flex-row gap-4">
						<div class="relative flex-1">
							<div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
								<svg class="w-5 h-5 text-[var(--subtle)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
							</div>
							<input type="text" x-model="searchQuery" class="w-full pl-11 pr-4 py-4" placeholder="Pesquise por contexto, regras de negócio ou estrutura técnica..." @keyup.enter="search()"/>
						</div>
						<button class="px-8 py-4 rounded-xl bg-white text-black font-semibold text-[14px] hover:bg-[var(--accent-hover)] shadow-sm cursor-pointer transition-all flex items-center justify-center gap-2" @click="search()">
							Buscar
						</button>
					</div>
					
					<div class="space-y-4 pt-4 border-t border-[var(--border)]" x-show="searchResults.length > 0">
						<template x-for="res in searchResults" x-bind:key="res.id ?? Math.random()">
							<div class="p-6 rounded-[20px] bg-[var(--bg)] border border-[var(--border)] space-y-3 hover:border-[var(--border-focus)] transition-colors cursor-pointer shadow-sm group">
								<div class="flex justify-between items-start gap-4">
									<div class="font-bold text-[16px] text-[var(--text)] group-hover:text-white transition-colors" x-text="res.title"></div>
									<span class="text-[11px] font-mono px-3 py-1 bg-[var(--panel)] border border-[var(--border)] rounded-lg text-[var(--muted)]" x-text="res.id"></span>
								</div>
								<div class="text-[14px] text-[var(--muted)] line-clamp-3 leading-relaxed" x-text="res.snippet"></div>
								<div class="flex gap-2 items-center text-[12px] text-[var(--info)] font-mono font-bold pt-2">
									<span x-text="'Score: ' + (res.score ? res.score.toFixed(2) : '0.00')"></span>
								</div>
							</div>
						</template>
					</div>
					<div x-show="searched && searchResults.length === 0">
						@EmptyState("Nenhum resultado encontrado para esta busca.")
					</div>
				</div>
			}
		</div>
		<script>
			function knowledgeState() {
				return {
					connected: false,
					generatedAt: null,
					totalDocs: 0,
					recentQueries: 0,
					missHits: 0,
					
					searchQuery: '',
					searched: false,
					searchResults: [],
					
					get generatedAgo() {
						if (!this.generatedAt) return '';
						const s = Math.max(0, (Date.now() - this.generatedAt) / 1000 | 0);
						return s < 60 ? `${s}s atrás` : `${s/60|0}min atrás`;
					},
					
					fmt(n) { return n == null ? '0' : Number(n).toLocaleString('pt-BR'); },
					
					async refresh() {
						try {
							const res = await fetch('/dash/api/knowledge/stats');
							const data = await res.json();
							this.totalDocs = data?.total_docs || 0;
							this.recentQueries = data?.recent_queries || 0;
							this.missHits = data?.miss_hits || 0;
							
							this.generatedAt = Date.now();
							this.connected = true;
						} catch (e) {
							this.connected = false;
						}
					},
					
					async search() {
						if(!this.searchQuery.trim()) return;
						this.searched = true;
						try {
							const res = await fetch('/dash/api/knowledge/search?q=' + encodeURIComponent(this.searchQuery));
							const data = await res.json();
							this.searchResults = data?.results || [];
						} catch(e) {
							this.searchResults = [];
						}
					},
					
					start() {
						this.refresh();
					}
				};
			}
		</script>
	}
}
