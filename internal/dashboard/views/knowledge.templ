package views

templ Knowledge() {
	@layout("Base de Conhecimento", "/dash/knowledge", StandardNav("/dash/knowledge")) {
		<div x-data="knowledgeState()" x-init="start()" class="space-y-8">
			<div class="flex items-center gap-4 text-sm bg-[var(--panel)] border border-[var(--border)] rounded-2xl px-5 py-4 shadow-sm">
				<span class="inline-flex items-center gap-3 font-bold">
					<span
						class="w-3 h-3 rounded-full"
						x-bind:class="connected ? 'bg-[var(--ok)] shadow-[0_0_8px_var(--ok)]' : 'bg-[var(--err)] shadow-[0_0_8px_var(--err)]'"
					></span>
					<span class="text-[var(--text)]" x-text="connected ? 'Conectado à API' : 'Sem conexão'"></span>
				</span>
				<span class="text-[var(--muted)] border-l border-[var(--border)] pl-4 font-medium" x-show="generatedAt">
					atualizado <span x-text="generatedAgo"></span>
				</span>
				<button
					class="ml-auto px-4 py-2 rounded-xl border border-[var(--border)] bg-[var(--bg)] text-[var(--muted)] hover:text-[var(--text)] hover:bg-[var(--panel-hover)] transition-all font-bold text-sm shadow-sm cursor-pointer"
					x-on:click="refresh()"
				>↻ Atualizar</button>
			</div>

			<div class="grid gap-6 grid-cols-1 sm:grid-cols-3">
				@StatCardAlpine("Documentos Indexados", "fmt(totalDocs)", "na base de conhecimento", "text-[var(--text)]")
				@StatCardAlpine("Consultas Recentes", "fmt(recentQueries)", "últimas 24 horas", "text-[var(--accent)]")
				@StatCardAlpine("Miss Hits", "fmt(missHits)", "termos não encontrados", "text-[var(--warn)]")
			</div>

			@card("Busca na Base") {
				<div class="space-y-4">
					<div class="flex gap-3">
						<input type="text" x-model="searchQuery" class="flex-1" placeholder="Pesquisar contexto, regras, arquitetura..." @keyup.enter="search()"/>
						<button class="px-6 py-2 rounded-xl bg-[var(--accent)] text-[#000] font-bold text-sm hover:opacity-90 shadow-sm cursor-pointer" @click="search()">Buscar</button>
					</div>
					
					<div class="space-y-4 pt-4 border-t border-[var(--border)]" x-show="searchResults.length > 0">
						<template x-for="res in searchResults" x-bind:key="res.id ?? Math.random()">
							<div class="p-4 rounded-xl bg-[var(--bg)] border border-[var(--border)] space-y-2 hover:border-[var(--accent)]/40 transition-colors cursor-pointer shadow-sm">
								<div class="flex justify-between items-start gap-4">
									<div class="font-bold text-[var(--text)]" x-text="res.title"></div>
									<span class="text-[10px] font-mono px-2 py-1 bg-[var(--panel)] rounded-md text-[var(--muted)]" x-text="res.id"></span>
								</div>
								<div class="text-xs text-[var(--muted)] line-clamp-2 leading-relaxed" x-text="res.snippet"></div>
								<div class="flex gap-2 items-center text-[10px] text-[var(--accent)] font-mono font-bold">
									<span x-text="'Score: ' + (res.score ? res.score.toFixed(2) : '0.00')"></span>
								</div>
							</div>
						</template>
					</div>
					<div class="p-8 text-center text-sm text-[var(--muted)] bg-[var(--bg)]/50 rounded-xl border border-dashed border-[var(--border)]" x-show="searched && searchResults.length === 0">
						Nenhum resultado encontrado para esta busca.
					</div>
				</div>
			}
		</div>
		<script>
			function knowledgeState() {
				return {
					connected: false,
					generatedAt: null,
					totalDocs: 0,
					recentQueries: 0,
					missHits: 0,
					
					searchQuery: '',
					searched: false,
					searchResults: [],
					
					get generatedAgo() {
						if (!this.generatedAt) return '';
						const s = Math.max(0, (Date.now() - this.generatedAt) / 1000 | 0);
						return s < 60 ? `${s}s atrás` : `${s/60|0}min atrás`;
					},
					
					fmt(n) { return n == null ? '0' : Number(n).toLocaleString('pt-BR'); },
					
					async refresh() {
						try {
							const res = await fetch('/dash/api/knowledge/stats');
							const data = await res.json();
							this.totalDocs = data?.total_docs || 0;
							this.recentQueries = data?.recent_queries || 0;
							this.missHits = data?.miss_hits || 0;
							
							this.generatedAt = Date.now();
							this.connected = true;
						} catch (e) {
							this.connected = false;
						}
					},
					
					async search() {
						if(!this.searchQuery.trim()) return;
						this.searched = true;
						try {
							const res = await fetch('/dash/api/knowledge/search?q=' + encodeURIComponent(this.searchQuery));
							const data = await res.json();
							this.searchResults = data?.results || [];
						} catch(e) {
							this.searchResults = [];
						}
					},
					
					start() {
						this.refresh();
					}
				};
			}
		</script>
	}
}
