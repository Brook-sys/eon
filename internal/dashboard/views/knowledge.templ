package views

templ Knowledge() {
	@layout("Conhecimento", "/dash/knowledge", StandardNav("/dash/knowledge")) {
		<div x-data="knowledgeState()" x-init="start()" class="space-y-4">
			<div class="flex items-center gap-3 text-sm">
				<span class="inline-flex items-center gap-1.5">
					<span class="w-2 h-2 rounded-full" :class="ok?'bg-[var(--ok)]':'bg-[var(--err)]'"></span>
					<span x-text="ok?'Inspect API acessível':'sem resposta da Inspect API'"></span>
				</span>
				<span class="text-[var(--muted)]" x-show="at">atualizado <span x-text="ago"></span></span>
				<button class="ml-auto px-2 py-1 rounded border border-[var(--border)] text-[var(--muted)] hover:text-[var(--text)]" @click="refresh()">↻ Atualizar</button>
			</div>
			<div class="grid gap-4 grid-cols-2 md:grid-cols-4" x-show="sum">
				@card("Fontes") {
					<p class="text-2xl font-bold" x-text="sum?.sources??'–'"></p>
					<p class="text-xs text-[var(--muted)]" x-text="(sum?.source_versions??0)+' versões'"></p>
				}
				@card("Observações") {
					<p class="text-2xl font-bold" x-text="sum?.observations??'–'"></p>
				}
				@card("Claims") {
					<p class="text-2xl font-bold" x-text="sum?.claims??'–'"></p>
					<p class="text-xs" :class="(sum?.claims_without_evidence??0)>0?'text-[var(--warn)]':'text-[var(--muted)]'" x-text="(sum?.claims_without_evidence??0)+' sem evidência'"></p>
				}
				@card("Artefatos") {
					<p class="text-2xl font-bold" x-text="sum?.artifacts??'–'"></p>
					<p class="text-xs" :class="(sum?.stale_artifacts??0)>0?'text-[var(--err)]':'text-[var(--muted)]'" x-text="(sum?.stale_artifacts??0)+' stale'"></p>
				}
			</div>
			<div class="grid gap-4 grid-cols-2" x-show="sum">
				@card("Evidence Links") {
					<p class="text-2xl font-bold" x-text="sum?.evidence_links??'–'"></p>
				}
				@card("Contradições") {
					<p class="text-2xl font-bold" :class="(sum?.contradicting_evidence_links??0)>0?'text-[var(--err)]':'text-[var(--text)]'" x-text="sum?.contradicting_evidence_links??'0'"></p>
					<p class="text-xs text-[var(--muted)]" x-text="(sum?.supporting_evidence_links??0)+' suportando'"></p>
				}
			</div>
			<div class="flex gap-1 border-b border-[var(--border)]">
				<template x-for="t in tabs" :key="t.id">
					<button class="px-3 py-2 text-sm border-b-2" :class="tab===t.id?'border-[var(--accent)] text-[var(--text)]':'border-transparent text-[var(--muted)]'" @click="tab=t.id" x-text="t.label"></button>
				</template>
			</div>
			<div x-show="tab==='sources'">
				<div class="flex flex-wrap gap-2 items-end mb-3">
					<label class="flex flex-col gap-1 text-xs text-[var(--muted)]">Kind
						<select class="bg-[var(--panel)] border border-[var(--border)] rounded px-2 py-1.5 text-sm" x-model="srcK" @change="srcOff=0;dSrc()"><option value="">todos</option><option value="http_fetch">http_fetch</option><option value="web_search">web_search</option><option value="file">file</option><option value="operator">operator</option></select>
					</label>
					<label class="flex flex-col gap-1 text-xs text-[var(--muted)]">Busca
						<input type="text" class="bg-[var(--panel)] border border-[var(--border)] rounded px-2 py-1.5 text-sm w-48" x-model="srcQ" @keydown.enter="srcOff=0;dSrc()" placeholder="filtrar locator..."/>
					</label>
					<button class="px-3 py-1.5 rounded border border-[var(--border)] text-sm text-[var(--muted)]" @click="srcOff=0;dSrc()">Buscar</button>
					<span class="text-xs text-[var(--muted)] ml-auto" x-text="srcPg?(srcPg.total+' fontes'):''"></span>
				</div>
				@card("Fontes de conhecimento") {
					<div x-show="!(srcPg?.items?.length)" class="text-sm text-[var(--muted)]">Nenhuma fonte.</div>
					<div class="overflow-x-auto" x-show="srcPg?.items?.length">
						<table class="w-full text-sm">
							<thead><tr class="text-left text-[var(--muted)] text-xs uppercase"><th class="py-2 pr-3">Locator</th><th class="py-2 pr-3">Kind</th><th class="py-2 pr-3">Versões</th><th class="py-2">Observado</th></tr></thead>
							<tbody class="divide-y divide-[var(--border)]">
								<template x-for="s in srcPg?.items??[]" :key="s.id">
									<tr><td class="py-2 pr-3 max-w-xs truncate" x-text="s.locator" :title="s.locator"></td><td class="py-2 pr-3 text-xs" x-text="s.kind"></td><td class="py-2 pr-3" x-text="s.versions"></td><td class="py-2 text-xs text-[var(--muted)]" x-text="ft(s.observed_at)"></td></tr>
								</template>
							</tbody>
						</table>
					</div>
					<div class="mt-3 flex gap-2 items-center" x-show="srcPg&&(srcPg.limit<srcPg.total||srcPg.offset>0)">
						<button class="px-2 py-1 rounded border border-[var(--border)] text-sm disabled:opacity-40" :disabled="!srcPg||srcPg.offset===0" @click="srcOff-=P;dSrc()">← Anterior</button>
						<button class="px-2 py-1 rounded border border-[var(--border)] text-sm disabled:opacity-40" :disabled="!srcPg||(srcPg.offset+srcPg.limit)>=srcPg.total" @click="srcOff+=P;dSrc()">Próxima →</button>
						<span class="text-xs text-[var(--muted)] ml-auto" x-text="srcPg&&(srcPg.offset+'–'+Math.min(srcPg.offset+srcPg.limit,srcPg.total)+' de '+srcPg.total)"></span>
					</div>
				}
			</div>
			<div x-show="tab==='observations'">
				<div class="flex flex-wrap gap-2 items-end mb-3">
					<label class="flex flex-col gap-1 text-xs text-[var(--muted)]">Provenance
						<select class="bg-[var(--panel)] border border-[var(--border)] rounded px-2 py-1.5 text-sm" x-model="obsP" @change="obsOff=0;dObs()"><option value="">todas</option><option value="primary">primary</option><option value="secondary">secondary</option><option value="inferred">inferred</option></select>
					</label>
					<label class="flex items-center gap-2 text-xs text-[var(--muted)] cursor-pointer"><input type="checkbox" class="accent-[var(--accent)]" x-model="obsL" @change="obsOff=0;dObs()"/><span>somente vinculadas</span></label>
					<label class="flex flex-col gap-1 text-xs text-[var(--muted)]">Busca
						<input type="text" class="bg-[var(--panel)] border border-[var(--border)] rounded px-2 py-1.5 text-sm w-48" x-model="obsQ" @keydown.enter="obsOff=0;dObs()" placeholder="filtrar statement..."/>
					</label>
					<button class="px-3 py-1.5 rounded border border-[var(--border)] text-sm text-[var(--muted)]" @click="obsOff=0;dObs()">Buscar</button>
					<span class="text-xs text-[var(--muted)] ml-auto" x-text="obsPg?(obsPg.total+' observações'):''"></span>
				</div>
				@card("Observações") {
					<div x-show="!(obsPg?.items?.length)" class="text-sm text-[var(--muted)]">Nenhuma observação.</div>
					<div class="overflow-x-auto" x-show="obsPg?.items?.length">
						<table class="w-full text-sm">
							<thead><tr class="text-left text-[var(--muted)] text-xs uppercase"><th class="py-2 pr-3">Statement</th><th class="py-2 pr-3">Provenance</th><th class="py-2 pr-3">Fragmento</th><th class="py-2">Receipt</th></tr></thead>
							<tbody class="divide-y divide-[var(--border)]">
								<template x-for="o in obsPg?.items??[]" :key="o.id">
									<tr><td class="py-2 pr-3 max-w-sm truncate" x-text="o.statement" :title="o.statement"></td><td class="py-2 pr-3"><span class="px-2 py-0.5 rounded-full text-xs font-semibold border border-[var(--accent)] text-[var(--accent)]" x-text="o.provenance"></span></td><td class="py-2 pr-3 text-xs mono" x-text="sh(o.source_fragment_id)||'–'"></td><td class="py-2 text-xs mono" x-text="sh(o.receipt_id)||'–'"></td></tr>
								</template>
							</tbody>
						</table>
					</div>
					<div class="mt-3 flex gap-2 items-center" x-show="obsPg&&(obsPg.limit<obsPg.total||obsPg.offset>0)">
						<button class="px-2 py-1 rounded border border-[var(--border)] text-sm disabled:opacity-40" :disabled="!obsPg||obsPg.offset===0" @click="obsOff-=P;dObs()">← Anterior</button>
						<button class="px-2 py-1 rounded border border-[var(--border)] text-sm disabled:opacity-40" :disabled="!obsPg||(obsPg.offset+obsPg.limit)>=obsPg.total" @click="obsOff+=P;dObs()">Próxima →</button>
						<span class="text-xs text-[var(--muted)] ml-auto" x-text="obsPg&&(obsPg.offset+'–'+Math.min(obsPg.offset+obsPg.limit,obsPg.total)+' de '+obsPg.total)"></span>
					</div>
				}
			</div>
			<div x-show="tab==='claims'">
				<div class="flex flex-wrap gap-2 items-end mb-3">
					<label class="flex items-center gap-2 text-xs text-[var(--muted)] cursor-pointer"><input type="checkbox" class="accent-[var(--accent)]" x-model="clmW" @change="clmOff=0;dClm()"/><span>sem evidência</span></label>
					<label class="flex items-center gap-2 text-xs text-[var(--muted)] cursor-pointer"><input type="checkbox" class="accent-[var(--accent)]" x-model="clmC" @change="clmOff=0;dClm()"/><span>com contradição</span></label>
					<label class="flex flex-col gap-1 text-xs text-[var(--muted)]">Busca
						<input type="text" class="bg-[var(--panel)] border border-[var(--border)] rounded px-2 py-1.5 text-sm w-48" x-model="clmQ" @keydown.enter="clmOff=0;dClm()" placeholder="filtrar statement..."/>
					</label>
					<button class="px-3 py-1.5 rounded border border-[var(--border)] text-sm text-[var(--muted)]" @click="clmOff=0;dClm()">Buscar</button>
					<span class="text-xs text-[var(--muted)] ml-auto" x-text="clmPg?(clmPg.total+' claims'):''"></span>
				</div>
				@card("Claims") {
					<div x-show="!(clmPg?.items?.length)" class="text-sm text-[var(--muted)]">Nenhum claim.</div>
					<div class="overflow-x-auto" x-show="clmPg?.items?.length">
						<table class="w-full text-sm">
							<thead><tr class="text-left text-[var(--muted)] text-xs uppercase"><th class="py-2 pr-3">Statement</th><th class="py-2 pr-3">Provenance</th><th class="py-2 pr-3">Quorum</th><th class="py-2">Status</th></tr></thead>
							<tbody class="divide-y divide-[var(--border)]">
								<template x-for="c in clmPg?.items??[]" :key="c.id">
									<tr><td class="py-2 pr-3 max-w-sm truncate" x-text="c.statement" :title="c.statement"></td><td class="py-2 pr-3 text-xs" x-text="c.provenance||'–'"></td><td class="py-2 pr-3" x-text="c.quorum||'–'"></td><td class="py-2"><span x-show="c.without_evidence" class="px-2 py-0.5 rounded-full text-xs font-semibold border border-[var(--warn)] text-[var(--warn)]">sem evidência</span><span x-show="!c.without_evidence" class="px-2 py-0.5 rounded-full text-xs font-semibold border border-[var(--ok)] text-[var(--ok)]">ok</span></td></tr>
								</template>
							</tbody>
						</table>
					</div>
					<div class="mt-3 flex gap-2 items-center" x-show="clmPg&&(clmPg.limit<clmPg.total||clmPg.offset>0)">
						<button class="px-2 py-1 rounded border border-[var(--border)] text-sm disabled:opacity-40" :disabled="!clmPg||clmPg.offset===0" @click="clmOff-=P;dClm()">← Anterior</button>
						<button class="px-2 py-1 rounded border border-[var(--border)] text-sm disabled:opacity-40" :disabled="!clmPg||(clmPg.offset+clmPg.limit)>=clmPg.total" @click="clmOff+=P;dClm()">Próxima →</button>
						<span class="text-xs text-[var(--muted)] ml-auto" x-text="clmPg&&(clmPg.offset+'–'+Math.min(clmPg.offset+clmPg.limit,clmPg.total)+' de '+clmPg.total)"></span>
					</div>
				}
			</div>
			<div x-show="tab==='artifacts'">
				<div class="flex flex-wrap gap-2 items-end mb-3">
					<label class="flex flex-col gap-1 text-xs text-[var(--muted)]">Kind
						<select class="bg-[var(--panel)] border border-[var(--border)] rounded px-2 py-1.5 text-sm" x-model="artK" @change="artOff=0;dArt()"><option value="">todos</option><option value="cited_claim_view">cited_claim_view</option><option value="audit_report">audit_report</option></select>
					</label>
					<label class="flex items-center gap-2 text-xs text-[var(--muted)] cursor-pointer"><input type="checkbox" class="accent-[var(--accent)]" x-model="artS" @change="artOff=0;dArt()"/><span>somente stale</span></label>
					<label class="flex flex-col gap-1 text-xs text-[var(--muted)]">Busca
						<input type="text" class="bg-[var(--panel)] border border-[var(--border)] rounded px-2 py-1.5 text-sm w-48" x-model="artQ" @keydown.enter="artOff=0;dArt()" placeholder="filtrar ref..."/>
					</label>
					<button class="px-3 py-1.5 rounded border border-[var(--border)] text-sm text-[var(--muted)]" @click="artOff=0;dArt()">Buscar</button>
					<span class="text-xs text-[var(--muted)] ml-auto" x-text="artPg?(artPg.total+' artefatos'):''"></span>
				</div>
				@card("Artefatos") {
					<div x-show="!(artPg?.items?.length)" class="text-sm text-[var(--muted)]">Nenhum artefato.</div>
					<div class="overflow-x-auto" x-show="artPg?.items?.length">
						<table class="w-full text-sm">
							<thead><tr class="text-left text-[var(--muted)] text-xs uppercase"><th class="py-2 pr-3">Content Ref</th><th class="py-2 pr-3">Kind</th><th class="py-2 pr-3">Deps</th><th class="py-2">Status</th></tr></thead>
							<tbody class="divide-y divide-[var(--border)]">
								<template x-for="a in artPg?.items??[]" :key="a.id">
									<tr><td class="py-2 pr-3 max-w-xs truncate mono" x-text="a.content_ref" :title="a.content_ref"></td><td class="py-2 pr-3 text-xs" x-text="a.kind"></td><td class="py-2 pr-3" x-text="a.dependency_count"></td><td class="py-2"><span x-show="a.stale" class="px-2 py-0.5 rounded-full text-xs font-semibold border border-[var(--err)] text-[var(--err)]">stale</span><span x-show="!a.stale" class="px-2 py-0.5 rounded-full text-xs font-semibold border border-[var(--ok)] text-[var(--ok)]">atual</span></td></tr>
								</template>
							</tbody>
						</table>
					</div>
					<div class="mt-3 flex gap-2 items-center" x-show="artPg&&(artPg.limit<artPg.total||artPg.offset>0)">
						<button class="px-2 py-1 rounded border border-[var(--border)] text-sm disabled:opacity-40" :disabled="!artPg||artPg.offset===0" @click="artOff-=P;dArt()">← Anterior</button>
						<button class="px-2 py-1 rounded border border-[var(--border)] text-sm disabled:opacity-40" :disabled="!artPg||(artPg.offset+artPg.limit)>=artPg.total" @click="artOff+=P;dArt()">Próxima →</button>
						<span class="text-xs text-[var(--muted)] ml-auto" x-text="artPg&&(artPg.offset+'–'+Math.min(artPg.offset+artPg.limit,artPg.total)+' de '+artPg.total)"></span>
					</div>
				}
			</div>
		</div>
		<script>
			function knowledgeState() {
				const P=25;
				return {
					ok:false,at:null,sum:null,tab:'sources',
					tabs:[{id:'sources',label:'Fontes'},{id:'observations',label:'Observações'},{id:'claims',label:'Claims'},{id:'artifacts',label:'Artefatos'}],
					srcPg:null,srcK:'',srcQ:'',srcOff:0,
					obsPg:null,obsP:'',obsQ:'',obsL:false,obsOff:0,
					clmPg:null,clmQ:'',clmW:false,clmC:false,clmOff:0,
					artPg:null,artK:'',artQ:'',artS:false,artOff:0,
					get ago(){if(!this.at)return'';const s=Math.max(0,(Date.now()-this.at)/1e3|0);return s<60?s+'s atrás':s/60|0+'min atrás'},
					sh(s){return(s??'').slice(0,8)},
					ft(t){if(!t)return'';const d=new Date(t);return isNaN(d)?'':d.toLocaleTimeString('pt-BR')},
					async refresh(){try{const d=await fetch('/dash/api/knowledge').then(r=>r.json());this.sum=d;this.at=Date.now();this.ok=true}catch(e){this.ok=false}},
					async dSrc(){const p=new URLSearchParams();p.set('limit',P);p.set('offset',this.srcOff);if(this.srcK)p.set('kind',this.srcK);if(this.srcQ)p.set('q',this.srcQ);try{this.srcPg=await fetch('/dash/api/knowledge/sources?'+p).then(r=>r.json())}catch(e){}},
					async dObs(){const p=new URLSearchParams();p.set('limit',P);p.set('offset',this.obsOff);if(this.obsP)p.set('provenance',this.obsP);if(this.obsQ)p.set('q',this.obsQ);if(this.obsL)p.set('linked_only','true');try{this.obsPg=await fetch('/dash/api/knowledge/observations?'+p).then(r=>r.json())}catch(e){}},
					async dClm(){const p=new URLSearchParams();p.set('limit',P);p.set('offset',this.clmOff);if(this.clmQ)p.set('q',this.clmQ);if(this.clmW)p.set('without_evidence','true');if(this.clmC)p.set('has_contradiction','true');try{this.clmPg=await fetch('/dash/api/knowledge/claims?'+p).then(r=>r.json())}catch(e){}},
					async dArt(){const p=new URLSearchParams();p.set('limit',P);p.set('offset',this.artOff);if(this.artK)p.set('kind',this.artK);if(this.artQ)p.set('q',this.artQ);if(this.artS)p.set('stale','true');try{this.artPg=await fetch('/dash/api/knowledge/artifacts?'+p).then(r=>r.json())}catch(e){}},
					start(){this.refresh();const P=25;this.dSrc();this.dObs();this.dClm();this.dArt()},
				};
			}
		</script>
	}
}
