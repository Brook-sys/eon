package views

templ Knowledge() {
	@layout("Conhecimento", "/dash/knowledge", StandardNav("/dash/knowledge")) {
		<div x-data="knowledgeState()" x-init="start()" class="space-y-6">
			<div class="flex items-center gap-3 text-xs bg-[var(--panel)] border border-[var(--border)] rounded-xl px-4 py-2.5 shadow-sm">
				<span class="inline-flex items-center gap-2 font-medium">
					<span class="w-2 h-2 rounded-full animate-pulse" :class="ok?'bg-[var(--ok)] shadow-[0_0_8px_var(--ok)]':'bg-[var(--err)] shadow-[0_0_8px_var(--err)]'"></span>
					<span class="text-[var(--text)]" x-text="ok?'Inspect API acessível':'sem resposta da Inspect API'"></span>
				</span>
				<span class="text-[var(--muted)] border-l border-[var(--border)] pl-3" x-show="at">atualizado <span x-text="ago"></span></span>
				<button class="ml-auto px-3 py-1.5 rounded-lg border border-[var(--border)] text-[var(--muted)] hover:text-[var(--text)] hover:bg-[var(--panel-hover)] transition-all font-medium" @click="refresh()">↻ Atualizar</button>
			</div>

			<div class="grid gap-4 grid-cols-2 md:grid-cols-4" x-show="sum">
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-xl p-4 shadow-sm">
					<div class="text-[11px] uppercase tracking-wider text-[var(--muted)] font-bold mb-1">Fontes</div>
					<div class="text-3xl font-extrabold text-[var(--accent)] font-mono tracking-tight my-1" x-text="sum?.sources??'–'"></div>
					<div class="text-[11px] text-[var(--muted)]" x-text="(sum?.source_versions??0)+' versões'"></div>
				</div>
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-xl p-4 shadow-sm">
					<div class="text-[11px] uppercase tracking-wider text-[var(--muted)] font-bold mb-1">Observações</div>
					<div class="text-3xl font-extrabold text-[var(--ok)] font-mono tracking-tight my-1" x-text="sum?.observations??'–'"></div>
				</div>
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-xl p-4 shadow-sm">
					<div class="text-[11px] uppercase tracking-wider text-[var(--muted)] font-bold mb-1">Claims</div>
					<div class="text-3xl font-extrabold text-[var(--text)] font-mono tracking-tight my-1" x-text="sum?.claims??'–'"></div>
					<div class="text-[11px] font-bold" :class="(sum?.claims_without_evidence??0)>0?'text-[var(--warn)]':'text-[var(--muted)]'" x-text="(sum?.claims_without_evidence??0)+' sem evidência'"></div>
				</div>
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-xl p-4 shadow-sm">
					<div class="text-[11px] uppercase tracking-wider text-[var(--muted)] font-bold mb-1">Artefatos</div>
					<div class="text-3xl font-extrabold text-[var(--accent)] font-mono tracking-tight my-1" x-text="sum?.artifacts??'–'"></div>
					<div class="text-[11px] font-bold" :class="(sum?.stale_artifacts??0)>0?'text-[var(--err)]':'text-[var(--muted)]'" x-text="(sum?.stale_artifacts??0)+' stale'"></div>
				</div>
			</div>

			<div class="grid gap-4 grid-cols-2" x-show="sum">
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-xl p-4 shadow-sm">
					<div class="text-[11px] uppercase tracking-wider text-[var(--muted)] font-bold mb-1">Evidence Links</div>
					<div class="text-2xl font-extrabold text-[var(--text)] font-mono my-1" x-text="sum?.evidence_links??'–'"></div>
				</div>
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-xl p-4 shadow-sm">
					<div class="text-[11px] uppercase tracking-wider text-[var(--muted)] font-bold mb-1">Contradições</div>
					<div class="text-2xl font-extrabold font-mono my-1" :class="(sum?.contradicting_evidence_links??0)>0?'text-[var(--err)]':'text-[var(--ok)]'" x-text="sum?.contradicting_evidence_links??'0'"></div>
					<div class="text-[11px] text-[var(--muted)]" x-text="(sum?.supporting_evidence_links??0)+' suportando'"></div>
				</div>
			</div>

			<!-- Navegação de Abas de Conhecimento -->
			<div class="flex gap-2 border-b border-[var(--border)]/50 pb-1">
				<template x-for="t in tabs" :key="t.id">
					<button class="px-4 py-2 text-xs font-bold rounded-lg transition-all" :class="tab===t.id?'bg-[var(--panel-hover)] text-[var(--accent)] border border-[var(--border)] shadow-sm':'text-[var(--muted)] hover:text-[var(--text)] hover:bg-[var(--panel)]'" @click="tab=t.id" x-text="t.label"></button>
				</template>
			</div>

			<div x-show="tab==='sources'">
				<div class="flex flex-wrap gap-3 items-end mb-4">
					<label class="flex flex-col gap-1 text-xs text-[var(--muted)]">Kind
						<select class="bg-[#0d1420] border border-[var(--border)] rounded-lg px-3 py-2 text-xs text-[var(--text)]" x-model="srcK" @change="srcOff=0;dSrc()"><option value="">todos</option><option value="http_fetch">http_fetch</option><option value="web_search">web_search</option><option value="file">file</option><option value="operator">operator</option></select>
					</label>
					<label class="flex flex-col gap-1 text-xs text-[var(--muted)]">Busca
						<input type="text" class="bg-[#0d1420] border border-[var(--border)] rounded-lg px-3 py-2 text-xs text-[var(--text)] w-56" x-model="srcQ" @keydown.enter="srcOff=0;dSrc()" placeholder="filtrar locator..."/>
					</label>
					<button class="px-3 py-2 rounded-lg border border-[var(--border)] text-xs text-[var(--text)] hover:bg-[var(--panel-hover)] font-medium" @click="srcOff=0;dSrc()">Buscar</button>
					<span class="text-xs text-[var(--muted)] font-mono ml-auto" x-text="srcPg?(srcPg.total+' fontes'):''"></span>
				</div>
				@card("Fontes de Conhecimento Registradas") {
					<div x-show="!(srcPg?.items?.length)" class="text-sm text-[var(--muted)] p-4 text-center border border-dashed border-[var(--border)] rounded-lg">Nenhuma fonte encontrada.</div>
					<div class="overflow-x-auto" x-show="srcPg?.items?.length">
						<table class="w-full text-left border-collapse text-xs">
							<thead><tr class="border-b border-[var(--border)] text-[var(--muted)] font-mono"><th class="py-2.5 px-3">Locator</th><th class="py-2.5 px-3">Kind</th><th class="py-2.5 px-3">Versões</th><th class="py-2.5 px-3">Observado</th></tr></thead>
							<tbody class="divide-y divide-[var(--border)]/40 font-mono">
								<template x-for="s in srcPg?.items??[]" :key="s.id">
									<tr class="hover:bg-[var(--panel-hover)] transition-colors"><td class="py-2.5 px-3 max-w-xs truncate font-semibold text-[var(--text)]" x-text="s.locator" :title="s.locator"></td><td class="py-2.5 px-3 text-[var(--muted)]" x-text="s.kind"></td><td class="py-2.5 px-3 text-[var(--accent)] font-bold" x-text="s.versions"></td><td class="py-2.5 px-3 text-[var(--muted)] text-[11px]" x-text="ft(s.observed_at)"></td></tr>
								</template>
							</tbody>
						</table>
					</div>
					<div class="mt-4 flex gap-2 items-center border-t border-[var(--border)] pt-3" x-show="srcPg&&(srcPg.limit<srcPg.total||srcPg.offset>0)">
						<button class="px-3 py-1.5 rounded-lg border border-[var(--border)] text-xs font-medium hover:bg-[var(--panel-hover)] disabled:opacity-40" :disabled="!srcPg||srcPg.offset===0" @click="srcOff-=P;dSrc()">← Anterior</button>
						<button class="px-3 py-1.5 rounded-lg border border-[var(--border)] text-xs font-medium hover:bg-[var(--panel-hover)] disabled:opacity-40" :disabled="!srcPg||(srcPg.offset+srcPg.limit)>=srcPg.total" @click="srcOff+=P;dSrc()">Próxima →</button>
						<span class="text-xs text-[var(--muted)] font-mono ml-auto" x-text="srcPg&&(srcPg.offset+'–'+Math.min(srcPg.offset+srcPg.limit,srcPg.total)+' de '+srcPg.total)"></span>
					</div>
				}
			</div>

			<div x-show="tab==='observations'">
				<div class="flex flex-wrap gap-3 items-end mb-4">
					<label class="flex flex-col gap-1 text-xs text-[var(--muted)]">Provenance
						<select class="bg-[#0d1420] border border-[var(--border)] rounded-lg px-3 py-2 text-xs text-[var(--text)]" x-model="obsP" @change="obsOff=0;dObs()"><option value="">todas</option><option value="primary">primary</option><option value="secondary">secondary</option><option value="inferred">inferred</option></select>
					</label>
					<label class="flex items-center gap-2 text-xs text-[var(--muted)] cursor-pointer py-2"><input type="checkbox" class="accent-[var(--accent)] rounded" x-model="obsL" @change="obsOff=0;dObs()"/><span>somente vinculadas</span></label>
					<span class="text-xs text-[var(--muted)] font-mono ml-auto" x-text="obsPg?(obsPg.total+' observações'):''"></span>
				</div>
				@card("Observações de Fatos") {
					<div x-show="!(obsPg?.items?.length)" class="text-sm text-[var(--muted)] p-4 text-center border border-dashed border-[var(--border)] rounded-lg">Nenhuma observação.</div>
					<div class="overflow-x-auto" x-show="obsPg?.items?.length">
						<table class="w-full text-left border-collapse text-xs">
							<thead><tr class="border-b border-[var(--border)] text-[var(--muted)] font-mono"><th class="py-2.5 px-3">Resumo</th><th class="py-2.5 px-3">Proveniência</th><th class="py-2.5 px-3">Criado</th></tr></thead>
							<tbody class="divide-y divide-[var(--border)]/40 font-mono">
								<template x-for="o in obsPg?.items??[]" :key="o.id">
									<tr class="hover:bg-[var(--panel-hover)] transition-colors"><td class="py-2.5 px-3 max-w-md truncate font-semibold text-[var(--text)]" x-text="o.summary" :title="o.summary"></td><td class="py-2.5 px-3 text-[var(--muted)]" x-text="o.provenance"></td><td class="py-2.5 px-3 text-[var(--muted)] text-[11px]" x-text="ft(o.created_at)"></td></tr>
								</template>
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>

		<script>
			function knowledgeState() {
				return {
					ok: false,
					at: null,
					sum: null,
					tab: 'sources',
					tabs: [
						{ id: 'sources', label: 'Fontes' },
						{ id: 'observations', label: 'Observações' }
					],
					P: 20,
					srcOff: 0, srcK: '', srcQ: '', srcPg: null,
					obsOff: 0, obsP: '', obsL: false, obsPg: null,

					get ago() {
						if (!this.at) return '';
						const s = Math.max(0, (Date.now() - this.at) / 1000 | 0);
						return s < 60 ? `${s}s atrás` : `${s/60|0}min atrás`;
					},

					async refresh() {
						try {
							const s = await fetch('/dash/api/knowledge/summary').then(r => r.json());
							this.sum = s ?? null;
							this.at = Date.now();
							this.ok = true;
							this.dSrc();
							this.dObs();
						} catch (e) { this.ok = false; }
					},

					async dSrc() {
						try {
							const p = new URLSearchParams({ limit: String(this.P), offset: String(this.srcOff) });
							if (this.srcK) p.set('kind', this.srcK);
							if (this.srcQ) p.set('query', this.srcQ);
							this.srcPg = await fetch('/dash/api/knowledge/sources?' + p).then(r => r.json());
						} catch {}
					},

					async dObs() {
						try {
							const p = new URLSearchParams({ limit: String(this.P), offset: String(this.obsOff) });
							if (this.obsP) p.set('provenance', this.obsP);
							if (this.obsL) p.set('linked_only', 'true');
							this.obsPg = await fetch('/dash/api/knowledge/observations?' + p).then(r => r.json());
						} catch {}
					},

					ft(t) {
						if (!t) return '–';
						const d = new Date(t);
						return isNaN(d) ? '–' : d.toLocaleDateString('pt-BR') + ' ' + d.toLocaleTimeString('pt-BR');
					},

					start() {
						this.refresh();
						setInterval(() => this.refresh(), 10000);
					}
				};
			}
		</script>
	}
}
