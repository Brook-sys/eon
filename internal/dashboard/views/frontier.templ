package views

templ Frontier() {
	@layout("Fronteira & Backlog", "/dash/frontier", StandardNav("/dash/frontier")) {
		<div x-data="frontierState()" x-init="start()" class="space-y-8">
			<div class="flex items-center gap-4 text-sm bg-[var(--panel)] border border-[var(--border)] rounded-2xl px-5 py-4 shadow-sm">
				<span class="inline-flex items-center gap-3 font-bold">
					<span
						class="w-3 h-3 rounded-full"
						x-bind:class="connected ? 'bg-[var(--ok)] shadow-[0_0_8px_var(--ok)]' : 'bg-[var(--err)] shadow-[0_0_8px_var(--err)]'"
					></span>
					<span class="text-[var(--text)]" x-text="connected ? 'Conectado à API' : 'Sem conexão'"></span>
				</span>
				<span class="text-[var(--muted)] border-l border-[var(--border)] pl-4 font-medium" x-show="generatedAt">
					atualizado <span x-text="generatedAgo"></span>
				</span>
				<button
					class="ml-auto px-4 py-2 rounded-xl border border-[var(--border)] bg-[var(--bg)] text-[var(--muted)] hover:text-[var(--text)] hover:bg-[var(--panel-hover)] transition-all font-bold text-sm shadow-sm cursor-pointer"
					x-on:click="refresh()"
				>↻ Atualizar</button>
			</div>

			<div class="grid gap-6 grid-cols-1 sm:grid-cols-3">
				@StatCardAlpine("Itens na Fronteira", "fmt(frontier.length)", "tarefas avaliadas", "text-[var(--text)]")
				@StatCardAlpine("Pendentes (READY)", "fmt(readyCount)", "prontos para execução", "text-[var(--accent)]")
				@StatCardAlpine("Bloqueados", "fmt(blockedCount)", "aguardando dependências", "text-[var(--warn)]")
			</div>

			@card("Backlog Ativo") {
				<div class="space-y-4">
					<template x-if="frontier.length === 0">
						@EmptyState("Nenhum item na fronteira de trabalho no momento.")
					</template>
					<div class="space-y-4">
						<template x-for="item in frontier" x-bind:key="item.id ?? Math.random()">
							<div class="p-5 rounded-2xl bg-[var(--bg)] border border-[var(--border)] flex flex-col gap-3 shadow-sm hover:border-[var(--accent)]/40 transition-colors">
								<div class="flex justify-between items-start gap-4">
									<div class="font-bold text-base text-[var(--text)]" x-text="item.title"></div>
									<span 
										class="px-3 py-1 rounded-md text-[10px] font-bold uppercase tracking-widest shadow-sm"
										x-bind:class="({
											'READY': 'bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/20',
											'BLOCKED': 'bg-[var(--warn)]/10 text-[var(--warn)] border border-[var(--warn)]/20',
											'IN_PROGRESS': 'bg-[var(--ok)]/10 text-[var(--ok)] border border-[var(--ok)]/20'
										})[item.status] ?? 'bg-[var(--panel-sub)] text-[var(--muted)] border border-[var(--border)]'"
										x-text="item.status"
									></span>
								</div>
								<div class="text-sm text-[var(--muted)] leading-relaxed" x-show="item.description" x-text="item.description"></div>
								<div class="flex flex-wrap gap-2 pt-2 border-t border-[var(--border-subtle)] mt-1" x-show="item.tags && item.tags.length > 0">
									<template x-for="tag in item.tags">
										<span class="px-2 py-1 bg-[var(--panel)] text-[var(--subtle)] text-[10px] rounded-md font-mono font-bold" x-text="tag"></span>
									</template>
								</div>
							</div>
						</template>
					</div>
				</div>
			}
		</div>
		<script>
			function frontierState() {
				return {
					connected: false,
					generatedAt: null,
					frontier: [],
					
					get generatedAgo() {
						if (!this.generatedAt) return '';
						const s = Math.max(0, (Date.now() - this.generatedAt) / 1000 | 0);
						return s < 60 ? `${s}s atrás` : `${s/60|0}min atrás`;
					},
					
					get readyCount() { return this.frontier.filter(i => i.status === 'READY').length; },
					get blockedCount() { return this.frontier.filter(i => i.status === 'BLOCKED').length; },
					
					fmt(n) { return n == null ? '0' : Number(n).toLocaleString('pt-BR'); },
					
					async refresh() {
						try {
							const res = await fetch('/dash/api/frontier');
							const data = await res.json();
							this.frontier = data?.items || [];
							this.generatedAt = Date.now();
							this.connected = true;
						} catch (e) {
							this.connected = false;
						}
					},
					
					start() {
						this.refresh();
						setInterval(() => this.refresh(), 10000);
					}
				};
			}
		</script>
	}
}
