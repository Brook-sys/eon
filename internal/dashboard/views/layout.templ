package views

// NavItem for dashboard v2 navigation links.
type NavItem struct {
	Href     string
	Label    string
	Active   bool
	External bool
}

templ sidebar(items []NavItem) {
	<nav class="w-52 shrink-0 border-r border-[var(--border)] flex flex-col gap-1 pt-1">
		for _, item := range items {
			<a
				href={item.Href}
				class={
					"px-3 py-2 rounded-md text-sm transition-colors",
					templ.KV("text-[var(--text)] bg-[var(--panel)] border-[var(--accent)]", item.Active),
					templ.KV("text-[var(--muted)] hover:text-[var(--text)] hover:bg-[#243247]", !item.Active),
				}
				if item.External {
					target="_blank" rel="noopener noreferrer"
				}
			>{item.Label}</a>
		}
	</nav>
}

templ badge(label, kind string) {
	<span class={
		"inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold border",
		templ.KV("border-[var(--ok)] text-[var(--ok)]", kind == "success"),
		templ.KV("border-[var(--warn)] text-[var(--warn)]", kind == "warning"),
		templ.KV("border-[var(--err)] text-[var(--err)]", kind == "error"),
		templ.KV("border-[var(--accent)] text-[var(--accent)]", kind == "info"),
		templ.KV("border-[var(--border)] text-[var(--muted)]", kind == "neutral"),
	}>{label}</span>
}

templ card(title string) {
	<section class="bg-[var(--panel)] border border-[var(--border)] rounded-lg p-4 mb-4">
		<h3 class="text-[var(--muted)] text-xs font-semibold uppercase tracking-widest mb-3">{title}</h3>
		{ children... }
	</section>
}

templ layout(title string, currentPath string, nav []NavItem) {
	<!doctype html>
	<html lang="pt-BR">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<meta name="color-scheme" content="dark"/>
		<title>motor-autonomo — {title}</title>
		<script src="/dash/assets/htmx.min.js" defer></script>
		<script src="/dash/assets/alpine.min.js" defer></script>
		<link rel="stylesheet" href="/dash/assets/app.css"/>
		<style>
			:root {
				--bg: #0f1419;
				--panel: #1a2332;
				--border: #2d3a4d;
				--text: #e7ecf3;
				--muted: #8b9bb4;
				--accent: #5b9fd4;
				--ok: #3d9a6a;
				--warn: #c9a227;
				--err: #c45c5c;
				--mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
				--sans: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
			}
			* { box-sizing: border-box; }
			body {
				margin: 0; background: var(--bg); color: var(--text);
				font: 14px / 1.5 var(--sans);
			}
			a { text-decoration: none; color: inherit; }
			pre, code, .mono { font-family: var(--mono); font-size: 13px; }
			html { scrollbar-color: #3a4f6a transparent; }
		</style>
	</head>
	<body class="min-h-screen" x-data="{ showShortcuts: false, toasts: [] }" @keydown.window="
		if ($event.key === '?') { showShortcuts = !showShortcuts; }
		if ($event.key === 'g' || $event.key === 'G') {
			$event.target._gPressed = true;
			setTimeout(() => delete $event.target._gPressed, 1000);
		} else if ($event.target._gPressed) {
			if ($event.key === 'o' || $event.key === 'O') window.location.href = '/dash/';
			if ($event.key === 'e' || $event.key === 'E') window.location.href = '/dash/events';
			if ($event.key === 'm' || $event.key === 'M') window.location.href = '/dash/models';
			if ($event.key === 'r' || $event.key === 'R') window.location.href = '/dash/resources';
			if ($event.key === 'f' || $event.key === 'F') window.location.href = '/dash/frontier';
			if ($event.key === 'a' || $event.key === 'A') window.location.href = '/dash/alerts';
			if ($event.key === 'k' || $event.key === 'K') window.location.href = '/dash/knowledge';
			delete $event.target._gPressed;
		}
	" @toast.window="
		const t = $event.detail;
		const id = Date.now() + Math.random();
		toasts.push({ id, message: t.message, type: t.type || 'info' });
		setTimeout(() => { toasts = toasts.filter(x => x.id !== id); }, t.duration || 4000);
	">
		<!-- Dynamic Toast Notifications -->
		<div class="fixed top-4 right-4 z-50 flex flex-col gap-2 max-w-sm pointer-events-none">
			<template x-for="t in toasts" x-bind:key="t.id">
				<div class="pointer-events-auto p-3 rounded-lg border shadow-lg text-xs font-medium flex items-center justify-between gap-3 animate-fade-in"
					x-bind:class="{
						'bg-[var(--panel)] border-[var(--ok)] text-[var(--ok)]': t.type === 'success',
						'bg-[var(--panel)] border-[var(--err)] text-[var(--err)]': t.type === 'error',
						'bg-[var(--panel)] border-[var(--warn)] text-[var(--warn)]': t.type === 'warning',
						'bg-[var(--panel)] border-[var(--accent)] text-[var(--accent)]': t.type === 'info'
					}"
				>
					<span x-text="t.message"></span>
					<button type="button" class="text-xs opacity-70 hover:opacity-100 font-bold" x-on:click="toasts = toasts.filter(x => x.id !== t.id)">✕</button>
				</div>
			</template>
		</div>

		<script>
			window.notify = function(message, type = 'info', duration = 4000) {
				window.dispatchEvent(new CustomEvent('toast', { detail: { message, type, duration } }));
			};
		</script>
		<div class="flex min-h-screen">
			<aside class="flex flex-col border-r border-[var(--border)] bg-[var(--panel)] p-4 gap-4">
				<div class="flex items-center gap-2">
					<div class="w-8 h-8 rounded-md flex items-center justify-center bg-[var(--accent)] text-white font-bold text-sm">
						M
					</div>
					<div>
						<div class="text-sm font-semibold">motor-autonomo</div>
						<div class="text-xs text-[var(--muted)]">operator dashboard</div>
					</div>
				</div>
				<hr class="border-[var(--border)]" />
				@sidebar(nav)
				<div class="mt-auto pt-4 border-t border-[var(--border)] text-xs text-[var(--muted)] flex items-center justify-between">
					<span>v0</span>
					<button @click="showShortcuts = true" class="px-1.5 py-0.5 rounded border border-[var(--border)] hover:bg-[var(--panel-2)] font-mono text-[10px]" title="Atalhos de Teclado">?</button>
				</div>
			</aside>
			<main class="flex-1 p-6 max-w-6xl">
				<header class="mb-6">
					<h1 class="text-xl font-semibold">{title}</h1>
				</header>
				{ children... }
			</main>
		</div>

		<!-- Modal de Atalhos de Teclado (Cheatsheet) -->
		<div x-show="showShortcuts" x-cloak class="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
			<div @click.away="showShortcuts = false" class="bg-[var(--panel)] border border-[var(--border)] rounded-lg p-6 max-w-md w-full font-mono text-xs space-y-4">
				<div class="flex items-center justify-between border-b border-[var(--border)] pb-2">
					<h3 class="text-sm font-bold text-[var(--text)]">Atalhos de Teclado</h3>
					<button @click="showShortcuts = false" class="text-[var(--muted)] hover:text-[var(--text)]">✕</button>
				</div>
				<div class="space-y-2">
					<div class="flex justify-between py-1 border-b border-[var(--border)]/50">
						<span class="text-[var(--muted)]">Abrir este painel</span>
						<kbd class="px-1.5 py-0.5 bg-[var(--panel-2)] border border-[var(--border)] rounded">?</kbd>
					</div>
					<div class="flex justify-between py-1 border-b border-[var(--border)]/50">
						<span class="text-[var(--muted)]">Ir para Visão Geral</span>
						<div>
							<kbd class="px-1.5 py-0.5 bg-[var(--panel-2)] border border-[var(--border)] rounded">g</kbd>
							<span class="mx-0.5">+</span>
							<kbd class="px-1.5 py-0.5 bg-[var(--panel-2)] border border-[var(--border)] rounded">o</kbd>
						</div>
					</div>
					<div class="flex justify-between py-1 border-b border-[var(--border)]/50">
						<span class="text-[var(--muted)]">Ir para Eventos</span>
						<div>
							<kbd class="px-1.5 py-0.5 bg-[var(--panel-2)] border border-[var(--border)] rounded">g</kbd>
							<span class="mx-0.5">+</span>
							<kbd class="px-1.5 py-0.5 bg-[var(--panel-2)] border border-[var(--border)] rounded">e</kbd>
						</div>
					</div>
					<div class="flex justify-between py-1 border-b border-[var(--border)]/50">
						<span class="text-[var(--muted)]">Ir para Modelos</span>
						<div>
							<kbd class="px-1.5 py-0.5 bg-[var(--panel-2)] border border-[var(--border)] rounded">g</kbd>
							<span class="mx-0.5">+</span>
							<kbd class="px-1.5 py-0.5 bg-[var(--panel-2)] border border-[var(--border)] rounded">m</kbd>
						</div>
					</div>
					<div class="flex justify-between py-1 border-b border-[var(--border)]/50">
						<span class="text-[var(--muted)]">Ir para Recursos & Gates</span>
						<div>
							<kbd class="px-1.5 py-0.5 bg-[var(--panel-2)] border border-[var(--border)] rounded">g</kbd>
							<span class="mx-0.5">+</span>
							<kbd class="px-1.5 py-0.5 bg-[var(--panel-2)] border border-[var(--border)] rounded">r</kbd>
						</div>
					</div>
					<div class="flex justify-between py-1 border-b border-[var(--border)]/50">
						<span class="text-[var(--muted)]">Ir para Fronteira & Ações</span>
						<div>
							<kbd class="px-1.5 py-0.5 bg-[var(--panel-2)] border border-[var(--border)] rounded">g</kbd>
							<span class="mx-0.5">+</span>
							<kbd class="px-1.5 py-0.5 bg-[var(--panel-2)] border border-[var(--border)] rounded">f</kbd>
						</div>
					</div>
					<div class="flex justify-between py-1 border-b border-[var(--border)]/50">
						<span class="text-[var(--muted)]">Ir para Alertas</span>
						<div>
							<kbd class="px-1.5 py-0.5 bg-[var(--panel-2)] border border-[var(--border)] rounded">g</kbd>
							<span class="mx-0.5">+</span>
							<kbd class="px-1.5 py-0.5 bg-[var(--panel-2)] border border-[var(--border)] rounded">a</kbd>
						</div>
					</div>
					<div class="flex justify-between py-1 border-b border-[var(--border)]/50">
						<span class="text-[var(--muted)]">Ir para Conhecimento</span>
						<div>
							<kbd class="px-1.5 py-0.5 bg-[var(--panel-2)] border border-[var(--border)] rounded">g</kbd>
							<span class="mx-0.5">+</span>
							<kbd class="px-1.5 py-0.5 bg-[var(--panel-2)] border border-[var(--border)] rounded">k</kbd>
						</div>
					</div>
				</div>
			</div>
		</div>
	</body>
	</html>
}
