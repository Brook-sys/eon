package views

templ Models() {
	@layout("Modelos & LLMs", "/dash/models", StandardNav("/dash/models")) {
		<div x-data="modelsState()" x-init="start()" class="space-y-6">
			<!-- Barra de Conexão e Ações -->
			<div class="flex items-center gap-3 text-xs bg-[var(--panel)] border border-[var(--border)] rounded-xl px-4 py-2.5">
				<span class="inline-flex items-center gap-2 font-medium">
					<span
						class="w-2 h-2 rounded-full"
						x-bind:class="connected ? 'bg-[var(--ok)]' : 'bg-[var(--err)]'"
					></span>
					<span class="text-[var(--text)]" x-text="connected ? 'Inspect & Control API acessíveis' : 'sem resposta das APIs'"></span>
				</span>
				<span class="text-[var(--muted)] border-l border-[var(--border)] pl-3" x-show="observedAt">atualizado <span x-text="observedAgo"></span></span>
				<div class="ml-auto flex gap-2">
					<button
						type="button"
						class="px-3.5 py-1.5 rounded-lg bg-[var(--accent)] text-[#090d16] font-bold text-xs flex items-center gap-1.5 hover:opacity-90 transition-all cursor-pointer"
						x-on:click="openAddProviderModal()"
					>
						+ Adicionar Provedor LLM
					</button>
					<button
						type="button"
						class="px-3 py-1.5 rounded-lg border border-[var(--border)] text-[var(--text)] hover:bg-white/[0.04] transition-all font-medium text-xs cursor-pointer"
						x-on:click="openAddBindingModal()"
					>
						+ Adicionar Preferência de Modelo
					</button>
					<button
						type="button"
						class="px-3 py-1.5 rounded-lg border border-[var(--border)] text-[var(--muted)] hover:text-[var(--text)] hover:bg-white/[0.04] transition-all font-medium"
						x-on:click="refresh()"
					>↻ Atualizar</button>
				</div>
			</div>

			<!-- Form / Modal para Adicionar ou Editar Provedor LLM (SEM EXIGIR MODELO FIXO) -->
			<div x-show="showProviderForm" class="p-5 rounded-xl bg-[var(--panel)] border border-[var(--accent)]/40 space-y-4 shadow-2xl" style="display:none;">
				<div class="flex justify-between items-center pb-3 border-b border-[var(--border)]">
					<h3 class="font-bold text-xs text-[var(--text)]" x-text="providerFormIsEdit ? 'Editar Provedor LLM: ' + providerForm.id : 'Adicionar Novo Provedor LLM (Sem Exigir Modelo Fixo)'"></h3>
					<button type="button" class="text-xs text-[var(--muted)] hover:text-[var(--text)] px-2 py-1 rounded bg-white/[0.04]" x-on:click="showProviderForm = false">✕ Fechar</button>
				</div>
				<form x-on:submit.prevent="submitProviderForm()" class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 text-xs">
					<div>
						<label class="block text-[var(--muted)] font-medium mb-1">ID do Provedor (Slug)</label>
						<input type="text" x-model="providerForm.id" x-bind:readonly="providerFormIsEdit" required class="w-full px-3 py-2 rounded-lg bg-[var(--panel-sub)] border border-[var(--border)] text-[var(--text)] font-mono" placeholder="ex: groq, nvidia-nim, ollama"/>
					</div>
					<div>
						<label class="block text-[var(--muted)] font-medium mb-1">Tipo de Provedor</label>
						<select x-model="providerForm.kind" class="w-full px-3 py-2 rounded-lg bg-[var(--panel-sub)] border border-[var(--border)] text-[var(--text)]">
							<option value="openai_compatible">OpenAI Compatible (Groq / NIM / Ollama)</option>
						</select>
					</div>
					<div>
						<label class="block text-[var(--muted)] font-medium mb-1">Base URL do Endpoint</label>
						<input type="url" x-model="providerForm.base_url" required class="w-full px-3 py-2 rounded-lg bg-[var(--panel-sub)] border border-[var(--border)] text-[var(--text)] font-mono" placeholder="https://api.groq.com/openai/v1"/>
					</div>
					<div>
						<label class="block text-[var(--muted)] font-medium mb-1">Nome da Var de Ambiente da API Key</label>
						<input type="text" x-model="providerForm.api_key_env" required class="w-full px-3 py-2 rounded-lg bg-[var(--panel-sub)] border border-[var(--border)] text-[var(--text)] font-mono" placeholder="GROQ_API_KEY"/>
					</div>
					<div>
						<label class="block text-[var(--muted)] font-medium mb-1">Concorrência Máxima de Requisições</label>
						<input type="number" x-model.number="providerForm.max_concurrent" required min="1" max="100" class="w-full px-3 py-2 rounded-lg bg-[var(--panel-sub)] border border-[var(--border)] text-[var(--text)] font-mono"/>
					</div>
					<div>
						<label class="block text-[var(--muted)] font-medium mb-1">API Secret / Chave (Salvar no Cofre Local)</label>
						<input type="password" x-model="providerForm.secret_value" class="w-full px-3 py-2 rounded-lg bg-[var(--panel-sub)] border border-[var(--border)] text-[var(--text)] font-mono" placeholder="Opcional: salva diretamente no Vault"/>
					</div>
					<div class="md:col-span-3 flex items-center gap-3 pt-3 border-t border-[var(--border)]">
						<button type="submit" class="px-4 py-2 rounded-lg bg-[var(--accent)] text-[#090d16] font-bold text-xs hover:opacity-90 transition-all cursor-pointer" x-bind:disabled="formSubmitting">
							<span x-text="providerFormIsEdit ? 'Salvar Alterações do Provedor' : 'Cadastrar Provedor LLM'"></span>
						</button>
						<button type="button" class="px-3.5 py-2 rounded-lg border border-[var(--border)] text-[var(--muted)] hover:text-[var(--text)] hover:bg-white/[0.04] font-medium" x-on:click="showProviderForm = false">Cancelar</button>
						<span x-show="formMsg" class="text-xs font-mono" x-bind:class="formIsErr ? 'text-[var(--err)]' : 'text-[var(--ok)]'" x-text="formMsg"></span>
					</div>
				</form>
			</div>

			<!-- Form / Modal para Adicionar Preferência de Modelo (Binding Opcional) -->
			<div x-show="showBindingForm" class="p-5 rounded-xl bg-[var(--panel)] border border-[var(--border)] space-y-4 shadow-2xl" style="display:none;">
				<div class="flex justify-between items-center pb-3 border-b border-[var(--border)]">
					<h3 class="font-bold text-xs text-[var(--text)]">Adicionar / Editar Preferência de Modelo (Binding Opcional)</h3>
					<button type="button" class="text-xs text-[var(--muted)] hover:text-[var(--text)] px-2 py-1 rounded bg-white/[0.04]" x-on:click="showBindingForm = false">✕ Fechar</button>
				</div>
				<form x-on:submit.prevent="submitBindingForm()" class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 text-xs">
					<div>
						<label class="block text-[var(--muted)] font-medium mb-1">Provedor de Origem</label>
						<select x-model="bindingForm.provider_ref" required class="w-full px-3 py-2 rounded-lg bg-[var(--panel-sub)] border border-[var(--border)] text-[var(--text)]">
							<template x-for="p in (cfgPayload.providers || [])" x-bind:key="p.id">
								<option x-bind:value="p.id" x-text="p.id + ' (' + p.base_url + ')'"></option>
							</template>
						</select>
					</div>
					<div>
						<label class="block text-[var(--muted)] font-medium mb-1">ID do Modelo (ex: llama-3.3-70b-versatile)</label>
						<input type="text" x-model="bindingForm.model_id" required class="w-full px-3 py-2 rounded-lg bg-[var(--panel-sub)] border border-[var(--border)] text-[var(--text)] font-mono" placeholder="digite ou selecione dos descobertos"/>
					</div>
					<div>
						<label class="block text-[var(--muted)] font-medium mb-1">Janela de Contexto (tokens)</label>
						<input type="number" x-model.number="bindingForm.context_tokens" required min="1024" class="w-full px-3 py-2 rounded-lg bg-[var(--panel-sub)] border border-[var(--border)] text-[var(--text)] font-mono"/>
					</div>
					<div>
						<label class="block text-[var(--muted)] font-medium mb-1">Máx. Output Tokens</label>
						<input type="number" x-model.number="bindingForm.max_output_tokens" required min="256" class="w-full px-3 py-2 rounded-lg bg-[var(--panel-sub)] border border-[var(--border)] text-[var(--text)] font-mono"/>
					</div>
					<div>
						<label class="block text-[var(--muted)] font-medium mb-1">Prioridade do Binding</label>
						<input type="number" x-model.number="bindingForm.priority" required min="1" max="100" class="w-full px-3 py-2 rounded-lg bg-[var(--panel-sub)] border border-[var(--border)] text-[var(--text)] font-mono"/>
					</div>
					<div class="md:col-span-3 flex items-center gap-3 pt-3 border-t border-[var(--border)]">
						<button type="submit" class="px-4 py-2 rounded-lg bg-[var(--accent)] text-[#090d16] font-bold text-xs hover:opacity-90 transition-all cursor-pointer" x-bind:disabled="formSubmitting">
							Salvar Preferência de Modelo
						</button>
						<button type="button" class="px-3.5 py-2 rounded-lg border border-[var(--border)] text-[var(--muted)] hover:text-[var(--text)] hover:bg-white/[0.04] font-medium" x-on:click="showBindingForm = false">Cancelar</button>
						<span x-show="formMsg" class="text-xs font-mono" x-bind:class="formIsErr ? 'text-[var(--err)]' : 'text-[var(--ok)]'" x-text="formMsg"></span>
					</div>
				</form>
			</div>

			<!-- Status do Cofre de Credenciais -->
			<div class="p-4 rounded-xl bg-[var(--panel)] border border-[var(--border)] flex flex-wrap items-center justify-between text-xs gap-3">
				<div class="flex items-center gap-3">
					<span class="font-medium text-[var(--text)]">Cofre de Credenciais Local:</span>
					<span class="font-mono px-2 py-0.5 rounded bg-[var(--panel-sub)] text-[var(--muted)]" x-text="vaultState"></span>
				</div>
				<div class="flex items-center gap-2" x-data="{ vPass: '' }">
					<input type="password" placeholder="Senha mestra..." x-model="vPass" class="px-3 py-1.5 rounded-lg bg-[var(--panel-sub)] border border-[var(--border)] text-[var(--text)] w-40"/>
					<button type="button" class="px-3.5 py-1.5 rounded-lg bg-[var(--accent)]/15 text-[var(--accent)] hover:bg-[var(--accent)]/25 font-semibold transition-all cursor-pointer" x-on:click="unlockVault(vPass)">Desbloquear Cofre</button>
				</div>
			</div>

			<!-- Gestão de Provedores LLM Configurados -->
			@card("Provedores LLM Registrados") {
				<template x-if="!cfgPayload || (cfgPayload.providers ?? []).length === 0">
					<p class="text-xs text-[var(--muted)] p-3 text-center">Nenhum provedor configurado no catálogo ativo.</p>
				</template>
				<div class="divide-y divide-[var(--border)]" x-show="cfgPayload && (cfgPayload.providers ?? []).length > 0">
					<template x-for="p in cfgPayload.providers" x-bind:key="p.id">
						<div class="py-3.5 first:pt-0 last:pb-0 space-y-2">
							<div class="flex flex-wrap items-center justify-between gap-2">
								<div>
									<span class="font-bold text-xs text-[var(--text)] font-mono" x-text="p.id"></span>
									<span class="ml-2 text-xs text-[var(--muted)] font-mono" x-text="p.kind + ' · ' + p.base_url"></span>
								</div>
								<div class="flex items-center gap-2">
									<button
										type="button"
										class="px-2.5 py-1 rounded-md text-xs text-[var(--accent)] bg-[var(--accent)]/10 hover:bg-[var(--accent)]/20 font-semibold transition-all cursor-pointer"
										x-on:click="discoverModelsForProvider(p.id)"
									>
										🔍 Descobrir Modelos via API
									</button>
									<button
										type="button"
										class="px-2.5 py-1 rounded-md text-xs text-[var(--muted)] hover:text-[var(--text)] hover:bg-white/[0.04] font-medium transition-all"
										x-on:click="editProvider(p.id)"
									>
										✏ Editar
									</button>
									<button
										type="button"
										class="px-2.5 py-1 rounded-md text-xs text-[var(--muted)] hover:text-[var(--text)] hover:bg-white/[0.04] font-medium transition-all"
										x-on:click="toggleProvider(p.id)"
										x-text="p.enabled ? '⏸ Desativar' : '▶ Ativar'"
									></button>
									<button
										type="button"
										class="px-2.5 py-1 rounded-md bg-[var(--err)]/15 text-[var(--err)] hover:bg-[var(--err)]/25 text-xs font-semibold transition-all"
										x-on:click="removeProvider(p.id)"
									>
										🗑 Remover
									</button>
								</div>
							</div>
							<div class="grid gap-2 grid-cols-2 md:grid-cols-4 text-xs font-mono text-[var(--muted)]">
								<div>API Key Env: <strong class="text-[var(--text)]" x-text="p.api_key_env || 'N/A'"></strong></div>
								<div>Concorrência: <strong class="text-[var(--text)]" x-text="(p.global_limit && p.global_limit.max_concurrent) || 1"></strong></div>
								<div>Estado: <strong x-bind:class="p.enabled ? 'text-[var(--ok)]' : 'text-[var(--warn)]'" x-text="p.enabled ? 'Ativo' : 'Desativado'"></strong></div>
								<div>Bindings Preferenciais: <strong class="text-[var(--accent)]" x-text="(cfgPayload.bindings || []).filter(b => b.provider_ref === p.id).length"></strong></div>
							</div>
						</div>
					</template>
				</div>
			}

			<!-- Modelos Descobertos Dinamicamente via API OpenAI -->
			@card("Modelos Descobertos Dinamicamente via API OpenAI") {
				<div class="space-y-3">
					<div class="flex items-center justify-between text-xs">
						<span class="text-[var(--muted)]" x-text="discoveredModelsNote || 'Modelos obtidos dinamicamente da API OpenAI do provedor ativo.'"></span>
						<button
							type="button"
							class="px-3 py-1.5 rounded-lg bg-[var(--accent)]/15 text-[var(--accent)] hover:bg-[var(--accent)]/25 font-semibold text-xs transition-all cursor-pointer"
							x-on:click="discoverModels()"
						>
							🔄 Buscar Modelos da API OpenAI
						</button>
					</div>
					<template x-if="discoveredModels.length === 0">
						<p class="text-xs text-[var(--muted)] p-2">Nenhum modelo retornado pela API OpenAI até o momento (clique no botão para buscar).</p>
					</template>
					<div class="flex flex-wrap gap-2 pt-2" x-show="discoveredModels.length > 0">
						<template x-for="m in discoveredModels" x-bind:key="m">
							<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[var(--panel-sub)] border border-[var(--border)] text-xs font-mono">
								<span class="font-bold text-[var(--accent)]" x-text="m"></span>
								<button
									type="button"
									class="text-[10px] text-[var(--muted)] hover:text-[var(--text)] hover:underline ml-1 cursor-pointer"
									x-on:click="addBindingFromDiscovered(m)"
								>
									+ Preferência
								</button>
							</div>
						</template>
					</div>
				</div>
			}

			<!-- Preferências de Modelo / Bindings Registradas (Opcional) -->
			@card("Preferências de Modelo / Bindings (Opcional)") {
				<p class="text-xs text-[var(--muted)] mb-3" x-show="note" x-text="note"></p>
				<div class="overflow-x-auto">
					<table class="w-full text-left border-collapse text-xs">
						<thead>
							<tr class="border-b border-[var(--border)] text-[var(--muted)] font-mono">
								<th class="py-2.5 px-3">Slot / Role</th>
								<th class="py-2.5 px-3">Modelo</th>
								<th class="py-2.5 px-3">Provedor</th>
								<th class="py-2.5 px-3">Concorrência</th>
								<th class="py-2.5 px-3">Contexto</th>
								<th class="py-2.5 px-3">Max Output</th>
								<th class="py-2.5 px-3">Prioridade</th>
								<th class="py-2.5 px-3 text-right">Ação</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-[var(--border-subtle)] font-mono">
							<template x-if="bindings.length === 0">
								<tr><td colspan="8" class="py-4 text-center text-[var(--muted)]">Nenhuma preferência explícita de modelo cadastrada (o sistema usa descoberta dinâmica).</td></tr>
							</template>
							<template x-for="b in bindings" x-bind:key="b.slot ?? b.role ?? Math.random()">
								<tr class="hover:bg-white/[0.02] transition-colors">
									<td class="py-2.5 px-3 font-semibold text-[var(--text)]" x-text="b.slot ?? b.role ?? '–'"></td>
									<td class="py-2.5 px-3 text-[var(--accent)] font-bold" x-text="b.model_id ?? b.model ?? '–'"></td>
									<td class="py-2.5 px-3 text-[var(--muted)]" x-text="b.provider ?? '–'"></td>
									<td class="py-2.5 px-3 text-[var(--muted)]" x-text="b.max_concurrent ?? '–'"></td>
									<td class="py-2.5 px-3 text-[var(--muted)]" x-text="b.context_tokens ? (b.context_tokens + ' tks') : '–'"></td>
									<td class="py-2.5 px-3 text-[var(--muted)]" x-text="b.max_output_tokens ? (b.max_output_tokens + ' tks') : '–'"></td>
									<td class="py-2.5 px-3 text-[var(--muted)]" x-text="b.priority ?? '–'"></td>
									<td class="py-2.5 px-3 text-right">
										<button
											type="button"
											class="text-[10px] text-[var(--err)] hover:underline"
											x-on:click="removeBinding(b.id ?? b.slot)"
										>Remover</button>
									</td>
								</tr>
							</template>
						</tbody>
					</table>
				</div>
			}

			<!-- Pressões de Contexto -->
			@card("Pressão de Contexto dos Modelos") {
				<p class="text-xs text-[var(--muted)] mb-3" x-show="pressureNote" x-text="pressureNote"></p>
				<div class="grid gap-3 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
					<template x-if="pressures.length === 0">
						<p class="text-xs text-[var(--muted)] col-span-3">Nenhum dado de pressão de contexto disponível.</p>
					</template>
					<template x-for="p in pressures" x-bind:key="p.model_id ?? Math.random()">
						<div class="p-3 rounded-lg bg-[var(--panel-sub)] border border-[var(--border)] space-y-2">
							<div class="flex justify-between items-center text-xs font-mono">
								<span class="font-bold text-[var(--text)]" x-text="p.model_id ?? '–'"></span>
								<span
									class="px-1.5 py-0.5 rounded text-[10px] font-bold"
									x-bind:class="(p.ratio ?? 0) > 0.8 ? 'bg-[var(--err)]/20 text-[var(--err)]' : 'bg-[var(--ok)]/20 text-[var(--ok)]'"
									x-text="((p.ratio ?? 0) * 100).toFixed(1) + '%'"
								></span>
							</div>
							<div class="w-full bg-[var(--bg)] rounded-full h-1.5 overflow-hidden">
								<div
									class="h-full rounded-full transition-all"
									x-bind:class="(p.ratio ?? 0) > 0.8 ? 'bg-[var(--err)]' : 'bg-[var(--ok)]'"
									x-bind:style="'width: ' + Math.min(100, Math.max(0, (p.ratio ?? 0) * 100)) + '%'"
								></div>
							</div>
							<div class="flex justify-between text-[10px] text-[var(--muted)] font-mono">
								<span>Usado: <strong class="text-[var(--text)]" x-text="p.used_tokens ?? 0"></strong></span>
								<span>Limite: <strong class="text-[var(--text)]" x-text="p.limit_tokens ?? 0"></strong></span>
							</div>
						</div>
					</template>
				</div>
			}
		</div>

		<script>
			function modelsState() {
				return {
					connected: false,
					observedAt: null,
					bindings: [],
					note: '',
					pressures: [],
					pressureNote: '',
					// Estado de Configuração de Modelos (Control API)
					cfgActiveRevision: 0,
					cfgPayload: { providers: [], bindings: [] },
					vaultState: 'Desconhecido',

					// Descoberta Dinâmica de Modelos
					discoveredModels: [],
					discoveredModelsNote: '',

					// Form de Provedor (sem modelo fixo)
					showProviderForm: false,
					providerFormIsEdit: false,
					providerForm: {
						id: '',
						kind: 'openai_compatible',
						base_url: 'https://api.groq.com/openai/v1',
						api_key_env: 'GROQ_API_KEY',
						max_concurrent: 2,
						secret_value: ''
					},

					// Form de Binding / Preferência de Modelo (Opcional)
					showBindingForm: false,
					bindingForm: {
						provider_ref: '',
						model_id: '',
						context_tokens: 131072,
						max_output_tokens: 8192,
						priority: 10
					},

					formSubmitting: false,
					formMsg: '',
					formIsErr: false,

					get observedAgo() {
						if (!this.observedAt) return '';
						const s = Math.max(0, (Date.now() - this.observedAt) / 1000 | 0);
						return s < 60 ? `${s}s atrás` : `${s/60|0}min atrás`;
					},

					async refresh() {
						try {
							const [b, p, activeRev] = await Promise.all([
								fetch('/dash/api/model-bindings').then(r => r.json()),
								fetch('/dash/api/model-context-pressures').then(r => r.json()),
								fetch('/dash/api/control/config/revisions/active?scope=MODELS').then(r => r.json()).catch(() => ({}))
							]);
							this.bindings = b?.bindings ?? [];
							this.note = b?.note ?? '';
							this.pressures = p?.pressures ?? [];
							this.pressureNote = p?.note ?? '';

							const rev = activeRev?.revision || activeRev;
							if (rev && rev.payload) {
								this.cfgActiveRevision = Number(rev.revision || 0);
								this.cfgPayload = rev.payload.models || rev.payload || { providers: [], bindings: [] };
								if (!Array.isArray(this.cfgPayload.providers)) this.cfgPayload.providers = [];
								if (!Array.isArray(this.cfgPayload.bindings)) this.cfgPayload.bindings = [];
							}

							await this.refreshVaultStatus();
							this.observedAt = Date.now();
							this.connected = true;
						} catch (e) { this.connected = false; }
					},

					async discoverModels() {
						try {
							this.discoveredModelsNote = 'Buscando modelos dinâmicos da API OpenAI...';
							const res = await fetch('/dash/api/provider/models');
							const data = await res.json();
							if (data && data.models && Array.isArray(data.models)) {
								this.discoveredModels = data.models;
								this.discoveredModelsNote = `${data.models.length} modelos dinâmicos retornados pela API OpenAI`;
								if (window.notify) window.notify(`${data.models.length} modelos descobertos da API OpenAI!`, 'success');
							} else {
								this.discoveredModelsNote = data.note || 'Nenhum modelo retornado no momento.';
							}
						} catch (err) {
							this.discoveredModelsNote = 'Erro na descoberta: ' + err.message;
						}
					},

					async discoverModelsForProvider(pId) {
						await this.discoverModels();
					},

					async refreshVaultStatus() {
						try {
							const res = await fetch('/dash/api/vault/status');
							const s = await res.json();
							if (!s.initialized) this.vaultState = 'Não inicializado';
							else if (s.locked) this.vaultState = 'Bloqueado';
							else this.vaultState = 'Desbloqueado (' + (s.secrets || []).length + ' credenciais)';
						} catch (err) {
							this.vaultState = 'Indisponível';
						}
					},

					async unlockVault(pass) {
						if (!pass) return;
						try {
							const statusRes = await fetch('/dash/api/vault/status');
							const s = await statusRes.json();
							const endpoint = s.initialized ? '/dash/api/vault/unlock' : '/dash/api/vault/initialize';
							const res = await fetch(endpoint, {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({ password: pass })
							});
							if (!res.ok) throw new Error('Falha ao desbloquear');
							await this.refreshVaultStatus();
							if (window.notify) window.notify('Cofre de credenciais desbloqueado!', 'success');
						} catch (err) {
							if (window.notify) window.notify('Erro no cofre: ' + err.message, 'error');
						}
					},

					openAddProviderModal() {
						this.providerFormIsEdit = false;
						this.providerForm = {
							id: '',
							kind: 'openai_compatible',
							base_url: 'https://api.groq.com/openai/v1',
							api_key_env: 'GROQ_API_KEY',
							max_concurrent: 2,
							secret_value: ''
						};
						this.formMsg = '';
						this.showProviderForm = true;
					},

					openAddBindingModal() {
						const firstP = (this.cfgPayload.providers || [])[0];
						this.bindingForm = {
							provider_ref: firstP ? firstP.id : '',
							model_id: '',
							context_tokens: 131072,
							max_output_tokens: 8192,
							priority: 10
						};
						this.formMsg = '';
						this.showBindingForm = true;
					},

					addBindingFromDiscovered(modelId) {
						const firstP = (this.cfgPayload.providers || [])[0];
						this.bindingForm = {
							provider_ref: firstP ? firstP.id : '',
							model_id: modelId,
							context_tokens: 131072,
							max_output_tokens: 8192,
							priority: 10
						};
						this.showBindingForm = true;
					},

					editProvider(id) {
						const p = (this.cfgPayload.providers || []).find(x => x.id === id);
						if (!p) return;
						this.providerFormIsEdit = true;
						this.providerForm = {
							id: p.id,
							kind: p.kind || 'openai_compatible',
							base_url: p.base_url || '',
							max_concurrent: (p.global_limit && p.global_limit.max_concurrent) || 1,
							api_key_env: p.api_key_env || 'GROQ_API_KEY',
							secret_value: ''
						};
						this.formMsg = '';
						this.showProviderForm = true;
					},

					async saveSecretIfProvided(id, secret) {
						if (!secret) return;
						await fetch('/dash/api/vault/secrets/provider/' + encodeURIComponent(id) + '/api-key', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ value: secret })
						});
					},

					async submitProviderForm() {
						this.formSubmitting = true;
						this.formMsg = 'Salvando provedor...';
						this.formIsErr = false;
						try {
							const id = this.providerForm.id.trim();
							if (!id) throw new Error("ID do provedor é obrigatório.");

							if (this.providerForm.secret_value) {
								await this.saveSecretIfProvided(id, this.providerForm.secret_value);
							}

							const currentProviders = [...(this.cfgPayload.providers || [])];
							const newP = {
								id: id,
								kind: this.providerForm.kind,
								base_url: this.providerForm.base_url.trim(),
								api_key_env: this.providerForm.api_key_env.trim(),
								enabled: true,
								global_limit: { max_concurrent: Number(this.providerForm.max_concurrent) }
							};

							const pi = currentProviders.findIndex(x => x.id === id);
							if (pi >= 0) currentProviders[pi] = newP; else currentProviders.push(newP);

							const next = { providers: currentProviders, bindings: [...(this.cfgPayload.bindings || [])] };
							await this.createModelsDraft(next, (pi >= 0 ? "Atualizar provedor " : "Adicionar provedor ") + id);
							if (window.notify) window.notify('Provedor ' + id + ' salvo com sucesso!', 'success');
							this.showProviderForm = false;
						} catch (err) {
							this.formMsg = 'Erro: ' + err.message;
							this.formIsErr = true;
							if (window.notify) window.notify('Erro ao salvar provedor: ' + err.message, 'error');
						} finally {
							this.formSubmitting = false;
						}
					},

					async submitBindingForm() {
						this.formSubmitting = true;
						this.formMsg = 'Salvando preferência de modelo...';
						this.formIsErr = false;
						try {
							const pRef = this.bindingForm.provider_ref;
							const mId = this.bindingForm.model_id.trim();
							if (!pRef || !mId) throw new Error("Provedor e ID do modelo são obrigatórios.");

							const currentBindings = [...(this.cfgPayload.bindings || [])];
							const newB = {
								id: "binding_" + pRef + "_" + mId.replace(/[^a-zA-Z0-9]/g, '_'),
								slot: "SLOT_" + mId.toUpperCase().replace(/[^A-Z0-9]/g, '_'),
								provider_ref: pRef,
								model_id: mId,
								enabled: true,
								context_tokens: Number(this.bindingForm.context_tokens),
								max_output_tokens: Number(this.bindingForm.max_output_tokens),
								priority: Number(this.bindingForm.priority)
							};

							const bi = currentBindings.findIndex(x => x.provider_ref === pRef && x.model_id === mId);
							if (bi >= 0) currentBindings[bi] = newB; else currentBindings.push(newB);

							const next = { providers: [...(this.cfgPayload.providers || [])], bindings: currentBindings };
							await this.createModelsDraft(next, "Adicionar preferência de modelo " + mId);
							if (window.notify) window.notify('Preferência de modelo ' + mId + ' salva!', 'success');
							this.showBindingForm = false;
						} catch (err) {
							this.formMsg = 'Erro: ' + err.message;
							this.formIsErr = true;
							if (window.notify) window.notify('Erro ao salvar binding: ' + err.message, 'error');
						} finally {
							this.formSubmitting = false;
						}
					},

					async toggleProvider(id) {
						const currentProviders = [...(this.cfgPayload.providers || [])];
						const pi = currentProviders.findIndex(x => x.id === id);
						if (pi < 0) return;
						currentProviders[pi].enabled = !currentProviders[pi].enabled;
						const next = { providers: currentProviders, bindings: [...(this.cfgPayload.bindings || [])] };
						await this.createModelsDraft(next, (currentProviders[pi].enabled ? "Ativar " : "Desativar ") + id);
					},

					async removeProvider(id) {
						if (!confirm("Remover o provedor " + id + " do catálogo de provedores?")) return;
						const nextP = (this.cfgPayload.providers || []).filter(x => x.id !== id);
						const nextB = (this.cfgPayload.bindings || []).filter(x => x.provider_ref !== id);
						await this.createModelsDraft({ providers: nextP, bindings: nextB }, "Remover provedor " + id);
					},

					async removeBinding(idOrSlot) {
						if (!confirm("Remover esta preferência de modelo?")) return;
						const nextB = (this.cfgPayload.bindings || []).filter(x => x.id !== idOrSlot && x.slot !== idOrSlot);
						await this.createModelsDraft({ providers: [...(this.cfgPayload.providers || [])], bindings: nextB }, "Remover preferência de modelo");
					},

					async createModelsDraft(modelsPayload, note) {
						const draftRes = await fetch('/dash/api/control/config/drafts', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								scope: 'MODELS',
								payload: { models: modelsPayload },
								note: note || 'Draft alterado via dashboard v2'
							})
						});
						const draft = await draftRes.json();
						if (!draftRes.ok) throw new Error(draft.error?.message || draft.message || 'Erro ao criar rascunho');

						const draftID = draft.id || (draft.draft && draft.draft.id);

						const valRes = await fetch('/dash/api/control/config/drafts/' + draftID + '/validate', { method: 'POST' });
						const val = await valRes.json();
						if (!valRes.ok) throw new Error(val.error?.message || 'Rascunho inválido');

						const appRes = await fetch('/dash/api/control/config/drafts/' + draftID + '/apply', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ reason: note || 'Aplicado via dashboard v2' })
						});
						const app = await appRes.json();
						if (!appRes.ok) throw new Error(app.error?.message || 'Erro ao aplicar rascunho');

						await this.refresh();
					},

					start() {
						this.refresh();
						setInterval(() => this.refresh(), 10000);
					}
				};
			}
		</script>
	}
}
