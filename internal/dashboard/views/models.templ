package views

templ Models() {
	@layout("Modelos & LLMs", "/dash/models", StandardNav("/dash/models")) {
		<div x-data="modelsState()" x-init="start()" class="space-y-8">
			<!-- Barra de Conexão e Ações -->
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-5 bg-[var(--panel)] border border-[var(--border)] rounded-[20px] p-6 shadow-sm">
				<div class="flex items-center gap-5">
					<div class="relative flex h-3 w-3 items-center justify-center">
						<span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75" x-bind:class="connected ? 'bg-[var(--ok)]' : 'bg-[var(--err)]'"></span>
						<span class="relative inline-flex rounded-full h-3 w-3" x-bind:class="connected ? 'bg-[var(--ok)] shadow-[0_0_8px_var(--ok)]' : 'bg-[var(--err)] shadow-[0_0_8px_var(--err)]'"></span>
					</div>
					<div class="flex flex-col">
						<span class="text-[15px] font-bold text-[var(--text)]" x-text="connected ? 'Inspect & Control API acessíveis' : 'Sem resposta das APIs'"></span>
						<span class="text-[13px] text-[var(--muted)]" x-show="observedAt">Último sync há <span x-text="observedAgo"></span></span>
					</div>
				</div>
				<div class="flex flex-wrap gap-3">
					<button
						type="button"
						class="px-5 py-2.5 rounded-xl bg-white text-black font-semibold text-[13px] flex items-center gap-2 hover:bg-[var(--accent-hover)] transition-all cursor-pointer shadow-sm"
						x-on:click="openAddProviderModal()"
					>
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
						Novo Provedor
					</button>
					<button
						type="button"
						class="px-5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--panel-sub)] text-[var(--text)] hover:bg-[var(--panel-hover)] transition-all font-semibold text-[13px] flex items-center gap-2 cursor-pointer shadow-sm"
						x-on:click="openAddBindingModal()"
					>
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
						Novo Binding
					</button>
					<button
						type="button"
						class="px-5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--bg)] text-[var(--muted)] hover:text-[var(--text)] hover:bg-[var(--panel-hover)] transition-all font-semibold text-[13px] flex items-center gap-2 shadow-sm cursor-pointer"
						x-on:click="refresh()"
					>
						<svg class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
						Atualizar
					</button>
				</div>
			</div>

			<!-- Status do Cofre de Credenciais -->
			<div class="p-6 rounded-[20px] bg-[var(--panel)] border border-[var(--border)] flex flex-col gap-5 shadow-sm hover:border-[var(--border-focus)] transition-all">
				<div class="flex flex-col md:flex-row md:items-center justify-between gap-5">
					<div class="flex items-center gap-4">
						<div class="w-10 h-10 rounded-full bg-[var(--info)]/10 flex items-center justify-center border border-[var(--info)]/20">
							<svg class="w-5 h-5 text-[var(--info)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
						</div>
						<div>
							<div class="font-bold text-[15px] text-[var(--text)]">Cofre de Credenciais Local</div>
							<div class="text-[13px] text-[var(--muted)] font-mono mt-0.5 flex items-center gap-2">
								Status: <span class="text-[var(--text)] font-semibold" x-text="vaultState"></span>
							</div>
						</div>
					</div>
					<div class="flex items-center gap-3" x-data="{ vPass: '' }">
						<input type="password" placeholder="Senha mestra..." x-model="vPass" class="px-5 py-3 rounded-xl bg-[var(--bg)] border border-[var(--border)] text-[var(--text)] w-full md:w-64 shadow-inner" @keyup.enter="unlockVault(vPass)"/>
						<button type="button" class="px-6 py-3 rounded-xl bg-[var(--info)] text-white hover:bg-blue-600 font-semibold text-[13px] transition-all cursor-pointer shadow-sm flex-shrink-0" x-on:click="unlockVault(vPass)">Desbloquear</button>
					</div>
				</div>
				<!-- Lista de Chaves -->
				<div x-show="vaultSecrets && vaultSecrets.length > 0" class="pt-4 border-t border-[var(--border)]">
					<div class="text-[12px] font-semibold text-[var(--subtle)] uppercase tracking-wider mb-3 flex items-center justify-between">
						<span>Segredos no Cofre</span>
						<button type="button" class="px-3 py-1.5 rounded-lg bg-[var(--panel-sub)] hover:bg-[var(--panel-hover)] text-[var(--text)] font-semibold text-[11px] transition-all cursor-pointer shadow-sm border border-[var(--border)]" x-on:click="openAddSecretModal()">+ Adicionar Credencial</button>
					</div>
					<div class="grid gap-3 grid-cols-1 sm:grid-cols-2 xl:grid-cols-3">
						<template x-for="sec in vaultSecrets" x-bind:key="sec.name || sec">
							<div class="flex flex-col p-4 rounded-xl bg-[var(--bg)] border border-[var(--border)] shadow-sm hover:border-[var(--border-focus)] transition-all">
								<div class="flex items-center justify-between mb-2">
									<div class="flex items-center gap-2 overflow-hidden">
										<svg class="w-4 h-4 text-[var(--ok)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
										<span class="font-bold text-[13px] text-[var(--text)] truncate" x-text="sec.name || sec"></span>
									</div>
									<div class="flex items-center gap-1">
										<button type="button" class="p-1.5 rounded-lg text-[var(--muted)] hover:text-[var(--text)] hover:bg-[var(--panel-hover)] transition-all cursor-pointer flex-shrink-0" x-on:click="editSecret(sec)" title="Editar Segredo">
											<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
										</button>
										<button type="button" class="p-1.5 rounded-lg text-[var(--err)] hover:bg-[var(--err)]/10 transition-all cursor-pointer flex-shrink-0" x-on:click="removeSecret(sec.name || sec)" title="Remover Segredo">
											<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
										</button>
									</div>
								</div>
								<div class="text-[12px] font-mono text-[var(--subtle)] bg-[var(--panel)] p-2 rounded-lg truncate border border-[var(--border)]/50" x-text="sec.hint ? sec.hint : '••••••••'"></div>
							</div>
						</template>
					</div>
				</div>
			</div>

			<!-- Form / Modal para Adicionar ou Editar Segredo do Cofre -->
			<div x-show="showSecretForm" x-transition.opacity.duration.300ms class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm" style="display:none;">
				<div class="w-full max-w-lg bg-[var(--bg)] border border-[var(--border-focus)]/50 rounded-[24px] shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
					<div class="flex justify-between items-center p-6 border-b border-[var(--border)] bg-[var(--panel)]">
						<h3 class="font-bold text-lg text-[var(--text)] flex items-center gap-3">
							<div class="w-2 h-2 rounded-full bg-[var(--info)] shadow-[0_0_8px_var(--info)]"></div>
							<span x-text="secretFormIsEdit ? 'Editar Credencial: ' + secretForm.name : 'Nova Credencial'"></span>
						</h3>
						<button type="button" class="p-2 rounded-lg text-[var(--muted)] hover:text-[var(--text)] hover:bg-[var(--panel-sub)] transition-all cursor-pointer" x-on:click="showSecretForm = false">
							<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
						</button>
					</div>
					<div class="p-6 overflow-y-auto">
						<form id="secretForm" x-on:submit.prevent="submitSecretForm()" class="grid gap-6 grid-cols-1 text-[14px]">
							<div class="space-y-1.5">
								<label class="block text-[var(--subtle)] font-semibold text-[12px] uppercase tracking-wider">Nome da Variável / Chave</label>
								<input type="text" x-model="secretForm.name" x-bind:readonly="secretFormIsEdit" required class="w-full font-mono text-[13px]" placeholder="ex: GROQ_API_KEY" x-bind:class="secretFormIsEdit ? 'opacity-50 cursor-not-allowed' : ''"/>
							</div>
							<div class="space-y-1.5">
								<label class="block text-[var(--subtle)] font-semibold text-[12px] uppercase tracking-wider">Valor do Segredo</label>
								<input type="password" x-model="secretForm.value" required class="w-full font-mono text-[13px]" placeholder="••••••••••••••••"/>
							</div>
						</form>
						<div x-show="formMsg" class="mt-4 p-4 rounded-xl font-mono text-[13px] border" x-bind:class="formIsErr ? 'bg-[var(--err)]/10 text-[var(--err)] border-[var(--err)]/20' : 'bg-[var(--ok)]/10 text-[var(--ok)] border-[var(--ok)]/20'" x-text="formMsg"></div>
					</div>
					<div class="p-6 border-t border-[var(--border)] bg-[var(--panel)] flex justify-end gap-3">
						<button type="button" class="px-5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--panel-sub)] hover:bg-[var(--panel-hover)] text-[var(--text)] font-semibold text-[14px] transition-all cursor-pointer" x-on:click="showSecretForm = false">Cancelar</button>
						<button type="submit" form="secretForm" class="px-6 py-2.5 rounded-xl bg-[var(--info)] text-white font-semibold text-[14px] hover:bg-blue-600 transition-all cursor-pointer flex items-center gap-2" x-bind:disabled="formSubmitting">
							<span x-show="formSubmitting" class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
							<span x-text="secretFormIsEdit ? 'Atualizar Segredo' : 'Salvar no Cofre'"></span>
						</button>
					</div>
				</div>
			</div>

			<!-- Form / Modal para Adicionar ou Editar Provedor LLM -->
			<div x-show="showProviderForm" x-transition.opacity.duration.300ms class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm" style="display:none;">
				<div class="w-full max-w-2xl bg-[var(--bg)] border border-[var(--border-focus)]/50 rounded-[24px] shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
					<div class="flex justify-between items-center p-6 border-b border-[var(--border)] bg-[var(--panel)]">
						<h3 class="font-bold text-lg text-[var(--text)] flex items-center gap-3">
							<div class="w-2 h-2 rounded-full bg-white shadow-[0_0_8px_white]"></div>
							<span x-text="providerFormIsEdit ? 'Editar Provedor: ' + providerForm.id : 'Novo Provedor LLM'"></span>
						</h3>
						<button type="button" class="p-2 rounded-lg text-[var(--muted)] hover:text-[var(--text)] hover:bg-[var(--panel-sub)] transition-all cursor-pointer" x-on:click="showProviderForm = false">
							<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
						</button>
					</div>
					<div class="p-6 overflow-y-auto">
						<form id="providerForm" x-on:submit.prevent="submitProviderForm()" class="grid gap-6 grid-cols-1 md:grid-cols-2 text-[14px]">
							<div class="space-y-1.5">
								<label class="block text-[var(--subtle)] font-semibold text-[12px] uppercase tracking-wider">ID do Provedor (Slug)</label>
								<input type="text" x-model="providerForm.id" x-bind:readonly="providerFormIsEdit" required class="w-full font-mono" placeholder="ex: groq, nvidia-nim, ollama" x-bind:class="providerFormIsEdit ? 'opacity-50 cursor-not-allowed' : ''"/>
							</div>
							<div class="space-y-1.5">
								<label class="block text-[var(--subtle)] font-semibold text-[12px] uppercase tracking-wider">Tipo de Provedor</label>
								<select x-model="providerForm.kind" class="w-full">
									<option value="openai_compatible">OpenAI Compatible</option>
								</select>
							</div>
							<div class="col-span-1 md:col-span-2 space-y-1.5">
								<label class="block text-[var(--subtle)] font-semibold text-[12px] uppercase tracking-wider">Base URL do Endpoint</label>
								<input type="url" x-model="providerForm.base_url" required class="w-full font-mono text-[13px]" placeholder="https://api.groq.com/openai/v1"/>
							</div>
							<div class="space-y-1.5">
								<label class="block text-[var(--subtle)] font-semibold text-[12px] uppercase tracking-wider">Env Var da API Key</label>
								<input type="text" x-model="providerForm.api_key_env" required class="w-full font-mono text-[13px]" placeholder="GROQ_API_KEY"/>
							</div>
							<div class="space-y-1.5">
								<label class="block text-[var(--subtle)] font-semibold text-[12px] uppercase tracking-wider">Concorrência Máx.</label>
								<input type="number" x-model.number="providerForm.max_concurrent" required min="1" max="100" class="w-full font-mono"/>
							</div>
							<div class="col-span-1 md:col-span-2 space-y-1.5">
								<label class="block text-[var(--subtle)] font-semibold text-[12px] uppercase tracking-wider flex justify-between">
									<span>API Secret (Cofre Local)</span>
									<span class="text-[10px] text-[var(--info)] normal-case">Opcional</span>
								</label>
								<input type="password" x-model="providerForm.secret_value" class="w-full font-mono text-[13px]" placeholder="Preencha para salvar/atualizar no Vault seguro"/>
							</div>
						</form>
						<div x-show="formMsg" class="mt-4 p-4 rounded-xl font-mono text-[13px] border" x-bind:class="formIsErr ? 'bg-[var(--err)]/10 text-[var(--err)] border-[var(--err)]/20' : 'bg-[var(--ok)]/10 text-[var(--ok)] border-[var(--ok)]/20'" x-text="formMsg"></div>
					</div>
					<div class="p-6 border-t border-[var(--border)] bg-[var(--panel)] flex justify-end gap-3">
						<button type="button" class="px-5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--panel-sub)] hover:bg-[var(--panel-hover)] text-[var(--text)] font-semibold text-[14px] transition-all cursor-pointer" x-on:click="showProviderForm = false">Cancelar</button>
						<button type="submit" form="providerForm" class="px-6 py-2.5 rounded-xl bg-white text-black font-semibold text-[14px] hover:bg-[var(--accent-hover)] transition-all cursor-pointer flex items-center gap-2" x-bind:disabled="formSubmitting">
							<span x-show="formSubmitting" class="w-4 h-4 border-2 border-black border-t-transparent rounded-full animate-spin"></span>
							<span x-text="providerFormIsEdit ? 'Salvar Alterações' : 'Cadastrar Provedor'"></span>
						</button>
					</div>
				</div>
			</div>

			<!-- Form / Modal para Adicionar Preferência de Modelo (Binding Opcional) -->
			<div x-show="showBindingForm" x-transition.opacity.duration.300ms class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm" style="display:none;">
				<div class="w-full max-w-2xl bg-[var(--bg)] border border-[var(--border-focus)]/50 rounded-[24px] shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
					<div class="flex justify-between items-center p-6 border-b border-[var(--border)] bg-[var(--panel)]">
						<h3 class="font-bold text-lg text-[var(--text)] flex items-center gap-3">
							<div class="w-2 h-2 rounded-full bg-[var(--info)] shadow-[0_0_8px_var(--info)]"></div>
							Nova Preferência de Modelo (Binding)
						</h3>
						<button type="button" class="p-2 rounded-lg text-[var(--muted)] hover:text-[var(--text)] hover:bg-[var(--panel-sub)] transition-all cursor-pointer" x-on:click="showBindingForm = false">
							<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
						</button>
					</div>
					<div class="p-6 overflow-y-auto">
						<form id="bindingForm" x-on:submit.prevent="submitBindingForm()" class="grid gap-6 grid-cols-1 md:grid-cols-2 text-[14px]">
							<div class="space-y-1.5">
								<label class="block text-[var(--subtle)] font-semibold text-[12px] uppercase tracking-wider">Provedor de Origem</label>
								<select x-model="bindingForm.provider_ref" required class="w-full">
									<template x-for="p in (cfgPayload.providers || [])" x-bind:key="p.id">
										<option x-bind:value="p.id" x-text="p.id"></option>
									</template>
								</select>
							</div>
							<div class="space-y-1.5">
								<label class="block text-[var(--subtle)] font-semibold text-[12px] uppercase tracking-wider">ID do Modelo</label>
								<input type="text" x-model="bindingForm.model_id" required class="w-full font-mono text-[13px]" placeholder="ex: llama-3.3-70b-versatile"/>
							</div>
							<div class="space-y-1.5">
								<label class="block text-[var(--subtle)] font-semibold text-[12px] uppercase tracking-wider">Janela Contexto (tokens)</label>
								<input type="number" x-model.number="bindingForm.context_tokens" required min="1024" class="w-full font-mono"/>
							</div>
							<div class="space-y-1.5">
								<label class="block text-[var(--subtle)] font-semibold text-[12px] uppercase tracking-wider">Máx. Output Tokens</label>
								<input type="number" x-model.number="bindingForm.max_output_tokens" required min="256" class="w-full font-mono"/>
							</div>
							<div class="col-span-1 md:col-span-2 space-y-1.5">
								<label class="block text-[var(--subtle)] font-semibold text-[12px] uppercase tracking-wider">Prioridade (menor = maior prio)</label>
								<input type="number" x-model.number="bindingForm.priority" required min="1" max="100" class="w-full font-mono"/>
							</div>
						</form>
						<div x-show="formMsg" class="mt-4 p-4 rounded-xl font-mono text-[13px] border" x-bind:class="formIsErr ? 'bg-[var(--err)]/10 text-[var(--err)] border-[var(--err)]/20' : 'bg-[var(--ok)]/10 text-[var(--ok)] border-[var(--ok)]/20'" x-text="formMsg"></div>
					</div>
					<div class="p-6 border-t border-[var(--border)] bg-[var(--panel)] flex justify-end gap-3">
						<button type="button" class="px-5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--panel-sub)] hover:bg-[var(--panel-hover)] text-[var(--text)] font-semibold text-[14px] transition-all cursor-pointer" x-on:click="showBindingForm = false">Cancelar</button>
						<button type="submit" form="bindingForm" class="px-6 py-2.5 rounded-xl bg-white text-black font-semibold text-[14px] hover:bg-[var(--accent-hover)] transition-all cursor-pointer flex items-center gap-2" x-bind:disabled="formSubmitting">
							<span x-show="formSubmitting" class="w-4 h-4 border-2 border-black border-t-transparent rounded-full animate-spin"></span>
							Salvar Preferência
						</button>
					</div>
				</div>
			</div>

			<!-- Gestão de Provedores LLM Configurados -->
			@card("Provedores LLM Configurados") {
				<div class="px-3 py-2 bg-slate-900 rounded-md shadow-inner text-xs border border-slate-700 w-full font-mono text-slate-300 break-words mb-4" style="max-height: 200px; overflow-y: auto;">
					<div class="flex items-center gap-2 mb-2 text-indigo-400">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
						<span class="font-bold">Info do Sistema de Configuração:</span>
					</div>
					<div class="space-y-1">
						<div><span class="text-slate-500">Revisão Ativa (Base): </span><span class="font-bold text-emerald-400" x-text="cfgActiveRevision"></span></div>
						<div><span class="text-slate-500">Qtd Provedores: </span><span x-text="(cfgPayload.providers || []).length"></span></div>
						<div><span class="text-slate-500">Qtd Bindings: </span><span x-text="(cfgPayload.bindings || []).length"></span></div>
					</div>
				</div>

				<template x-if="!cfgPayload || (cfgPayload.providers ?? []).length === 0">
					@EmptyState("Nenhum provedor configurado no catálogo ativo.")
				</template>
				<div class="grid gap-6 grid-cols-1 xl:grid-cols-2" x-show="cfgPayload && (cfgPayload.providers ?? []).length > 0">
					<template x-for="p in cfgPayload.providers" x-bind:key="p.id">
						<div class="p-6 rounded-[20px] bg-[var(--bg)] border border-[var(--border)] shadow-sm hover:border-[var(--border-focus)] transition-all flex flex-col gap-5">
							<div class="flex flex-wrap items-start justify-between gap-4">
								<div class="flex items-center gap-4">
									<div class="w-12 h-12 rounded-xl bg-[var(--panel)] border border-[var(--border)] flex items-center justify-center font-bold text-lg text-[var(--text)] uppercase" x-text="p.id.substring(0,2)"></div>
									<div>
										<div class="font-bold text-[18px] text-[var(--text)] font-mono tracking-tight" x-text="p.id"></div>
										<div class="text-[12px] text-[var(--subtle)] font-mono mt-0.5" x-text="p.kind"></div>
									</div>
								</div>
								<div class="flex items-center gap-2">
									<button
										type="button"
										class="px-3 py-1.5 rounded-lg text-[13px] font-semibold bg-[var(--panel)] border border-[var(--border)] text-[var(--text)] hover:bg-[var(--panel-hover)] transition-all cursor-pointer shadow-sm flex items-center gap-1.5"
										x-on:click="editProvider(p.id)"
									>
										<svg class="w-3.5 h-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
										Editar
									</button>
									<button
										type="button"
										class="px-3 py-1.5 rounded-lg text-[13px] font-semibold bg-[var(--err)]/5 border border-[var(--err)]/20 text-[var(--err)] hover:bg-[var(--err)]/20 transition-all cursor-pointer shadow-sm flex items-center gap-1.5"
										x-on:click="removeProvider(p.id)"
									>
										<svg class="w-3.5 h-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
										Remover
									</button>
								</div>
							</div>
							
							<div class="px-4 py-3 bg-[var(--panel)] rounded-xl border border-[var(--border)] text-[12px] font-mono text-[var(--muted)] truncate" x-text="p.base_url"></div>
							
							<div class="grid grid-cols-3 gap-3 border-t border-[var(--border)] pt-5">
								<div class="flex flex-col gap-1">
									<span class="text-[11px] font-semibold text-[var(--subtle)] uppercase tracking-wider">Env Key</span>
									<span class="text-[13px] font-mono text-[var(--text)] bg-[var(--panel)] px-2 py-1 rounded inline-block truncate" x-text="p.api_key_env || 'N/A'"></span>
								</div>
								<div class="flex flex-col gap-1">
									<span class="text-[11px] font-semibold text-[var(--subtle)] uppercase tracking-wider">Concorrência</span>
									<span class="text-[16px] font-bold text-[var(--text)] mt-1" x-text="(p.global_limit && p.global_limit.max_concurrent) || 1"></span>
								</div>
								<div class="flex flex-col gap-1">
									<span class="text-[11px] font-semibold text-[var(--subtle)] uppercase tracking-wider">Bindings</span>
									<span class="text-[16px] font-bold text-white mt-1" x-text="(cfgPayload.bindings || []).filter(b => b.provider_ref === p.id).length"></span>
								</div>
							</div>
							
							<button
								type="button"
								class="mt-1 w-full px-4 py-3 rounded-xl text-[13px] font-semibold text-[var(--text)] bg-[var(--panel-sub)] border border-[var(--border)] hover:bg-[var(--panel-hover)] transition-all cursor-pointer shadow-sm flex items-center justify-center gap-2"
								x-on:click="discoverModelsForProvider(p.id)"
							>
								<svg class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
								Descobrir Modelos via API
							</button>
						</div>
					</template>
				</div>
			}

			<!-- Modelos Descobertos Dinamicamente via API OpenAI -->
			@card("Modelos Disponíveis (Descoberta Dinâmica)") {
				<div class="space-y-5">
					<div class="flex flex-col md:flex-row md:items-center justify-between text-sm gap-4 bg-[var(--panel)] p-5 rounded-[20px] border border-[var(--border)] shadow-sm">
						<div class="flex items-center gap-3 text-[var(--text)]">
							<svg class="w-5 h-5 text-[var(--info)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
							<span class="font-medium" x-text="discoveredModelsNote || 'Buscando lista atualizada de modelos no provedor ativo...'"></span>
						</div>
						<button
							type="button"
							class="px-5 py-2.5 rounded-xl bg-white text-black font-semibold text-[13px] transition-all cursor-pointer shadow-sm hover:bg-[var(--accent-hover)] shrink-0 flex items-center justify-center gap-2"
							x-on:click="discoverModels()"
						>
							<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
							Sincronizar Lista
						</button>
					</div>
					
					<template x-if="discoveredModels.length === 0">
						@EmptyState("Nenhum modelo carregado ainda. Clique em Sincronizar para buscar na API.")
					</template>
					
					<div class="flex flex-wrap gap-3 pt-2" x-show="discoveredModels.length > 0">
						<template x-for="m in discoveredModels" x-bind:key="m">
							<div class="inline-flex items-center justify-between gap-4 pl-4 pr-1.5 py-1.5 rounded-xl bg-[var(--bg)] border border-[var(--border)] text-[14px] font-mono shadow-sm hover:border-[var(--border-focus)] transition-colors group">
								<span class="font-bold text-[var(--text)] tracking-tight" x-text="m"></span>
								<button
									type="button"
									class="text-[12px] font-semibold text-[var(--text)] bg-[var(--panel-sub)] hover:bg-white hover:text-black px-3 py-1.5 rounded-lg transition-all cursor-pointer opacity-0 group-hover:opacity-100 focus:opacity-100 flex items-center gap-1.5"
									x-on:click="addBindingFromDiscovered(m)"
									title="Adicionar às preferências"
								>
									<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
									Fixar
								</button>
							</div>
						</template>
					</div>
				</div>
			}

			<!-- Preferências de Modelo / Bindings Registradas (Opcional) -->
			@card("Regras de Roteamento / Bindings") {
				<p class="text-[14px] text-[var(--muted)] mb-5 font-medium leading-relaxed" x-show="note" x-text="note"></p>
				
				<div class="rounded-[20px] border border-[var(--border)] shadow-sm overflow-hidden bg-[var(--bg)]">
					<div class="overflow-x-auto">
						<table class="w-full text-left border-collapse text-[14px]">
							<thead>
								<tr class="border-b border-[var(--border)] bg-[var(--panel)]">
									<th class="py-4 px-6 font-semibold text-[12px] text-[var(--subtle)] uppercase tracking-wider">Slot / Role</th>
									<th class="py-4 px-6 font-semibold text-[12px] text-[var(--subtle)] uppercase tracking-wider">Modelo</th>
									<th class="py-4 px-6 font-semibold text-[12px] text-[var(--subtle)] uppercase tracking-wider">Provedor</th>
									<th class="py-4 px-6 font-semibold text-[12px] text-[var(--subtle)] uppercase tracking-wider text-center">Concorrência</th>
									<th class="py-4 px-6 font-semibold text-[12px] text-[var(--subtle)] uppercase tracking-wider text-right">Ação</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-[var(--border)] font-mono text-[13px]">
								<template x-if="bindings.length === 0">
									<tr><td colspan="5" class="py-12 text-center text-[var(--muted)] font-sans font-medium">Nenhuma regra explícita cadastrada (roteamento dinâmico ativo).</td></tr>
								</template>
								<template x-for="b in bindings" x-bind:key="b.slot ?? b.role ?? Math.random()">
									<tr class="hover:bg-[var(--panel-hover)]/30 transition-colors">
										<td class="py-4 px-6 font-bold text-[var(--text)]" x-text="b.slot ?? b.role ?? '–'"></td>
										<td class="py-4 px-6 text-white font-bold" x-text="b.model_id ?? b.model ?? '–'"></td>
										<td class="py-4 px-6 text-[var(--muted)]" x-text="b.provider ?? '–'"></td>
										<td class="py-4 px-6 text-[var(--text)] font-bold text-center" x-text="b.max_concurrent ?? '–'"></td>
										<td class="py-4 px-6 text-right">
											<button
												type="button"
												class="text-[12px] font-semibold text-[var(--err)] hover:text-white bg-[var(--err)]/10 hover:bg-[var(--err)] px-3 py-1.5 rounded-lg transition-all cursor-pointer"
												x-on:click="removeBinding(b.id ?? b.slot)"
											>Remover</button>
										</td>
									</tr>
								</template>
							</tbody>
						</table>
					</div>
				</div>
			}

			<!-- Pressões de Contexto -->
			@card("Pressão de Contexto Ativa") {
				<p class="text-[14px] text-[var(--muted)] mb-6 font-medium leading-relaxed" x-show="pressureNote" x-text="pressureNote"></p>
				
				<div class="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
					<template x-if="pressures.length === 0">
						<div class="col-span-full">
							@EmptyState("Nenhum dado de pressão de contexto reportado nas últimas sessões.")
						</div>
					</template>
					<template x-for="p in pressures" x-bind:key="p.model_id ?? Math.random()">
						<div class="p-6 rounded-[20px] bg-[var(--bg)] border border-[var(--border)] shadow-sm space-y-5 hover:border-[var(--border-focus)] transition-colors">
							<div class="flex justify-between items-center text-[14px] font-mono">
								<span class="font-bold text-[var(--text)] truncate mr-3" x-text="p.model_id ?? '–'"></span>
								<span
									class="px-2.5 py-1 rounded-md text-[12px] font-bold tracking-wider"
									x-bind:class="(p.ratio ?? 0) > 0.8 ? 'bg-[var(--err)]/20 text-[var(--err)]' : 'bg-[var(--ok)]/10 text-[var(--ok)]'"
									x-text="((p.ratio ?? 0) * 100).toFixed(1) + '%'"
								></span>
							</div>
							
							<!-- Custom Progress Bar -->
							<div class="w-full bg-[var(--panel)] rounded-full h-3 overflow-hidden border border-[var(--border)]">
								<div
									class="h-full rounded-full transition-all duration-1000 ease-out"
									x-bind:class="(p.ratio ?? 0) > 0.8 ? 'bg-[var(--err)]' : 'bg-white'"
									x-bind:style="'width: ' + Math.min(100, Math.max(0, (p.ratio ?? 0) * 100)) + '%'"
								></div>
							</div>
							
							<div class="flex justify-between text-[12px] text-[var(--muted)] font-mono">
								<span>Usado: <strong class="text-[var(--text)] font-semibold" x-text="p.used_tokens ?? 0"></strong></span>
								<span>Limite: <strong class="text-[var(--text)] font-semibold" x-text="p.limit_tokens ?? 0"></strong></span>
							</div>
						</div>
					</template>
				</div>
			}
		</div>

		<script>
			function modelsState() {
				return {
					connected: false,
					observedAt: null,
					bindings: [],
					note: '',
					pressures: [],
					pressureNote: '',
					// Estado de Configuração de Modelos (Control API)
					cfgActiveRevision: 0,
					cfgPayload: { providers: [], bindings: [] },
					vaultState: 'Desconhecido',
					vaultSecrets: [],

					// Descoberta Dinâmica de Modelos
					discoveredModels: [],
					discoveredModelsNote: '',

					// Form de Credencial Isolada
					showSecretForm: false,
					secretFormIsEdit: false,
					secretForm: {
						name: '',
						value: ''
					},

					// Form de Provedor (sem modelo fixo)
					showProviderForm: false,
					providerFormIsEdit: false,
					providerForm: {
						id: '',
						kind: 'openai_compatible',
						base_url: 'https://api.groq.com/openai/v1',
						api_key_env: 'GROQ_API_KEY',
						max_concurrent: 2,
						secret_value: ''
					},

					// Form de Binding / Preferência de Modelo (Opcional)
					showBindingForm: false,
					bindingForm: {
						provider_ref: '',
						model_id: '',
						context_tokens: 131072,
						max_output_tokens: 8192,
						priority: 10
					},

					formSubmitting: false,
					formMsg: '',
					formIsErr: false,

					get observedAgo() {
						if (!this.observedAt) return '';
						const s = Math.max(0, (Date.now() - this.observedAt) / 1000 | 0);
						return s < 60 ? `${s}s atrás` : `${s/60|0}min atrás`;
					},

					async refresh() {
						try {
							const [b, p, activeRev] = await Promise.all([
								fetch('/dash/api/model-bindings').then(r => r.json()),
								fetch('/dash/api/model-context-pressures').then(r => r.json()),
								fetch('/dash/api/control/config/revisions/active?scope=MODELS&_t=' + Date.now(), { cache: 'no-store' }).then(async r => {
									if (!r.ok) {
										const e = await r.json().catch(() => ({}));
										if (e?.error?.code === 'not_found') return { revision: null };
										throw new Error('API fetch error: ' + r.status);
									}
									return r.json();
								}).catch(err => {
									console.warn("Failed to fetch active models revision:", err);
									return { revision: null };
								})
							]);
							this.bindings = b?.bindings ?? [];
							this.note = b?.note ?? '';
							this.pressures = p?.pressures ?? [];
							this.pressureNote = p?.note ?? '';

							const rev = (activeRev && activeRev.revision) ? activeRev.revision : null;
							if (rev && rev.revision !== undefined) {
								this.cfgActiveRevision = Number(rev.revision || 0);
								this.cfgPayload = rev.models || rev.payload || { providers: [], bindings: [] };
							} else {
								this.cfgActiveRevision = 0;
								this.cfgPayload = { providers: [], bindings: [] };
							}
							
							if (!Array.isArray(this.cfgPayload.providers)) this.cfgPayload.providers = [];
							if (!Array.isArray(this.cfgPayload.bindings)) this.cfgPayload.bindings = [];

							await this.refreshVaultStatus();
							this.observedAt = Date.now();
							this.connected = true;
						} catch (e) { this.connected = false; }
					},

					async discoverModels() {
						try {
							this.discoveredModelsNote = 'Buscando modelos na API...';
							const res = await fetch('/dash/api/provider/models');
							const data = await res.json();
							if (data && data.models && Array.isArray(data.models)) {
								this.discoveredModels = data.models;
								this.discoveredModelsNote = `${data.models.length} modelos dinâmicos retornados pela API`;
								if (window.notify) window.notify(`${data.models.length} modelos listados!`, 'success');
							} else {
								this.discoveredModelsNote = data.note || 'Nenhum modelo retornado no momento.';
							}
						} catch (err) {
							this.discoveredModelsNote = 'Erro na descoberta: ' + err.message;
						}
					},

					async discoverModelsForProvider(pId) {
						await this.discoverModels();
					},

					async refreshVaultStatus() {
						try {
							const res = await fetch('/dash/api/vault/status');
							const s = await res.json();
							if (!s.initialized) this.vaultState = 'Não inicializado';
							else if (s.locked) {
								this.vaultState = 'Bloqueado';
								this.vaultSecrets = [];
							}
							else {
								this.vaultState = 'Ativo (' + (s.secrets || []).length + ' chaves)';
								this.vaultSecrets = s.secrets || [];
							}
						} catch (err) {
							this.vaultState = 'Indisponível';
						}
					},

					async unlockVault(pass) {
						if (!pass) return;
						try {
							const statusRes = await fetch('/dash/api/vault/status');
							const s = await statusRes.json();
							const endpoint = s.initialized ? '/dash/api/vault/unlock' : '/dash/api/vault/initialize';
							const res = await fetch(endpoint, {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({ password: pass })
							});
							if (!res.ok) {
								let errMsg = 'Falha ao desbloquear';
								try { const errBody = await res.json(); errMsg = errBody?.error?.message || errMsg; } catch (_) {}
								throw new Error(errMsg);
							}
							await this.refreshVaultStatus();
							if (window.notify) window.notify('Cofre desbloqueado com sucesso!', 'success');
						} catch (err) {
							if (window.notify) window.notify('Erro no cofre: ' + err.message, 'error');
						}
					},

					async removeSecret(sec) {
						// Verificar se está em uso por algum provider antes de deletar
						const inUseBy = (this.cfgPayload.providers || []).find(p => p.api_key_env === sec);
						if (inUseBy) {
							if (!confirm(`Aviso: O segredo ${sec} está sendo referenciado pelo provedor '${inUseBy.id}'. Tem certeza que deseja removê-lo do cofre? Isso pode quebrar a integração.`)) return;
						} else {
							if (!confirm("Remover o segredo " + sec + " do cofre?")) return;
						}

						try {
							const res = await fetch('/dash/api/vault/secrets/' + encodeURIComponent(sec), {
								method: 'DELETE'
							});
							if (!res.ok) {
								let errMsg = 'Falha ao remover segredo';
								try { const errBody = await res.json(); errMsg = errBody?.error?.message || errMsg; } catch (_) {}
								throw new Error(errMsg);
							}
							await this.refreshVaultStatus();
							if (window.notify) window.notify('Segredo removido.', 'success');
						} catch (err) {
							if (window.notify) window.notify('Erro no cofre: ' + err.message, 'error');
						}
					},

					openAddSecretModal() {
						this.secretFormIsEdit = false;
						this.secretForm = { name: '', value: '' };
						this.formMsg = '';
						this.showSecretForm = true;
					},

					editSecret(secObj) {
						this.secretFormIsEdit = true;
						this.secretForm = { name: secObj.name || secObj, value: '' };
						this.formMsg = '';
						this.showSecretForm = true;
					},

					async submitSecretForm() {
						if (this.formSubmitting) return;
						this.formSubmitting = true;
						this.formMsg = 'Salvando...';
						this.formIsErr = false;
						try {
							const name = this.secretForm.name.trim();
							if (!name) throw new Error("Nome da chave é obrigatório.");
							if (!this.secretForm.value) throw new Error("Valor do segredo não pode ser vazio.");

							await this.saveSecretIfProvided(name, this.secretForm.value);
							await this.refreshVaultStatus();

							if (window.notify) window.notify('Credencial salva no cofre!', 'success');
							this.showSecretForm = false;
						} catch (err) {
							this.formMsg = err.message;
							this.formIsErr = true;
						} finally {
							this.formSubmitting = false;
						}
					},

					openAddProviderModal() {
						this.providerFormIsEdit = false;
						this.providerForm = {
							id: '',
							kind: 'openai_compatible',
							base_url: 'https://api.groq.com/openai/v1',
							api_key_env: 'GROQ_API_KEY',
							max_concurrent: 2,
							secret_value: ''
						};
						this.formMsg = '';
						this.showProviderForm = true;
					},

					openAddBindingModal() {
						const firstP = (this.cfgPayload.providers || [])[0];
						this.bindingForm = {
							provider_ref: firstP ? firstP.id : '',
							model_id: '',
							context_tokens: 131072,
							max_output_tokens: 8192,
							priority: 10
						};
						this.formMsg = '';
						this.showBindingForm = true;
					},

					addBindingFromDiscovered(modelId) {
						const firstP = (this.cfgPayload.providers || [])[0];
						this.bindingForm = {
							provider_ref: firstP ? firstP.id : '',
							model_id: modelId,
							context_tokens: 131072,
							max_output_tokens: 8192,
							priority: 10
						};
						this.formMsg = '';
						this.showBindingForm = true;
					},

					editProvider(id) {
						const p = (this.cfgPayload.providers || []).find(x => x.id === id);
						if (!p) return;
						this.providerFormIsEdit = true;
						this.providerForm = {
							id: p.id,
							kind: p.kind || 'openai_compatible',
							base_url: p.base_url || '',
							max_concurrent: (p.global_limit && p.global_limit.max_concurrent) || 1,
							api_key_env: p.api_key_env || 'GROQ_API_KEY',
							secret_value: ''
						};
						this.formMsg = '';
						this.showProviderForm = true;
					},

					cleanProvider(p) {
						const pId = (p.id || '').trim();
						return {
							id: pId,
							kind: p.kind || 'openai_compatible',
							base_url: (p.base_url || '').trim(),
							api_key_env: (p.api_key_env || 'GROQ_API_KEY').trim(),
							timeout: Number(p.timeout) || 90000000000,
							max_response_bytes: Number(p.max_response_bytes) || 10485760,
							global_limit: {
								resource: "model-provider:" + pId,
								max_concurrent: Number(p.global_limit?.max_concurrent) || 2,
								cooldown_base: Number(p.global_limit?.cooldown_base) || 30000000000,
								cooldown_max: Number(p.global_limit?.cooldown_max) || 300000000000
							}
						};
					},

					cleanBinding(b) {
						const bId = (b.id || ("binding_" + (b.provider_ref || '') + "_" + (b.model_id || '').replace(/[^a-zA-Z0-9]/g, '_'))).toLowerCase();
						return {
							id: bId,
							provider_ref: (b.provider_ref || '').trim(),
							model_id: (b.model_id || '').trim(),
							enabled: b.enabled !== undefined ? Boolean(b.enabled) : true,
							priority: Number(b.priority) || 10,
							context_tokens: Number(b.context_tokens) || 8192,
							max_output_tokens: Number(b.max_output_tokens) || 2048,
							max_output_dialect: b.max_output_dialect || "max_tokens",
							limit: {
								resource: "model-binding:" + bId,
								max_concurrent: Number(b.limit?.max_concurrent) || 1
							}
						};
					},

					async saveSecretIfProvided(apiKeyEnv, secret) {
						if (!secret) return;
						const res = await fetch('/dash/api/vault/secrets/' + encodeURIComponent(apiKeyEnv), {
							method: 'PUT',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ value: secret })
						});
						if (!res.ok) {
							let msg = 'Falha ao salvar credencial';
							try { const e = await res.json(); msg = e?.error?.message || msg; } catch (_) {}
							throw new Error(msg);
						}
					},

					async submitProviderForm() {
						if (this.formSubmitting) return;
						this.formSubmitting = true;
						this.formMsg = 'Salvando...';
						this.formIsErr = false;
						try {
							const id = this.providerForm.id.trim();
							if (!id) throw new Error("ID do provedor é obrigatório.");

							if (this.providerForm.secret_value) {
								await this.saveSecretIfProvided(this.providerForm.api_key_env.trim(), this.providerForm.secret_value);
							}

							const currentProviders = [...(this.cfgPayload.providers || [])];
							const newP = {
								id: id,
								kind: this.providerForm.kind,
								base_url: this.providerForm.base_url.trim(),
								api_key_env: this.providerForm.api_key_env.trim(),
								timeout: 90000000000,
								max_response_bytes: 10485760,
								global_limit: {
									resource: "model-provider:" + id,
									max_concurrent: Number(this.providerForm.max_concurrent) || 2,
									cooldown_base: 30000000000,
									cooldown_max: 300000000000
								}
							};

							const pi = currentProviders.findIndex(x => x.id === id);
							if (pi >= 0) currentProviders[pi] = newP; else currentProviders.push(newP);

							const next = { providers: currentProviders, bindings: [...(this.cfgPayload.bindings || [])] };
							await this.createModelsDraft(next, (pi >= 0 ? "Atualizar provedor " : "Adicionar provedor ") + id);
							if (window.notify) window.notify('Provedor salvo!', 'success');
							this.showProviderForm = false;
						} catch (err) {
							this.formMsg = err.message;
							this.formIsErr = true;
						} finally {
							this.formSubmitting = false;
						}
					},

					async submitBindingForm() {
						if (this.formSubmitting) return;
						this.formSubmitting = true;
						this.formMsg = 'Salvando...';
						this.formIsErr = false;
						try {
							const pRef = this.bindingForm.provider_ref;
							const mId = this.bindingForm.model_id.trim();
							
							const currentBindings = [...(this.cfgPayload.bindings || [])];
							const newB = {
								id: "binding_" + pRef + "_" + mId.replace(/[^a-zA-Z0-9]/g, '_').toLowerCase(),
								provider_ref: pRef,
								model_id: mId,
								enabled: true,
								priority: Number(this.bindingForm.priority) || 10,
								context_tokens: Number(this.bindingForm.context_tokens) || 8192,
								max_output_tokens: Number(this.bindingForm.max_output_tokens) || 2048,
								max_output_dialect: "max_tokens",
								limit: { max_concurrent: 1 }
							};

							const bi = currentBindings.findIndex(x => x.provider_ref === pRef && x.model_id === mId);
							if (bi >= 0) currentBindings[bi] = newB; else currentBindings.push(newB);

							const next = { providers: [...(this.cfgPayload.providers || [])], bindings: currentBindings };
							await this.createModelsDraft(next, "Adicionar preferência " + mId);
							if (window.notify) window.notify('Preferência salva!', 'success');
							this.showBindingForm = false;
						} catch (err) {
							this.formMsg = err.message;
							this.formIsErr = true;
						} finally {
							this.formSubmitting = false;
						}
					},

					async removeProvider(id) {
						if (!confirm("Remover o provedor " + id + " do catálogo?")) return;
						try {
							const nextP = (this.cfgPayload.providers || []).filter(x => x.id !== id);
							const nextB = (this.cfgPayload.bindings || []).filter(x => x.provider_ref !== id);
							await this.createModelsDraft({ providers: nextP, bindings: nextB }, "Remover provedor " + id);
							if (window.notify) window.notify('Provedor removido.', 'success');
						} catch (err) {
							if (window.notify) window.notify('Erro ao remover: ' + err.message, 'error');
						}
					},

					async removeBinding(idOrSlot) {
						if (!confirm("Remover esta regra de roteamento?")) return;
						try {
							const nextB = (this.cfgPayload.bindings || []).filter(x => x.id !== idOrSlot && x.slot !== idOrSlot);
							await this.createModelsDraft({ providers: [...(this.cfgPayload.providers || [])], bindings: nextB }, "Remover regra");
							if (window.notify) window.notify('Regra removida.', 'success');
						} catch (err) {
							if (window.notify) window.notify('Erro ao remover: ' + err.message, 'error');
						}
					},

					async createModelsDraft(modelsPayload, note) {
						const cleanedProviders = (modelsPayload.providers || []).map(p => this.cleanProvider(p));
						const cleanedBindings = (modelsPayload.bindings || []).map(b => this.cleanBinding(b));
						const payload = {
							version: modelsPayload.version || "models.v1",
							providers: cleanedProviders,
							bindings: cleanedBindings
						};
						const draftRes = await fetch('/dash/api/control/config/drafts', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								scope: 'MODELS',
								reason: note || 'Draft alterado via dashboard v2',
								based_on_revision: this.cfgActiveRevision || 0,
								models: payload
							})
						});
						const draft = await draftRes.json();
						if (!draftRes.ok) throw new Error(draft.error?.message || draft.message || 'Erro ao criar rascunho');

						const draftID = draft.draft_id || draft.id || (draft.draft && (draft.draft.draft_id || draft.draft.id));
						if (!draftID) throw new Error('ID do rascunho não retornado pela API');

						const valRes = await fetch('/dash/api/control/config/drafts/' + draftID + '/validate', { method: 'POST' });
						const val = await valRes.json();
						if (!valRes.ok) throw new Error(val.error?.message || 'Rascunho inválido');

						if (val.preview?.blocked || (val.draft && val.draft.status === "REJECTED")) {
							const notes = (val.preview?.notes || []).join('; ');
							if (notes.includes('no-op draft')) {
								if (window.notify) window.notify('Nenhuma modificação detectada. Configuração já está atualizada.', 'info');
								return; // Termina graciosamente, não foi um erro
							}
							throw new Error('Rascunho bloqueado na validação de impacto: ' + notes);
						}

						const appRes = await fetch('/dash/api/control/config/drafts/' + draftID + '/apply', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' }
						});
						const app = await appRes.json();
						if (!appRes.ok) {
							const code = app.error?.code || '';
							const msg = app.error?.message || 'Erro ao aplicar rascunho';
							if (code === 'conflict' || code === 'STALE_BASE' || msg.includes('stale config base revision')) {
								alert(`Conflito de revisão! BaseUI=${this.cfgActiveRevision} vs Erro=${msg}. Atualizando a página...`);
								window.location.reload();
								throw new Error('Conflito de revisão (STALE_BASE). Tente novamente.');
							}
							throw new Error(msg);
						}

						await this.refresh();
					},

					start() {
						this.refresh();
						setInterval(() => this.refresh(), 10000);
					}
				};
			}
		</script>
	}
}
