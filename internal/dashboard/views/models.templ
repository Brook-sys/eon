package views

templ Models() {
	@layout("Modelos & LLMs", "/dash/models", StandardNav("/dash/models")) {
		<div x-data="modelsState()" x-init="start()" class="space-y-8">
			<!-- Barra de Conexão e Ações -->
			<div class="flex flex-wrap items-center gap-4 text-sm bg-[var(--panel)] border border-[var(--border)] rounded-2xl px-5 py-4 shadow-sm">
				<span class="inline-flex items-center gap-3 font-bold">
					<span
						class="w-3 h-3 rounded-full"
						x-bind:class="connected ? 'bg-[var(--ok)] shadow-[0_0_8px_var(--ok)]' : 'bg-[var(--err)] shadow-[0_0_8px_var(--err)]'"
					></span>
					<span class="text-[var(--text)]" x-text="connected ? 'Inspect & Control API acessíveis' : 'Sem resposta das APIs'"></span>
				</span>
				<span class="text-[var(--muted)] border-l border-[var(--border)] pl-4 font-medium" x-show="observedAt">atualizado <span x-text="observedAgo"></span></span>
				<div class="ml-auto flex flex-wrap gap-3">
					<button
						type="button"
						class="px-4 py-2 rounded-xl bg-[var(--accent)] text-[#000] font-bold text-sm flex items-center gap-2 hover:opacity-90 transition-all cursor-pointer shadow-[0_0_12px_var(--accent)]/30"
						x-on:click="openAddProviderModal()"
					>
						+ Provedor
					</button>
					<button
						type="button"
						class="px-4 py-2 rounded-xl border border-[var(--border)] bg-[var(--bg)] text-[var(--text)] hover:bg-[var(--panel-hover)] transition-all font-bold text-sm cursor-pointer shadow-sm"
						x-on:click="openAddBindingModal()"
					>
						+ Binding
					</button>
					<button
						type="button"
						class="px-4 py-2 rounded-xl border border-[var(--border)] bg-[var(--bg)] text-[var(--muted)] hover:text-[var(--text)] hover:bg-[var(--panel-hover)] transition-all font-bold text-sm shadow-sm cursor-pointer"
						x-on:click="refresh()"
					>↻ Atualizar</button>
				</div>
			</div>

			<!-- Status do Cofre de Credenciais -->
			<div class="p-5 rounded-2xl bg-[var(--panel)] border border-[var(--border)] flex flex-wrap items-center justify-between text-sm gap-4 shadow-sm hover:border-[var(--border-focus)]/50 transition-all">
				<div class="flex items-center gap-4">
					<span class="font-bold text-[var(--text)]">Cofre de Credenciais Local:</span>
					<span class="font-mono px-3 py-1 rounded-md bg-[var(--bg)] border border-[var(--border)] text-[var(--muted)] font-bold text-xs shadow-inner" x-text="vaultState"></span>
				</div>
				<div class="flex items-center gap-3" x-data="{ vPass: '' }">
					<input type="password" placeholder="Senha mestra (mín. 12 chars)..." x-model="vPass" class="px-4 py-2 rounded-xl bg-[var(--bg)] border border-[var(--border)] text-[var(--text)] w-64 shadow-inner" @keyup.enter="unlockVault(vPass)"/>
					<button type="button" class="px-4 py-2 rounded-xl bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/20 hover:bg-[var(--accent)]/20 font-bold transition-all cursor-pointer shadow-sm" x-on:click="unlockVault(vPass)">Desbloquear</button>
				</div>
			</div>

			<!-- Form / Modal para Adicionar ou Editar Provedor LLM (SEM EXIGIR MODELO FIXO) -->
			<div x-show="showProviderForm" class="p-6 lg:p-8 rounded-3xl bg-[var(--panel)] border-2 border-[var(--accent)]/40 space-y-6 shadow-2xl relative" style="display:none;">
				<div class="flex justify-between items-center pb-4 border-b border-[var(--border)]">
					<h3 class="font-bold text-lg text-[var(--text)] flex items-center gap-3">
						<div class="w-2 h-6 bg-[var(--accent)] rounded-full"></div>
						<span x-text="providerFormIsEdit ? 'Editar Provedor LLM: ' + providerForm.id : 'Adicionar Novo Provedor LLM'"></span>
					</h3>
					<button type="button" class="text-sm font-bold text-[var(--muted)] hover:text-[var(--text)] px-3 py-1.5 rounded-lg hover:bg-[var(--bg)] transition-all cursor-pointer" x-on:click="showProviderForm = false">✕ Fechar</button>
				</div>
				<form x-on:submit.prevent="submitProviderForm()" class="grid gap-5 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 text-sm">
					<div>
						<label class="block text-[var(--muted)] font-bold mb-1.5 text-xs tracking-wide">ID do Provedor (Slug)</label>
						<input type="text" x-model="providerForm.id" x-bind:readonly="providerFormIsEdit" required class="w-full" placeholder="ex: groq, nvidia-nim, ollama"/>
					</div>
					<div>
						<label class="block text-[var(--muted)] font-bold mb-1.5 text-xs tracking-wide">Tipo de Provedor</label>
						<select x-model="providerForm.kind" class="w-full">
							<option value="openai_compatible">OpenAI Compatible (Groq / NIM / Ollama)</option>
						</select>
					</div>
					<div>
						<label class="block text-[var(--muted)] font-bold mb-1.5 text-xs tracking-wide">Base URL do Endpoint</label>
						<input type="url" x-model="providerForm.base_url" required class="w-full font-mono text-xs" placeholder="https://api.groq.com/openai/v1"/>
					</div>
					<div>
						<label class="block text-[var(--muted)] font-bold mb-1.5 text-xs tracking-wide">Env Var da API Key</label>
						<input type="text" x-model="providerForm.api_key_env" required class="w-full font-mono text-xs" placeholder="GROQ_API_KEY"/>
					</div>
					<div>
						<label class="block text-[var(--muted)] font-bold mb-1.5 text-xs tracking-wide">Concorrência Máx.</label>
						<input type="number" x-model.number="providerForm.max_concurrent" required min="1" max="100" class="w-full font-mono"/>
					</div>
					<div>
						<label class="block text-[var(--muted)] font-bold mb-1.5 text-xs tracking-wide">API Secret / Chave (Cofre Local)</label>
						<input type="password" x-model="providerForm.secret_value" class="w-full font-mono text-xs" placeholder="Opcional: salva diretamente no Vault"/>
					</div>
					<div class="md:col-span-3 flex items-center gap-4 pt-4 border-t border-[var(--border)] mt-2">
						<button type="submit" class="px-6 py-2.5 rounded-xl bg-[var(--accent)] text-[#000] font-bold text-sm hover:opacity-90 transition-all cursor-pointer shadow-[0_0_12px_var(--accent)]/30" x-bind:disabled="formSubmitting">
							<span x-text="providerFormIsEdit ? 'Salvar Alterações' : 'Cadastrar Provedor'"></span>
						</button>
						<button type="button" class="px-5 py-2.5 rounded-xl bg-[var(--bg)] border border-[var(--border)] text-[var(--text)] hover:bg-[var(--panel-hover)] font-bold transition-all cursor-pointer shadow-sm" x-on:click="showProviderForm = false">Cancelar</button>
						<span x-show="formMsg" class="text-sm font-mono font-bold px-4 py-2 rounded-lg bg-[var(--bg)] border border-[var(--border)]" x-bind:class="formIsErr ? 'text-[var(--err)]' : 'text-[var(--ok)]'" x-text="formMsg"></span>
					</div>
				</form>
			</div>

			<!-- Form / Modal para Adicionar Preferência de Modelo (Binding Opcional) -->
			<div x-show="showBindingForm" class="p-6 lg:p-8 rounded-3xl bg-[var(--panel)] border-2 border-[var(--accent)]/40 space-y-6 shadow-2xl relative" style="display:none;">
				<div class="flex justify-between items-center pb-4 border-b border-[var(--border)]">
					<h3 class="font-bold text-lg text-[var(--text)] flex items-center gap-3">
						<div class="w-2 h-6 bg-[var(--accent)] rounded-full"></div>
						Adicionar Preferência de Modelo (Binding)
					</h3>
					<button type="button" class="text-sm font-bold text-[var(--muted)] hover:text-[var(--text)] px-3 py-1.5 rounded-lg hover:bg-[var(--bg)] transition-all cursor-pointer" x-on:click="showBindingForm = false">✕ Fechar</button>
				</div>
				<form x-on:submit.prevent="submitBindingForm()" class="grid gap-5 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 text-sm">
					<div>
						<label class="block text-[var(--muted)] font-bold mb-1.5 text-xs tracking-wide">Provedor de Origem</label>
						<select x-model="bindingForm.provider_ref" required class="w-full">
							<template x-for="p in (cfgPayload.providers || [])" x-bind:key="p.id">
								<option x-bind:value="p.id" x-text="p.id + ' (' + p.base_url + ')'"></option>
							</template>
						</select>
					</div>
					<div>
						<label class="block text-[var(--muted)] font-bold mb-1.5 text-xs tracking-wide">ID do Modelo</label>
						<input type="text" x-model="bindingForm.model_id" required class="w-full font-mono text-xs" placeholder="ex: llama-3.3-70b-versatile"/>
					</div>
					<div>
						<label class="block text-[var(--muted)] font-bold mb-1.5 text-xs tracking-wide">Janela de Contexto (tokens)</label>
						<input type="number" x-model.number="bindingForm.context_tokens" required min="1024" class="w-full font-mono"/>
					</div>
					<div>
						<label class="block text-[var(--muted)] font-bold mb-1.5 text-xs tracking-wide">Máx. Output Tokens</label>
						<input type="number" x-model.number="bindingForm.max_output_tokens" required min="256" class="w-full font-mono"/>
					</div>
					<div>
						<label class="block text-[var(--muted)] font-bold mb-1.5 text-xs tracking-wide">Prioridade do Binding</label>
						<input type="number" x-model.number="bindingForm.priority" required min="1" max="100" class="w-full font-mono"/>
					</div>
					<div class="md:col-span-3 flex items-center gap-4 pt-4 border-t border-[var(--border)] mt-2">
						<button type="submit" class="px-6 py-2.5 rounded-xl bg-[var(--accent)] text-[#000] font-bold text-sm hover:opacity-90 transition-all cursor-pointer shadow-[0_0_12px_var(--accent)]/30" x-bind:disabled="formSubmitting">
							Salvar Preferência
						</button>
						<button type="button" class="px-5 py-2.5 rounded-xl bg-[var(--bg)] border border-[var(--border)] text-[var(--text)] hover:bg-[var(--panel-hover)] font-bold transition-all cursor-pointer shadow-sm" x-on:click="showBindingForm = false">Cancelar</button>
						<span x-show="formMsg" class="text-sm font-mono font-bold px-4 py-2 rounded-lg bg-[var(--bg)] border border-[var(--border)]" x-bind:class="formIsErr ? 'text-[var(--err)]' : 'text-[var(--ok)]'" x-text="formMsg"></span>
					</div>
				</form>
			</div>

			<!-- Gestão de Provedores LLM Configurados -->
			@card("Provedores LLM Registrados") {
				<template x-if="!cfgPayload || (cfgPayload.providers ?? []).length === 0">
					@EmptyState("Nenhum provedor configurado no catálogo ativo.")
				</template>
				<div class="grid gap-4 grid-cols-1 xl:grid-cols-2" x-show="cfgPayload && (cfgPayload.providers ?? []).length > 0">
					<template x-for="p in cfgPayload.providers" x-bind:key="p.id">
						<div class="p-5 rounded-2xl bg-[var(--bg)] border border-[var(--border)] shadow-sm hover:border-[var(--border-focus)]/30 transition-all space-y-4">
							<div class="flex flex-wrap items-start justify-between gap-3 border-b border-[var(--border)] pb-4">
								<div>
									<div class="font-bold text-lg text-[var(--text)] font-mono" x-text="p.id"></div>
									<div class="text-xs text-[var(--subtle)] font-mono mt-1" x-text="p.kind + ' · ' + p.base_url"></div>
								</div>
								<div class="flex items-center gap-2">
									<button
										type="button"
										class="px-3 py-1.5 rounded-lg text-xs font-bold bg-[var(--bg)] border border-[var(--border)] text-[var(--muted)] hover:text-[var(--text)] hover:bg-[var(--panel-hover)] transition-all cursor-pointer shadow-sm"
										x-on:click="editProvider(p.id)"
									>
										✏ Editar
									</button>
									<button
										type="button"
										class="px-3 py-1.5 rounded-lg text-xs font-bold bg-[var(--err)]/10 border border-[var(--err)]/20 text-[var(--err)] hover:bg-[var(--err)]/20 transition-all cursor-pointer shadow-sm"
										x-on:click="removeProvider(p.id)"
									>
										🗑 Remover
									</button>
								</div>
							</div>
							<div class="flex items-center gap-4">
								<button
									type="button"
									class="px-4 py-2 rounded-xl text-xs font-bold text-[var(--accent)] bg-[var(--accent)]/10 border border-[var(--accent)]/20 hover:bg-[var(--accent)]/20 transition-all cursor-pointer shadow-sm w-full text-center"
									x-on:click="discoverModelsForProvider(p.id)"
								>
									🔍 Descobrir Modelos via API
								</button>
							</div>
							<div class="grid gap-3 grid-cols-3 text-xs font-mono text-[var(--muted)] bg-[var(--panel)] p-3 rounded-xl border border-[var(--border)] shadow-inner">
								<div>API Key Env:<br/><strong class="text-[var(--text)] text-[10px] bg-[var(--bg)] px-1 py-0.5 rounded mt-1 inline-block" x-text="p.api_key_env || 'N/A'"></strong></div>
								<div>Concorrência:<br/><strong class="text-[var(--text)] text-[13px] inline-block mt-0.5" x-text="(p.global_limit && p.global_limit.max_concurrent) || 1"></strong></div>
								<div>Bindings:<br/><strong class="text-[var(--accent)] text-[13px] inline-block mt-0.5" x-text="(cfgPayload.bindings || []).filter(b => b.provider_ref === p.id).length"></strong></div>
							</div>
						</div>
					</template>
				</div>
			}

			<!-- Modelos Descobertos Dinamicamente via API OpenAI -->
			@card("Modelos Descobertos Dinamicamente via API OpenAI") {
				<div class="space-y-4">
					<div class="flex flex-wrap items-center justify-between text-sm gap-4 bg-[var(--bg)] p-4 rounded-xl border border-[var(--border)] shadow-sm">
						<span class="text-[var(--text)] font-medium" x-text="discoveredModelsNote || 'Modelos obtidos dinamicamente da API OpenAI do provedor ativo.'"></span>
						<button
							type="button"
							class="px-4 py-2 rounded-xl bg-[var(--accent)] text-[#000] font-bold text-sm transition-all cursor-pointer shadow-[0_0_12px_var(--accent)]/30 hover:opacity-90 shrink-0"
							x-on:click="discoverModels()"
						>
							🔄 Buscar Modelos
						</button>
					</div>
					<template x-if="discoveredModels.length === 0">
						<div class="p-6 text-center text-sm text-[var(--muted)] font-medium bg-[var(--bg)]/50 rounded-xl border border-dashed border-[var(--border)]">
							Nenhum modelo retornado pela API OpenAI até o momento (clique no botão para buscar).
						</div>
					</template>
					<div class="flex flex-wrap gap-3 pt-2" x-show="discoveredModels.length > 0">
						<template x-for="m in discoveredModels" x-bind:key="m">
							<div class="inline-flex items-center justify-between gap-3 px-4 py-2 rounded-xl bg-[var(--bg)] border border-[var(--border)] text-sm font-mono shadow-sm hover:border-[var(--accent)]/40 transition-colors group">
								<span class="font-bold text-[var(--text)] group-hover:text-[var(--accent)] transition-colors" x-text="m"></span>
								<button
									type="button"
									class="text-[11px] font-bold text-[var(--muted)] bg-[var(--panel-sub)] hover:bg-[var(--accent)] hover:text-[#000] px-2 py-1 rounded-md transition-all cursor-pointer"
									x-on:click="addBindingFromDiscovered(m)"
								>
									+ Preferência
								</button>
							</div>
						</template>
					</div>
				</div>
			}

			<!-- Preferências de Modelo / Bindings Registradas (Opcional) -->
			@card("Preferências de Modelo / Bindings (Opcional)") {
				<p class="text-sm text-[var(--muted)] mb-4 font-medium" x-show="note" x-text="note"></p>
				<div class="overflow-x-auto rounded-xl border border-[var(--border)] shadow-sm">
					<table class="w-full text-left border-collapse text-sm bg-[var(--bg)]">
						<thead>
							<tr class="border-b border-[var(--border)] text-[var(--muted)] font-mono text-xs uppercase tracking-wider bg-[var(--panel)]">
								<th class="py-3 px-4 font-bold">Slot / Role</th>
								<th class="py-3 px-4 font-bold">Modelo</th>
								<th class="py-3 px-4 font-bold">Provedor</th>
								<th class="py-3 px-4 font-bold">Concorrência</th>
								<th class="py-3 px-4 font-bold">Contexto</th>
								<th class="py-3 px-4 font-bold">Max Output</th>
								<th class="py-3 px-4 font-bold">Prioridade</th>
								<th class="py-3 px-4 font-bold text-right">Ação</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-[var(--border)] font-mono text-[13px]">
							<template x-if="bindings.length === 0">
								<tr><td colspan="8" class="py-8 text-center text-[var(--muted)] font-medium">Nenhuma preferência explícita de modelo cadastrada (o sistema usa descoberta dinâmica).</td></tr>
							</template>
							<template x-for="b in bindings" x-bind:key="b.slot ?? b.role ?? Math.random()">
								<tr class="hover:bg-[var(--panel-hover)]/30 transition-colors">
									<td class="py-3 px-4 font-bold text-[var(--text)]" x-text="b.slot ?? b.role ?? '–'"></td>
									<td class="py-3 px-4 text-[var(--accent)] font-bold" x-text="b.model_id ?? b.model ?? '–'"></td>
									<td class="py-3 px-4 text-[var(--muted)] font-medium" x-text="b.provider ?? '–'"></td>
									<td class="py-3 px-4 text-[var(--text)] font-bold" x-text="b.max_concurrent ?? '–'"></td>
									<td class="py-3 px-4 text-[var(--muted)]" x-text="b.context_tokens ? (b.context_tokens + ' tks') : '–'"></td>
									<td class="py-3 px-4 text-[var(--muted)]" x-text="b.max_output_tokens ? (b.max_output_tokens + ' tks') : '–'"></td>
									<td class="py-3 px-4 text-[var(--text)] font-bold" x-text="b.priority ?? '–'"></td>
									<td class="py-3 px-4 text-right">
										<button
											type="button"
											class="text-xs font-bold text-[var(--err)] bg-[var(--err)]/10 hover:bg-[var(--err)]/20 px-3 py-1.5 rounded-lg transition-all cursor-pointer"
											x-on:click="removeBinding(b.id ?? b.slot)"
										>Remover</button>
									</td>
								</tr>
							</template>
						</tbody>
					</table>
				</div>
			}

			<!-- Pressões de Contexto -->
			@card("Pressão de Contexto dos Modelos") {
				<p class="text-sm text-[var(--muted)] mb-4 font-medium" x-show="pressureNote" x-text="pressureNote"></p>
				<div class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
					<template x-if="pressures.length === 0">
						<div class="col-span-full p-6 text-center text-sm text-[var(--muted)] font-medium bg-[var(--bg)]/50 rounded-xl border border-dashed border-[var(--border)]">
							Nenhum dado de pressão de contexto disponível.
						</div>
					</template>
					<template x-for="p in pressures" x-bind:key="p.model_id ?? Math.random()">
						<div class="p-5 rounded-2xl bg-[var(--bg)] border border-[var(--border)] shadow-sm space-y-4 hover:border-[var(--border-focus)]/30 transition-colors">
							<div class="flex justify-between items-center text-sm font-mono">
								<span class="font-bold text-[var(--text)] truncate mr-2" x-text="p.model_id ?? '–'"></span>
								<span
									class="px-2 py-1 rounded-md text-xs font-bold tracking-widest"
									x-bind:class="(p.ratio ?? 0) > 0.8 ? 'bg-[var(--err)]/20 text-[var(--err)]' : 'bg-[var(--ok)]/20 text-[var(--ok)]'"
									x-text="((p.ratio ?? 0) * 100).toFixed(1) + '%'"
								></span>
							</div>
							<div class="w-full bg-[var(--panel)] rounded-full h-2.5 overflow-hidden border border-[var(--border)]">
								<div
									class="h-full rounded-full transition-all duration-500 ease-out"
									x-bind:class="(p.ratio ?? 0) > 0.8 ? 'bg-[var(--err)] shadow-[0_0_8px_var(--err)]' : 'bg-[var(--ok)] shadow-[0_0_8px_var(--ok)]'"
									x-bind:style="'width: ' + Math.min(100, Math.max(0, (p.ratio ?? 0) * 100)) + '%'"
								></div>
							</div>
							<div class="flex justify-between text-xs text-[var(--muted)] font-mono font-medium">
								<span>Usado: <strong class="text-[var(--text)]" x-text="p.used_tokens ?? 0"></strong></span>
								<span>Limite: <strong class="text-[var(--text)]" x-text="p.limit_tokens ?? 0"></strong></span>
							</div>
						</div>
					</template>
				</div>
			}
		</div>

		<script>
			function modelsState() {
				return {
					connected: false,
					observedAt: null,
					bindings: [],
					note: '',
					pressures: [],
					pressureNote: '',
					// Estado de Configuração de Modelos (Control API)
					cfgActiveRevision: 0,
					cfgPayload: { providers: [], bindings: [] },
					vaultState: 'Desconhecido',

					// Descoberta Dinâmica de Modelos
					discoveredModels: [],
					discoveredModelsNote: '',

					// Form de Provedor (sem modelo fixo)
					showProviderForm: false,
					providerFormIsEdit: false,
					providerForm: {
						id: '',
						kind: 'openai_compatible',
						base_url: 'https://api.groq.com/openai/v1',
						api_key_env: 'GROQ_API_KEY',
						max_concurrent: 2,
						secret_value: ''
					},

					// Form de Binding / Preferência de Modelo (Opcional)
					showBindingForm: false,
					bindingForm: {
						provider_ref: '',
						model_id: '',
						context_tokens: 131072,
						max_output_tokens: 8192,
						priority: 10
					},

					formSubmitting: false,
					formMsg: '',
					formIsErr: false,

					get observedAgo() {
						if (!this.observedAt) return '';
						const s = Math.max(0, (Date.now() - this.observedAt) / 1000 | 0);
						return s < 60 ? `${s}s atrás` : `${s/60|0}min atrás`;
					},

					async refresh() {
						try {
							const [b, p, activeRev] = await Promise.all([
								fetch('/dash/api/model-bindings').then(r => r.json()),
								fetch('/dash/api/model-context-pressures').then(r => r.json()),
								fetch('/dash/api/control/config/revisions/active?scope=MODELS').then(r => r.json()).catch(() => ({}))
							]);
							this.bindings = b?.bindings ?? [];
							this.note = b?.note ?? '';
							this.pressures = p?.pressures ?? [];
							this.pressureNote = p?.note ?? '';

							const rev = activeRev?.revision || activeRev;
							if (rev) {
								this.cfgActiveRevision = Number(rev.revision || 0);
								this.cfgPayload = rev.models || { providers: [], bindings: [] };
								if (!Array.isArray(this.cfgPayload.providers)) this.cfgPayload.providers = [];
								if (!Array.isArray(this.cfgPayload.bindings)) this.cfgPayload.bindings = [];
							}

							await this.refreshVaultStatus();
							this.observedAt = Date.now();
							this.connected = true;
						} catch (e) { this.connected = false; }
					},

					async discoverModels() {
						try {
							this.discoveredModelsNote = 'Buscando modelos dinâmicos da API OpenAI...';
							const res = await fetch('/dash/api/provider/models');
							const data = await res.json();
							if (data && data.models && Array.isArray(data.models)) {
								this.discoveredModels = data.models;
								this.discoveredModelsNote = `${data.models.length} modelos dinâmicos retornados pela API OpenAI`;
								if (window.notify) window.notify(`${data.models.length} modelos descobertos da API OpenAI!`, 'success');
							} else {
								this.discoveredModelsNote = data.note || 'Nenhum modelo retornado no momento.';
							}
						} catch (err) {
							this.discoveredModelsNote = 'Erro na descoberta: ' + err.message;
						}
					},

					async discoverModelsForProvider(pId) {
						await this.discoverModels();
					},

					async refreshVaultStatus() {
						try {
							const res = await fetch('/dash/api/vault/status');
							const s = await res.json();
							if (!s.initialized) this.vaultState = 'Não inicializado';
							else if (s.locked) this.vaultState = 'Bloqueado';
							else this.vaultState = 'Desbloqueado (' + (s.secrets || []).length + ' credenciais)';
						} catch (err) {
							this.vaultState = 'Indisponível';
						}
					},

					async unlockVault(pass) {
						if (!pass) return;
						try {
							const statusRes = await fetch('/dash/api/vault/status');
							const s = await statusRes.json();
							const endpoint = s.initialized ? '/dash/api/vault/unlock' : '/dash/api/vault/initialize';
							const res = await fetch(endpoint, {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({ password: pass })
							});
							if (!res.ok) {
								let errMsg = 'Falha ao desbloquear';
								try { const errBody = await res.json(); errMsg = errBody?.error?.message || errMsg; } catch (_) {}
								throw new Error(errMsg);
							}
							await this.refreshVaultStatus();
							if (window.notify) window.notify('Cofre de credenciais desbloqueado!', 'success');
						} catch (err) {
							if (window.notify) window.notify('Erro no cofre: ' + err.message, 'error');
						}
					},

					openAddProviderModal() {
						this.providerFormIsEdit = false;
						this.providerForm = {
							id: '',
							kind: 'openai_compatible',
							base_url: 'https://api.groq.com/openai/v1',
							api_key_env: 'GROQ_API_KEY',
							max_concurrent: 2,
							secret_value: ''
						};
						this.formMsg = '';
						this.showProviderForm = true;
						window.scrollTo({ top: 0, behavior: 'smooth' });
					},

					openAddBindingModal() {
						const firstP = (this.cfgPayload.providers || [])[0];
						this.bindingForm = {
							provider_ref: firstP ? firstP.id : '',
							model_id: '',
							context_tokens: 131072,
							max_output_tokens: 8192,
							priority: 10
						};
						this.formMsg = '';
						this.showBindingForm = true;
						window.scrollTo({ top: 0, behavior: 'smooth' });
					},

					addBindingFromDiscovered(modelId) {
						const firstP = (this.cfgPayload.providers || [])[0];
						this.bindingForm = {
							provider_ref: firstP ? firstP.id : '',
							model_id: modelId,
							context_tokens: 131072,
							max_output_tokens: 8192,
							priority: 10
						};
						this.showBindingForm = true;
						window.scrollTo({ top: 0, behavior: 'smooth' });
					},

					editProvider(id) {
						const p = (this.cfgPayload.providers || []).find(x => x.id === id);
						if (!p) return;
						this.providerFormIsEdit = true;
						this.providerForm = {
							id: p.id,
							kind: p.kind || 'openai_compatible',
							base_url: p.base_url || '',
							max_concurrent: (p.global_limit && p.global_limit.max_concurrent) || 1,
							api_key_env: p.api_key_env || 'GROQ_API_KEY',
							secret_value: ''
						};
						this.formMsg = '';
						this.showProviderForm = true;
						window.scrollTo({ top: 0, behavior: 'smooth' });
					},

					cleanProvider(p) {
						const pId = (p.id || '').trim();
						return {
							id: pId,
							kind: p.kind || 'openai_compatible',
							base_url: (p.base_url || '').trim(),
							api_key_env: (p.api_key_env || 'GROQ_API_KEY').trim(),
							timeout: Number(p.timeout) || 90000000000,
							max_response_bytes: Number(p.max_response_bytes) || 10485760,
							global_limit: {
								resource: "model-provider:" + pId,
								max_concurrent: Number(p.global_limit?.max_concurrent) || 2,
								cooldown_base: Number(p.global_limit?.cooldown_base) || 30000000000,
								cooldown_max: Number(p.global_limit?.cooldown_max) || 300000000000
							}
						};
					},

					cleanBinding(b) {
						const bId = (b.id || ("binding_" + (b.provider_ref || '') + "_" + (b.model_id || '').replace(/[^a-zA-Z0-9]/g, '_'))).toLowerCase();
						return {
							id: bId,
							provider_ref: (b.provider_ref || '').trim(),
							model_id: (b.model_id || '').trim(),
							enabled: b.enabled !== undefined ? Boolean(b.enabled) : true,
							priority: Number(b.priority) || 10,
							context_tokens: Number(b.context_tokens) || 8192,
							max_output_tokens: Number(b.max_output_tokens) || 2048,
							max_output_dialect: b.max_output_dialect || "max_tokens",
							limit: {
								resource: "model-binding:" + bId,
								max_concurrent: Number(b.limit?.max_concurrent) || 1
							}
						};
					},

					async saveSecretIfProvided(apiKeyEnv, secret) {
						if (!secret) return;
						const res = await fetch('/dash/api/vault/secrets/' + encodeURIComponent(apiKeyEnv), {
							method: 'PUT',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ value: secret })
						});
						if (!res.ok) {
							let msg = 'Falha ao salvar credencial';
							try { const e = await res.json(); msg = e?.error?.message || msg; } catch (_) {}
							throw new Error(msg);
						}
					},

					async submitProviderForm() {
						this.formSubmitting = true;
						this.formMsg = 'Salvando provedor...';
						this.formIsErr = false;
						try {
							const id = this.providerForm.id.trim();
							if (!id) throw new Error("ID do provedor é obrigatório.");

							if (this.providerForm.secret_value) {
								await this.saveSecretIfProvided(this.providerForm.api_key_env.trim(), this.providerForm.secret_value);
							}

							const currentProviders = [...(this.cfgPayload.providers || [])];
							const newP = {
								id: id,
								kind: this.providerForm.kind,
								base_url: this.providerForm.base_url.trim(),
								api_key_env: this.providerForm.api_key_env.trim(),
								timeout: 90000000000,
								max_response_bytes: 10485760,
								global_limit: {
									resource: "model-provider:" + id,
									max_concurrent: Number(this.providerForm.max_concurrent) || 2,
									cooldown_base: 30000000000,
									cooldown_max: 300000000000
								}
							};

							const pi = currentProviders.findIndex(x => x.id === id);
							if (pi >= 0) currentProviders[pi] = newP; else currentProviders.push(newP);

							const next = { providers: currentProviders, bindings: [...(this.cfgPayload.bindings || [])] };
							await this.createModelsDraft(next, (pi >= 0 ? "Atualizar provedor " : "Adicionar provedor ") + id);
							if (window.notify) window.notify('Provedor ' + id + ' salvo com sucesso!', 'success');
							this.showProviderForm = false;
						} catch (err) {
							this.formMsg = 'Erro: ' + err.message;
							this.formIsErr = true;
							if (window.notify) window.notify('Erro ao salvar provedor: ' + err.message, 'error');
						} finally {
							this.formSubmitting = false;
						}
					},

					async submitBindingForm() {
						this.formSubmitting = true;
						this.formMsg = 'Salvando preferência de modelo...';
						this.formIsErr = false;
						try {
							const pRef = this.bindingForm.provider_ref;
							const mId = this.bindingForm.model_id.trim();
							
							const currentBindings = [...(this.cfgPayload.bindings || [])];
							const newB = {
								id: "binding_" + pRef + "_" + mId.replace(/[^a-zA-Z0-9]/g, '_').toLowerCase(),
								provider_ref: pRef,
								model_id: mId,
								enabled: true,
								priority: Number(this.bindingForm.priority) || 10,
								context_tokens: Number(this.bindingForm.context_tokens) || 8192,
								max_output_tokens: Number(this.bindingForm.max_output_tokens) || 2048,
								max_output_dialect: "max_tokens",
								limit: { max_concurrent: 1 }
							};

							const bi = currentBindings.findIndex(x => x.provider_ref === pRef && x.model_id === mId);
							if (bi >= 0) currentBindings[bi] = newB; else currentBindings.push(newB);

							const next = { providers: [...(this.cfgPayload.providers || [])], bindings: currentBindings };
							await this.createModelsDraft(next, "Adicionar preferência de modelo " + mId);
							if (window.notify) window.notify('Preferência de modelo ' + mId + ' salva!', 'success');
							this.showBindingForm = false;
						} catch (err) {
							this.formMsg = 'Erro: ' + err.message;
							this.formIsErr = true;
							if (window.notify) window.notify('Erro ao salvar binding: ' + err.message, 'error');
						} finally {
							this.formSubmitting = false;
						}
					},

					async removeProvider(id) {
						if (!confirm("Remover o provedor " + id + " do catálogo de provedores?")) return;
						try {
							const nextP = (this.cfgPayload.providers || []).filter(x => x.id !== id);
							const nextB = (this.cfgPayload.bindings || []).filter(x => x.provider_ref !== id);
							await this.createModelsDraft({ providers: nextP, bindings: nextB }, "Remover provedor " + id);
							if (window.notify) window.notify('Provedor ' + id + ' removido.', 'success');
						} catch (err) {
							if (window.notify) window.notify('Erro ao remover provedor: ' + err.message, 'error');
						}
					},

					async removeBinding(idOrSlot) {
						if (!confirm("Remover esta preferência de modelo?")) return;
						try {
							const nextB = (this.cfgPayload.bindings || []).filter(x => x.id !== idOrSlot && x.slot !== idOrSlot);
							await this.createModelsDraft({ providers: [...(this.cfgPayload.providers || [])], bindings: nextB }, "Remover preferência de modelo");
							if (window.notify) window.notify('Preferência de modelo removida.', 'success');
						} catch (err) {
							if (window.notify) window.notify('Erro ao remover preferência: ' + err.message, 'error');
						}
					},

					async createModelsDraft(modelsPayload, note) {
						const cleanedProviders = (modelsPayload.providers || []).map(p => this.cleanProvider(p));
						const cleanedBindings = (modelsPayload.bindings || []).map(b => this.cleanBinding(b));
						const payload = {
							version: modelsPayload.version || "models.v1",
							providers: cleanedProviders,
							bindings: cleanedBindings
						};
						const draftRes = await fetch('/dash/api/control/config/drafts', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								scope: 'MODELS',
								reason: note || 'Draft alterado via dashboard v2',
								based_on_revision: this.cfgActiveRevision || 0,
								models: payload
							})
						});
						const draft = await draftRes.json();
						if (!draftRes.ok) throw new Error(draft.error?.message || draft.message || 'Erro ao criar rascunho');

						const draftID = draft.draft_id || draft.id || (draft.draft && (draft.draft.draft_id || draft.draft.id));
						if (!draftID) throw new Error('ID do rascunho não retornado pela API');

						const valRes = await fetch('/dash/api/control/config/drafts/' + draftID + '/validate', { method: 'POST' });
						const val = await valRes.json();
						if (!valRes.ok) throw new Error(val.error?.message || 'Rascunho inválido');

						const appRes = await fetch('/dash/api/control/config/drafts/' + draftID + '/apply', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' }
						});
						const app = await appRes.json();
						if (!appRes.ok) {
							const code = app.error?.code || '';
							const msg = app.error?.message || 'Erro ao aplicar rascunho';
							if (code === 'conflict') throw new Error('Conflito: a configuração foi alterada por outra operação. Atualizando...');
							throw new Error(msg);
						}

						await this.refresh();
					},

					start() {
						this.refresh();
						setInterval(() => this.refresh(), 10000);
					}
				};
			}
		</script>
	}
}
