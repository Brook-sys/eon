package views

import "fmt"

// StatCard exibe uma métrica KPI destacada com suporte a valor, subtítulo e tom semântico.
templ StatCard(label string, value string, sub string, tone string) {
	<div class="bg-[var(--panel)] border border-[var(--border)] rounded-xl p-5 flex flex-col justify-between shadow-sm transition-all hover:border-[var(--border-focus)]/40">
		<div class="text-[11px] uppercase tracking-wider text-[var(--muted)] font-semibold mb-1.5">{ label }</div>
		<div class="text-2xl lg:text-3xl font-bold font-mono tracking-tight my-1" style={ fmt.Sprintf("color:%s", tone) }>
			{ value }
		</div>
		if sub != "" {
			<div class="text-xs text-[var(--muted)] flex items-center gap-1 mt-1 pt-1.5 border-t border-[var(--border-subtle)]">{ sub }</div>
		}
	</div>
}

// StatusDot exibe um ponto indicador de estado com animação de pulso (verde=ok, vermelho=erro).
templ StatusDot(ok bool, label string) {
	<div class="inline-flex items-center gap-2.5 text-xs font-mono">
		if ok {
			<span class="relative flex h-2.5 w-2.5">
				<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--ok)] opacity-75"></span>
				<span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[var(--ok)]"></span>
			</span>
			<span class="text-[var(--text)] font-medium">{ label }</span>
		} else {
			<span class="w-2.5 h-2.5 rounded-full bg-[var(--err)]"></span>
			<span class="text-[var(--err)] font-medium">{ label }</span>
		}
	</div>
}

// Badge exibe uma pílula semântica com suporte a vários tipos (success, warning, error, info, neutral).
templ Badge(label string, kind string) {
	<span class={
		"inline-flex items-center px-3 py-1 rounded-full text-xs font-mono font-medium tracking-tight border",
		templ.KV("bg-[var(--ok)]/10 text-[var(--ok)] border-[var(--ok)]/30", kind == "success" || kind == "ok"),
		templ.KV("bg-[var(--warn)]/10 text-[var(--warn)] border-[var(--warn)]/30", kind == "warning" || kind == "warn"),
		templ.KV("bg-[var(--err)]/10 text-[var(--err)] border-[var(--err)]/30", kind == "error" || kind == "err" || kind == "critical"),
		templ.KV("bg-[var(--accent)]/10 text-[var(--accent)] border-[var(--accent)]/30", kind == "info" || kind == "accent"),
		templ.KV("bg-white/[0.04] text-[var(--muted)] border-[var(--border)]", kind == "neutral" || kind == ""),
	}>
		{ label }
	</span>
}

// Card exibe um conteiner padrão de seção com borda sutil, padding generoso e título estilizado.
templ Card(title string) {
	<section class="bg-[var(--panel)] border border-[var(--border)] rounded-xl p-6 mb-6 shadow-sm space-y-4">
		if title != "" {
			<h3 class="text-[var(--muted)] text-[11px] font-bold uppercase tracking-wider pb-3 border-b border-[var(--border-subtle)] mb-2">{ title }</h3>
		}
		<div>
			{ children... }
		</div>
	</section>
}

// AlertBanner exibe uma caixa de aviso ou erro em destaque no topo da página.
templ AlertBanner(title string, msg string, kind string) {
	<div class={
		"p-4.5 rounded-xl border text-xs flex items-start gap-3.5 shadow-lg transition-all mb-5",
		templ.KV("bg-[var(--err)]/10 border-[var(--err)]/40 text-[var(--err)]", kind == "error" || kind == "err"),
		templ.KV("bg-[var(--warn)]/10 border-[var(--warn)]/40 text-[var(--warn)]", kind == "warning" || kind == "warn"),
		templ.KV("bg-[var(--ok)]/10 border-[var(--ok)]/40 text-[var(--ok)]", kind == "success" || kind == "ok"),
		templ.KV("bg-[var(--accent)]/10 border-[var(--accent)]/40 text-[var(--accent)]", kind == "info" || kind == "accent"),
	}>
		<div class="shrink-0 font-bold text-base mt-0.5">
			if kind == "error" || kind == "err" {
				⚠
			} else if kind == "warning" || kind == "warn" {
				⚡
			} else if kind == "success" || kind == "ok" {
				✓
			} else {
				ℹ
			}
		</div>
		<div class="space-y-1 grow">
			if title != "" {
				<div class="font-bold text-xs tracking-tight">{ title }</div>
			}
			<div class="font-mono text-xs opacity-90 leading-relaxed">{ msg }</div>
		</div>
	</div>
}

// EmptyState exibe uma mensagem de estado vazio padronizada para tabelas ou listas sem dados.
templ EmptyState(msg string) {
	<div class="p-10 text-center border border-dashed border-[var(--border)] rounded-xl bg-[var(--panel-sub)]/40 space-y-2.5">
		<div class="text-2xl opacity-40">📭</div>
		<div class="text-xs text-[var(--muted)] font-mono leading-relaxed max-w-md mx-auto">{ msg }</div>
	</div>
}

// Kbd renderiza uma tecla de atalho estilizada no padrão visual do Design System.
templ Kbd(key string) {
	<kbd class="px-2 py-0.5 rounded bg-[var(--panel-sub)] border border-[var(--border)] text-[10px] font-mono font-semibold text-[var(--text)] shadow-xs">
		{ key }
	</kbd>
}

// LoadingSkeleton exibe linhas de carregamento simuladas (shimmer).
templ LoadingSkeleton(rows int) {
	<div class="space-y-3 animate-pulse p-2">
		for i := 0; i < rows; i++ {
			<div class="h-5 bg-white/[0.04] rounded-lg w-full"></div>
		}
	</div>
}

// CopyButton exibe um botão de cópia de texto com feedback via Toast.
templ CopyButton(textToCopy string) {
	<button
		type="button"
		class="px-2.5 py-1 rounded-lg bg-[var(--panel-sub)] hover:bg-white/[0.08] border border-[var(--border)] text-[11px] font-mono text-[var(--muted)] hover:text-[var(--text)] transition-all cursor-pointer inline-flex items-center gap-1.5 shadow-xs"
		x-on:click={ fmt.Sprintf("navigator.clipboard.writeText('%s'); if(window.notify) window.notify('Copiado para a área de transferência!', 'info')", textToCopy) }
		title="Copiar para área de transferência"
	>
		📋 Copiar
	</button>
}

// Pager exibe os controles de paginação de dados com espaçamento e padding refinados.
templ Pager(prefix string, current int, total int, hasPrev bool, hasNext bool) {
	<div class="flex items-center justify-between mt-6 text-xs font-mono text-[var(--muted)] pt-4 border-t border-[var(--border)]">
		<div>
			Página <strong class="text-[var(--text)]">{ fmt.Sprintf("%d", current) }</strong>
			if total > 0 {
				de <strong class="text-[var(--text)]">{ fmt.Sprintf("%d", total) }</strong>
			}
		</div>
		<div class="flex items-center gap-2.5">
			if hasPrev {
				<button class="px-3.5 py-2 bg-[var(--panel-sub)] hover:bg-[var(--panel-hover)] text-[var(--text)] rounded-lg border border-[var(--border)] transition-all cursor-pointer">
					&larr; Anterior
				</button>
			} else {
				<button disabled class="px-3.5 py-2 bg-[var(--panel)] text-[var(--muted)] opacity-40 rounded-lg border border-[var(--border)] cursor-not-allowed">
					&larr; Anterior
				</button>
			}
			if hasNext {
				<button class="px-3.5 py-2 bg-[var(--panel-sub)] hover:bg-[var(--panel-hover)] text-[var(--text)] rounded-lg border border-[var(--border)] transition-all cursor-pointer">
					Próxima &rarr;
				</button>
			} else {
				<button disabled class="px-3.5 py-2 bg-[var(--panel)] text-[var(--muted)] opacity-40 rounded-lg border border-[var(--border)] cursor-not-allowed">
					Próxima &rarr;
				</button>
			}
		</div>
	</div>
}
