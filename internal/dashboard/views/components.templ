package views

import "fmt"

// StatCard exibe uma métrica KPI destacada com suporte a valor, subtítulo e tom semântico.
templ StatCard(label string, value string, sub string, tone string) {
	<div class="bg-[var(--panel)] border border-[var(--border)] rounded-2xl p-6 flex flex-col justify-between shadow-sm hover:shadow-md transition-all hover:border-[var(--border-focus)]/50 group">
		<div class="text-xs uppercase tracking-widest text-[var(--muted)] font-bold mb-2 group-hover:text-[var(--text)] transition-colors">{ label }</div>
		<div class="text-3xl lg:text-4xl font-bold font-mono tracking-tight my-2" style={ fmt.Sprintf("color:%s", tone) }>
			{ value }
		</div>
		if sub != "" {
			<div class="text-xs text-[var(--subtle)] mt-2 font-medium">{ sub }</div>
		}
	</div>
}

// StatusDot exibe um ponto indicador de estado com animação de pulso (verde=ok, vermelho=erro).
templ StatusDot(ok bool, label string) {
	<div class="inline-flex items-center gap-2.5 text-sm font-mono">
		if ok {
			<span class="relative flex h-3 w-3">
				<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--ok)] opacity-75"></span>
				<span class="relative inline-flex rounded-full h-3 w-3 bg-[var(--ok)] shadow-[0_0_8px_var(--ok)]"></span>
			</span>
			<span class="text-[var(--text)] font-medium">{ label }</span>
		} else {
			<span class="w-3 h-3 rounded-full bg-[var(--err)] shadow-[0_0_8px_var(--err)]"></span>
			<span class="text-[var(--err)] font-medium">{ label }</span>
		}
	</div>
}

// Badge exibe uma pílula semântica com suporte a vários tipos (success, warning, error, info, neutral).
templ Badge(label string, kind string) {
	<span class={
		"inline-flex items-center px-3 py-1 rounded-full text-xs font-mono font-bold tracking-tight border",
		templ.KV("bg-[var(--ok)]/10 text-[var(--ok)] border-[var(--ok)]/30", kind == "success" || kind == "ok"),
		templ.KV("bg-[var(--warn)]/10 text-[var(--warn)] border-[var(--warn)]/30", kind == "warning" || kind == "warn"),
		templ.KV("bg-[var(--err)]/10 text-[var(--err)] border-[var(--err)]/30", kind == "error" || kind == "err" || kind == "critical"),
		templ.KV("bg-[var(--accent)]/10 text-[var(--accent)] border-[var(--accent)]/30", kind == "info" || kind == "accent"),
		templ.KV("bg-[var(--panel-sub)] text-[var(--muted)] border-[var(--border)]", kind == "neutral" || kind == ""),
	}>
		{ label }
	</span>
}

// Card exibe um conteiner padrão de seção com borda sutil, padding generoso e título estilizado.
templ Card(title string) {
	<section class="bg-[var(--panel)] border border-[var(--border)] rounded-2xl p-6 lg:p-8 mb-6 shadow-sm space-y-5">
		if title != "" {
			<h3 class="text-[var(--text)] text-sm font-bold uppercase tracking-wider pb-4 border-b border-[var(--border)] mb-4 flex items-center gap-2">
				<div class="w-1.5 h-4 bg-[var(--accent)] rounded-full"></div>
				{ title }
			</h3>
		}
		<div>
			{ children... }
		</div>
	</section>
}

// AlertBanner exibe uma caixa de aviso ou erro em destaque no topo da página.
templ AlertBanner(title string, msg string, kind string) {
	<div class={
		"p-5 rounded-2xl border text-sm flex items-start gap-4 shadow-sm transition-all mb-6",
		templ.KV("bg-[var(--err)]/10 border-[var(--err)]/30 text-[var(--err)]", kind == "error" || kind == "err"),
		templ.KV("bg-[var(--warn)]/10 border-[var(--warn)]/30 text-[var(--warn)]", kind == "warning" || kind == "warn"),
		templ.KV("bg-[var(--ok)]/10 border-[var(--ok)]/30 text-[var(--ok)]", kind == "success" || kind == "ok"),
		templ.KV("bg-[var(--accent)]/10 border-[var(--accent)]/30 text-[var(--text)]", kind == "info" || kind == "accent"),
	}>
		<div class="shrink-0 font-bold text-xl mt-0.5 opacity-90">
			if kind == "error" || kind == "err" {
				⚠
			} else if kind == "warning" || kind == "warn" {
				⚡
			} else if kind == "success" || kind == "ok" {
				✓
			} else {
				ℹ
			}
		</div>
		<div class="space-y-1.5 grow">
			if title != "" {
				<div class="font-bold text-sm tracking-tight text-[var(--text)]">{ title }</div>
			}
			<div class="font-mono text-xs opacity-80 leading-relaxed">{ msg }</div>
		</div>
	</div>
}

// EmptyState exibe uma mensagem de estado vazio padronizada para tabelas ou listas sem dados.
templ EmptyState(msg string) {
	<div class="p-12 text-center border-2 border-dashed border-[var(--border)] rounded-2xl bg-[var(--bg)]/50 space-y-4">
		<div class="text-4xl opacity-20">📭</div>
		<div class="text-sm text-[var(--muted)] font-medium max-w-sm mx-auto">{ msg }</div>
	</div>
}

// Kbd renderiza uma tecla de atalho estilizada no padrão visual do Design System.
templ Kbd(key string) {
	<kbd class="px-2 py-1 rounded-md bg-[var(--bg)] border border-[var(--border)] border-b-2 text-xs font-mono font-bold text-[var(--muted)] shadow-sm">
		{ key }
	</kbd>
}

// LoadingSkeleton exibe linhas de carregamento simuladas (shimmer).
templ LoadingSkeleton(rows int) {
	<div class="space-y-4 animate-pulse p-2">
		for i := 0; i < rows; i++ {
			<div class="h-6 bg-[var(--panel-sub)] rounded-lg w-full"></div>
		}
	</div>
}

// CopyButton exibe um botão de cópia de texto com feedback via Toast.
templ CopyButton(textToCopy string) {
	<button
		type="button"
		class="px-3 py-1.5 rounded-lg bg-[var(--bg)] hover:bg-[var(--panel-hover)] border border-[var(--border)] text-xs font-bold text-[var(--muted)] hover:text-[var(--text)] transition-all cursor-pointer inline-flex items-center gap-2 shadow-sm"
		x-on:click={ fmt.Sprintf("navigator.clipboard.writeText('%s'); if(window.notify) window.notify('Copiado para a área de transferência!', 'info')", textToCopy) }
		title="Copiar para área de transferência"
	>
		📋 Copiar
	</button>
}

// Pager exibe os controles de paginação de dados com espaçamento e padding refinados.
templ Pager(prefix string, current int, total int, hasPrev bool, hasNext bool) {
	<div class="flex items-center justify-between mt-8 text-sm font-medium text-[var(--muted)] pt-6 border-t border-[var(--border)]">
		<div>
			Página <strong class="text-[var(--text)]">{ fmt.Sprintf("%d", current) }</strong>
			if total > 0 {
				de <strong class="text-[var(--text)]">{ fmt.Sprintf("%d", total) }</strong>
			}
		</div>
		<div class="flex items-center gap-3">
			if hasPrev {
				<button class="px-4 py-2 bg-[var(--bg)] hover:bg-[var(--panel-hover)] text-[var(--text)] rounded-xl border border-[var(--border)] transition-all cursor-pointer font-bold text-sm shadow-sm">
					&larr; Anterior
				</button>
			} else {
				<button disabled class="px-4 py-2 bg-[var(--bg)] text-[var(--muted)] opacity-50 rounded-xl border border-[var(--border)] cursor-not-allowed font-bold text-sm">
					&larr; Anterior
				</button>
			}
			if hasNext {
				<button class="px-4 py-2 bg-[var(--bg)] hover:bg-[var(--panel-hover)] text-[var(--text)] rounded-xl border border-[var(--border)] transition-all cursor-pointer font-bold text-sm shadow-sm">
					Próxima &rarr;
				</button>
			} else {
				<button disabled class="px-4 py-2 bg-[var(--bg)] text-[var(--muted)] opacity-50 rounded-xl border border-[var(--border)] cursor-not-allowed font-bold text-sm">
					Próxima &rarr;
				</button>
			}
		</div>
	</div>
}
