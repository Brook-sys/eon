package views

templ Alerts() {
	@layout("Alertas & Notificações", "/dash/alerts", StandardNav("/dash/alerts")) {
		<div x-data="alertsState()" x-init="start()" class="space-y-8">
			<div class="flex items-center justify-between gap-4 bg-[var(--panel)] border border-[var(--border)] rounded-[20px] p-6 shadow-sm">
				<div class="flex items-center gap-5">
					<div class="relative flex h-3 w-3 items-center justify-center">
						<span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75" x-bind:class="connected ? 'bg-[var(--ok)]' : 'bg-[var(--err)]'"></span>
						<span class="relative inline-flex rounded-full h-3 w-3" x-bind:class="connected ? 'bg-[var(--ok)] shadow-[0_0_8px_var(--ok)]' : 'bg-[var(--err)] shadow-[0_0_8px_var(--err)]'"></span>
					</div>
					<div class="flex flex-col">
						<span class="text-[15px] font-bold text-[var(--text)]" x-text="connected ? 'Conectado à API' : 'Sem conexão'"></span>
						<span class="text-[13px] text-[var(--muted)]" x-show="generatedAt">Último sync há <span x-text="generatedAgo"></span></span>
					</div>
				</div>
				<button
					class="px-5 py-2.5 rounded-xl bg-[var(--panel-sub)] hover:bg-[var(--panel-hover)] border border-transparent text-[13px] font-semibold text-[var(--text)] transition-all cursor-pointer shadow-sm flex items-center gap-2"
					x-on:click="refresh()"
				>
					<svg class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
					Atualizar
				</button>
			</div>

			<div class="grid gap-6 grid-cols-1 sm:grid-cols-3">
				@StatCardAlpine("Total de Alertas", "fmt(alerts.length)", "ativos no sistema", "text-[var(--text)]")
				@StatCardAlpine("Críticos", "fmt(criticalCount)", "requerem ação imediata", "text-[var(--err)]")
				@StatCardAlpine("Avisos", "fmt(warningCount)", "verificar em breve", "text-[var(--warn)]")
			</div>

			@card("Log Histórico de Alertas") {
				<div class="space-y-4">
					<template x-if="alerts.length === 0">
						@EmptyState("Nenhum alerta registrado no momento. Sistema estável.")
					</template>
					<div class="space-y-4">
						<template x-for="a in alerts" x-bind:key="a.id ?? Math.random()">
							<div class="p-6 rounded-[20px] border flex flex-col md:flex-row md:items-start gap-5 shadow-sm hover:border-[var(--border-focus)] transition-colors"
								x-bind:class="({
									critical:'bg-[var(--err)]/5 border-[var(--err)]/20',
									warning:'bg-[var(--warn)]/5 border-[var(--warn)]/20',
									info:'bg-[var(--info)]/5 border-[var(--info)]/20'
								})[a.severity] ?? 'bg-[var(--bg)] border-[var(--border)]'">
								
								<div class="shrink-0 flex items-center justify-center w-12 h-12 rounded-full border bg-black/20"
									x-bind:class="({
										critical:'text-[var(--err)] border-[var(--err)]/20',
										warning:'text-[var(--warn)] border-[var(--warn)]/20',
										info:'text-[var(--info)] border-[var(--info)]/20'
									})[a.severity] ?? 'text-[var(--muted)] border-[var(--border)]'">
									<template x-if="a.severity === 'critical'">
										<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
									</template>
									<template x-if="a.severity === 'warning'">
										<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
									</template>
									<template x-if="a.severity === 'info'">
										<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
									</template>
									<template x-if="!a.severity || (a.severity !== 'critical' && a.severity !== 'warning' && a.severity !== 'info')">
										<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
									</template>
								</div>
								
								<div class="space-y-2.5 grow">
									<div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
										<div class="font-bold text-[16px] text-[var(--text)] leading-snug" x-text="a.message"></div>
										<span class="text-[12px] font-mono text-[var(--muted)] font-medium bg-black/20 border border-[var(--border-subtle)] px-3 py-1.5 rounded-lg whitespace-nowrap" x-text="a.timestamp"></span>
									</div>
									<div class="font-mono text-[13px] text-[var(--subtle)] bg-[var(--panel)]/50 p-4 rounded-xl border border-[var(--border)] overflow-x-auto" x-show="a.details" x-text="a.details"></div>
								</div>
							</div>
						</template>
					</div>
				</div>
			}
		</div>
		<script>
			function alertsState() {
				return {
					connected: false,
					generatedAt: null,
					alerts: [],
					
					get generatedAgo() {
						if (!this.generatedAt) return '';
						const s = Math.max(0, (Date.now() - this.generatedAt) / 1000 | 0);
						return s < 60 ? `${s}s atrás` : `${s/60|0}min atrás`;
					},
					get criticalCount() { return this.alerts.filter(a => a.severity === 'critical').length; },
					get warningCount() { return this.alerts.filter(a => a.severity === 'warning').length; },
					
					fmt(n) { return n == null ? '0' : Number(n).toLocaleString('pt-BR'); },
					
					async refresh() {
						try {
							const res = await fetch('/dash/api/alerts');
							const data = await res.json();
							this.alerts = data?.alerts || [];
							this.generatedAt = Date.now();
							this.connected = true;
						} catch (e) {
							this.connected = false;
						}
					},
					
					start() {
						this.refresh();
						setInterval(() => this.refresh(), 10000);
					}
				};
			}
		</script>
	}
}
