package views

templ Alerts() {
	@layout("Alertas & Telemetria", "/dash/alerts", StandardNav("/dash/alerts")) {
		<div x-data="alertsState()" x-init="start()" class="space-y-6">
			<div class="flex items-center gap-3 text-xs bg-[var(--panel)] border border-[var(--border)] rounded-xl px-4 py-2.5 shadow-sm">
				<span class="inline-flex items-center gap-2 font-medium">
					<span
						class="w-2 h-2 rounded-full animate-pulse"
						x-bind:class="connected ? 'bg-[var(--ok)] shadow-[0_0_8px_var(--ok)]' : 'bg-[var(--err)] shadow-[0_0_8px_var(--err)]'"
					></span>
					<span class="text-[var(--text)]" x-show="connected">Inspect API acessível</span>
					<span class="text-[var(--text)]" x-show="!connected">sem resposta da Inspect API</span>
				</span>
				<span class="text-[var(--muted)] border-l border-[var(--border)] pl-3" x-show="generatedAt">atualizado <span x-text="generatedAgo"></span></span>
				<button
					class="ml-auto px-3 py-1.5 rounded-lg border border-[var(--border)] text-[var(--muted)] hover:text-[var(--text)] hover:bg-[var(--panel-hover)] transition-all font-medium"
					x-on:click="refresh()"
				>↻ Atualizar</button>
			</div>

			<!-- KPIs por severidade -->
			<div class="grid gap-4 grid-cols-2 md:grid-cols-4">
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-xl p-4 shadow-sm">
					<div class="text-[11px] uppercase tracking-wider text-[var(--muted)] font-bold mb-1">Total de Alertas</div>
					<div class="text-3xl font-extrabold text-[var(--text)] font-mono tracking-tight my-1" x-text="snap?.total ?? 0"></div>
				</div>
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-xl p-4 shadow-sm">
					<div class="text-[11px] uppercase tracking-wider text-[var(--muted)] font-bold mb-1">Alertas Críticos</div>
					<div class="text-3xl font-extrabold text-[var(--err)] font-mono tracking-tight my-1" x-text="snap?.critical ?? 0"></div>
				</div>
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-xl p-4 shadow-sm">
					<div class="text-[11px] uppercase tracking-wider text-[var(--muted)] font-bold mb-1">Advertências</div>
					<div class="text-3xl font-extrabold text-[var(--warn)] font-mono tracking-tight my-1" x-text="snap?.warnings ?? 0"></div>
				</div>
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-xl p-4 shadow-sm">
					<div class="text-[11px] uppercase tracking-wider text-[var(--muted)] font-bold mb-1">Informativos</div>
					<div class="text-3xl font-extrabold text-[var(--accent)] font-mono tracking-tight my-1" x-text="(snap?.total ?? 0) - (snap?.critical ?? 0) - (snap?.warnings ?? 0)"></div>
				</div>
			</div>

			<!-- Lista agrupada por código -->
			<template x-if="(snap?.alerts ?? []).length === 0">
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-xl p-8 text-center text-sm text-[var(--muted)] border-dashed">
					Nenhum alerta ativo no sistema. O runtime está operando normalmente.
				</div>
			</template>
			<template x-for="group in groupedAlerts()" x-bind:key="group.code">
				<div class="bg-[var(--panel)] border rounded-xl p-5 shadow-sm space-y-3"
					x-bind:class="group.severity === 'critical' ? 'border-[var(--err)]/60' : group.severity === 'warning' ? 'border-[var(--warn)]/60' : 'border-[var(--border)]'">
					<div class="flex gap-3 items-start justify-between border-b border-[var(--border)]/40 pb-3">
						<div class="min-w-0">
							<h4 class="font-bold text-sm text-[var(--text)] font-mono" x-text="group.code"></h4>
							<p class="text-xs text-[var(--muted)]" x-text="group.summary"></p>
						</div>
						<div class="flex items-center gap-2 shrink-0">
							<span
								class="px-2.5 py-0.5 rounded-full text-xs font-semibold border uppercase tracking-wider"
								x-bind:class="{
									'border-[var(--err)]/40 bg-[var(--err)]/10 text-[var(--err)]': group.severity === 'critical',
									'border-[var(--warn)]/40 bg-[var(--warn)]/10 text-[var(--warn)]': group.severity === 'warning',
									'border-[var(--accent)]/40 bg-[var(--accent)]/10 text-[var(--accent)]': group.severity === 'info',
									'border-[var(--border)] bg-[var(--bg)] text-[var(--muted)]': !['critical','warning','info'].includes(group.severity),
								}"
								x-text="group.severity"
							></span>
							<span class="text-xs font-mono text-[var(--muted)] bg-[#0d1420] px-2 py-0.5 rounded border border-[var(--border)]" x-text="'×' + group.items.length"></span>
						</div>
					</div>
					<ul class="space-y-2 pt-1">
						<template x-for="a in group.items" x-bind:key="a.observed_at + (a.detail ?? '')">
							<li class="text-xs flex gap-2.5 items-baseline p-2 rounded-lg bg-[#0d1420] border border-[var(--border)]/30">
								<span class="text-[11px] font-mono text-[var(--muted)] shrink-0" x-text="fmtTime(a.observed_at)"></span>
								<span class="text-[var(--text)]" x-text="a.detail ?? a.summary"></span>
							</li>
						</template>
					</ul>
				</div>
			</template>
		</div>

		<script>
			function alertsState() {
				return {
					connected: false,
					generatedAt: null,
					snap: null,

					get generatedAgo() {
						if (!this.generatedAt) return '';
						const s = Math.max(0, (Date.now() - this.generatedAt) / 1000 | 0);
						return s < 60 ? `${s}s atrás` : `${s/60|0}min atrás`;
					},

					groupedAlerts() {
						const list = this.snap?.alerts ?? [];
						const map = new Map();
						for (const a of list) {
							const code = a.code ?? a.id ?? 'ALERT';
							if (!map.has(code)) {
								map.set(code, {
									code,
									summary: a.summary ?? a.message ?? code,
									severity: a.severity ?? 'warning',
									items: [],
								});
							}
							map.get(code).items.push(a);
						}
						return Array.from(map.values());
					},

					async refresh() {
						try {
							const data = await fetch('/dash/api/alerts').then(r => r.json());
							this.snap = data ?? null;
							this.generatedAt = Date.now();
							this.connected = true;
						} catch (e) { this.connected = false; }
					},

					fmtTime(t) {
						if (!t) return '–';
						const d = new Date(t);
						return isNaN(d) ? '–' : d.toLocaleTimeString('pt-BR');
					},

					start() {
						this.refresh();
						setInterval(() => this.refresh(), 10000);
					}
				};
			}
		</script>
	}
}
