package views

templ Alerts() {
	@layout("Alertas & Telemetria", "/dash/alerts", StandardNav("/dash/alerts")) {
		<div x-data="alertsState()" x-init="start()" class="space-y-4">
			<div class="flex items-center gap-3 text-sm">
				<span class="inline-flex items-center gap-1.5">
					<span class="w-2 h-2 rounded-full" x-bind:class="connected ? 'bg-[var(--ok)]' : 'bg-[var(--err)]'"></span>
					<span x-show="connected">Inspect API acessível</span>
					<span x-show="!connected">sem resposta da Inspect API</span>
				</span>
				<span class="text-[var(--muted)]" x-show="generatedAt">atualizado <span x-text="generatedAgo"></span></span>
				<button
					class="ml-auto px-2 py-1 rounded border border-[var(--border)] text-[var(--muted)] hover:text-[var(--text)]"
					x-on:click="refresh()"
				>↻ Atualizar</button>
			</div>

			<!-- KPIs por severidade -->
			<div class="grid gap-4 grid-cols-2 md:grid-cols-4">
				@card("Total") {
					<p class="text-3xl font-bold text-[var(--text)]" x-text="snap?.total ?? 0"></p>
				}
				@card("Críticos") {
					<p class="text-3xl font-bold text-[var(--err)]" x-text="snap?.critical ?? 0"></p>
				}
				@card("Advertências") {
					<p class="text-3xl font-bold text-[var(--warn)]" x-text="snap?.warnings ?? 0"></p>
				}
				@card("Outros") {
					<p class="text-3xl font-bold text-[var(--muted)]" x-text="(snap?.total ?? 0) - (snap?.critical ?? 0) - (snap?.warnings ?? 0)"></p>
				}
			</div>

			<!-- Lista agrupada por código -->
			<template x-if="(snap?.alerts ?? []).length === 0">
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-lg p-6 text-center text-[var(--muted)]">
					Nenhum alerta ativo no momento.
				</div>
			</template>
			<template x-for="group in groupedAlerts()" x-bind:key="group.code">
				<div class="bg-[var(--panel)] border rounded-lg p-4"
					x-bind:class="group.severity === 'critical' ? 'border-[var(--err)]' : group.severity === 'warning' ? 'border-[var(--warn)]' : 'border-[var(--border)]'">
					<div class="flex gap-3 items-start justify-between mb-2">
						<div class="min-w-0">
							<h4 class="font-semibold text-[var(--text)]" x-text="group.code"></h4>
							<p class="text-sm text-[var(--muted)]" x-text="group.summary"></p>
						</div>
						<div class="flex items-center gap-2 shrink-0">
							<span
								class="px-2 py-0.5 rounded-full text-xs border"
								x-bind:class="{
									'border-[var(--err)] text-[var(--err)]': group.severity === 'critical',
									'border-[var(--warn)] text-[var(--warn)]': group.severity === 'warning',
									'border-[var(--accent)] text-[var(--accent)]': group.severity === 'info',
									'border-[var(--border)] text-[var(--muted)]': !['critical','warning','info'].includes(group.severity),
								}"
								x-text="group.severity"
							></span>
							<span class="text-xs text-[var(--muted)]" x-text="'×' + group.items.length"></span>
						</div>
					</div>
					<ul class="space-y-1.5 mt-3">
						<template x-for="a in group.items" x-bind:key="a.observed_at + (a.detail ?? '')">
							<li class="text-sm flex gap-2 items-baseline">
								<span class="text-xs text-[var(--muted)] shrink-0" x-text="fmtTime(a.observed_at)"></span>
								<span x-text="a.detail ?? a.summary"></span>
							</li>
						</template>
					</ul>
				</div>
			</template>
		</div>

		<script>
			function alertsState() {
				return {
					connected: false,
					generatedAt: null,
					snap: null,

					get generatedAgo() {
						if (!this.generatedAt) return '';
						const s = Math.max(0, (Date.now() - this.generatedAt) / 1000 | 0);
						return s < 60 ? `${s}s atrás` : `${s/60|0}min atrás`;
					},

					async refresh() {
						try {
							const d = await fetch('/dash/api/alerts').then(r => r.json());
							this.snap = d;
							this.generatedAt = Date.now();
							this.connected = true;
						} catch (e) { this.connected = false; }
					},

					groupedAlerts() {
						const map = new Map();
						for (const a of this.snap?.alerts ?? []) {
							if (!map.has(a.code)) map.set(a.code, { code: a.code, severity: a.severity, summary: a.summary, items: [] });
							map.get(a.code).items.push(a);
						}
						const order = { critical: 0, warning: 1, info: 2 };
						return [...map.values()].sort((a, b) => (order[a.severity] ?? 9) - (order[b.severity] ?? 9));
					},

					fmtTime(t) {
						if (!t) return '';
						const d = new Date(t);
						return isNaN(d) ? '' : d.toLocaleTimeString('pt-BR');
					},

					start() {
						this.refresh();
						setInterval(() => this.refresh(), 5000);
					},
				};
			}
		</script>
	}
}
