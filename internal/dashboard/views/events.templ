package views

templ Events() {
	@layout("Eventos", "/dash/events", StandardNav("/dash/events")) {
		<div x-data="eventsState()" x-init="start()" class="space-y-8">
			<div class="flex flex-wrap items-center justify-between gap-4 text-sm bg-[var(--panel)] border border-[var(--border)] rounded-2xl px-5 py-4 shadow-sm">
				<div class="flex items-center gap-4">
					<span class="inline-flex items-center gap-3 font-bold">
						<span
							class="w-3 h-3 rounded-full"
							x-bind:class="connected ? 'bg-[var(--ok)] shadow-[0_0_8px_var(--ok)]' : 'bg-[var(--err)] shadow-[0_0_8px_var(--err)]'"
						></span>
						<span class="text-[var(--text)]" x-text="connected ? 'Conectado à API' : 'Sem conexão'"></span>
					</span>
					<span class="text-[var(--muted)] border-l border-[var(--border)] pl-4 font-medium" x-show="generatedAt">
						atualizado <span x-text="generatedAgo"></span>
					</span>
				</div>
				<div class="flex items-center gap-3">
					<button
						class="px-4 py-2 rounded-xl border border-[var(--border)] bg-[var(--bg)] text-[var(--muted)] hover:text-[var(--text)] hover:bg-[var(--panel-hover)] transition-all font-bold text-sm shadow-sm cursor-pointer"
						x-on:click="refresh()"
					>↻ Atualizar</button>
				</div>
			</div>

			<div class="grid gap-6 grid-cols-1 sm:grid-cols-2">
				@StatCardAlpine("Eventos no Buffer", "fmt(events.length)", "histórico recente em memória", "text-[var(--text)]")
				@StatCardAlpine("Head Atual", "fmt(events.length > 0 ? events[0].sequence : 0)", "maior sequência observada", "text-[var(--accent)]")
			</div>

			@card("Log de Eventos (SSE Histórico + Live)") {
				<div class="font-mono text-xs space-y-2.5 max-h-[40rem] overflow-y-auto pr-3">
					<template x-if="events.length === 0">
						@EmptyState("Aguardando eventos do sistema...")
					</template>
					<template x-for="e in events" x-bind:key="e.sequence ?? Math.random()">
						<div class="flex flex-col gap-1 p-3 rounded-xl bg-[var(--bg)] border border-[var(--border)] hover:border-[var(--border-focus)]/50 transition-colors shadow-sm cursor-pointer" x-on:click="window.location.href='/dash/events/' + e.sequence">
							<div class="flex gap-4 items-center">
								<span class="text-[var(--subtle)] shrink-0 text-xs w-16 text-right font-bold" x-text="'#' + (e.sequence ?? '?')"></span>
								<span
									class="shrink-0 px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider"
									x-bind:class="({
										error: 'bg-[var(--err)]/10 text-[var(--err)] border border-[var(--err)]/20',
										warning: 'bg-[var(--warn)]/10 text-[var(--warn)] border border-[var(--warn)]/20',
										info: 'bg-[var(--accent)]/10 text-[var(--accent)] border border-[var(--accent)]/20'
									})[e.kind] ?? 'bg-[var(--panel-sub)] text-[var(--muted)] border border-[var(--border)]'"
									x-text="e.kind"
								></span>
								<span class="truncate text-[var(--text)] font-semibold" x-text="e.summary ?? e.kind"></span>
							</div>
							<div class="flex gap-4">
								<div class="w-16 shrink-0"></div>
								<div class="text-[11px] text-[var(--muted)] opacity-70 truncate" x-show="e.details" x-text="JSON.stringify(e.details).substring(0, 150)"></div>
							</div>
						</div>
					</template>
				</div>
			}
		</div>
		<script>
			function eventsState() {
				return {
					connected: false,
					generatedAt: null,
					events: [],
					
					get generatedAgo() {
						if (!this.generatedAt) return '';
						const s = Math.max(0, (Date.now() - this.generatedAt) / 1000 | 0);
						return s < 60 ? `${s}s atrás` : `${s/60|0}min atrás`;
					},
					
					fmt(n) { return n == null ? '0' : Number(n).toLocaleString('pt-BR'); },
					
					async refresh() {
						try {
							const res = await fetch('/dash/api/events');
							const data = await res.json();
							if(data && Array.isArray(data.events)) {
								this.events = data.events;
							}
							this.generatedAt = Date.now();
							this.connected = true;
						} catch (e) {
							this.connected = false;
						}
					},
					
					startSSE() {
						const es = new EventSource('/dash/api/events/stream');
						es.onmessage = (m) => {
							try {
								const d = JSON.parse(m.data);
								// Evitar duplicatas
								if(!this.events.find(x => x.sequence === d.sequence)) {
									this.events.unshift(d);
									if(this.events.length > 500) this.events.pop();
								}
							} catch {}
						};
					},
					
					start() {
						this.refresh();
						this.startSSE();
					}
				};
			}
		</script>
	}
}
