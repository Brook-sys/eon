package views

templ Events() {
	@layout("Eventos", "/dash/events", StandardNav("/dash/events")) {
		<div x-data="eventsState()" x-init="start()" class="space-y-6">

			<!-- Métricas Resumidas dos Eventos -->
			<div class="grid gap-4 grid-cols-2 lg:grid-cols-4 text-xs">
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-xl p-4">
					<div class="text-[var(--muted)] font-medium uppercase tracking-wider mb-1 text-[11px]">Total Carregado</div>
					<div class="text-2xl font-bold font-mono text-[var(--accent)] mt-1" x-text="events.length"></div>
				</div>
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-xl p-4">
					<div class="text-[var(--muted)] font-medium uppercase tracking-wider mb-1 text-[11px]">Erros Identificados</div>
					<div class="text-2xl font-bold font-mono text-[var(--err)] mt-1" x-text="metrics.errors"></div>
				</div>
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-xl p-4">
					<div class="text-[var(--muted)] font-medium uppercase tracking-wider mb-1 text-[11px]">Alertas / Avisos</div>
					<div class="text-2xl font-bold font-mono text-[var(--warn)] mt-1" x-text="metrics.warnings"></div>
				</div>
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-xl p-4">
					<div class="text-[var(--muted)] font-medium uppercase tracking-wider mb-1 text-[11px]">Última Sequência</div>
					<div class="text-2xl font-bold font-mono text-[var(--ok)] mt-1" x-text="'#' + lastSeq"></div>
				</div>
			</div>

			<!-- Barra de filtros e buscas -->
			<div class="flex flex-wrap gap-3 items-end">
				<label class="flex flex-col gap-1 text-xs text-[var(--muted)]">
					Kind / Tipo
					<select
						class="bg-[var(--panel-sub)] border border-[var(--border)] rounded-lg px-3 py-1.5 text-xs text-[var(--text)]"
						x-model="filterKind"
						x-on:change="reload()"
					>
						<option value="">todos os tipos</option>
						<template x-for="k in knownKinds" x-bind:key="k">
							<option x-bind:value="k" x-text="k"></option>
						</template>
					</select>
				</label>
				<label class="flex flex-col gap-1 text-xs text-[var(--muted)]">
					Namespace
					<input
						class="bg-[var(--panel-sub)] border border-[var(--border)] rounded-lg px-3 py-1.5 text-xs text-[var(--text)] w-44"
						placeholder="ex.: telegram"
						x-model="filterNamespace"
						x-on:change="reload()"
					/>
				</label>
				<label class="flex flex-col gap-1 text-xs text-[var(--muted)]">
					Busca no payload
					<input
						class="bg-[var(--panel-sub)] border border-[var(--border)] rounded-lg px-3 py-1.5 text-xs text-[var(--text)] w-56"
						placeholder="texto livre (client-side)"
						x-model="searchText"
					/>
				</label>
				<button
					class="px-3 py-1.5 rounded-lg border border-[var(--border)] text-xs font-medium hover:bg-white/[0.04]"
					x-on:click="reload()"
				>Aplicar</button>
				<button
					class="px-3 py-1.5 rounded-lg border text-xs font-semibold transition-all cursor-pointer"
					x-bind:class="liveTail ? 'border-[var(--ok)]/40 text-[var(--ok)] bg-[var(--ok)]/10' : 'border-[var(--border)] text-[var(--muted)] hover:bg-white/[0.04]'"
					x-on:click="toggleTail()"
					x-text="liveTail ? '⏸ Pausar Live Stream' : '▶ Conectar Live Stream'"
				></button>
				<button
					class="px-2.5 py-1.5 rounded-lg border border-[var(--border)] text-xs text-[var(--muted)] hover:text-[var(--text)] hover:bg-white/[0.04]"
					x-on:click="resetFilters()"
				>Limpar Filtros</button>
				<span class="text-xs text-[var(--muted)] ml-auto font-mono" x-text="statusLine"></span>
			</div>

			<!-- Lista de eventos -->
			@card("Log de Eventos") {
				<div class="mono text-xs space-y-1 max-h-[34rem] overflow-y-auto pr-1 divide-y divide-[var(--border-subtle)]">
					<template x-if="visibleEvents.length === 0">
						<p class="text-[var(--muted)] p-3 text-center" x-text="loading ? 'Carregando eventos…' : 'Nenhum evento encontrado com os filtros atuais.'"></p>
					</template>
					<template x-for="ev in visibleEvents" x-bind:key="ev.sequence ?? Math.random()">
						<div class="py-2 space-y-1.5">
							<div class="flex items-center gap-2 cursor-pointer select-none" x-on:click="ev._expanded = !ev._expanded">
								<span class="text-[var(--muted)] font-mono text-[11px]" x-text="'#' + ev.sequence"></span>
								<span
									class="px-1.5 py-0.2 rounded text-[10px] font-semibold uppercase tracking-wider"
									x-bind:class="kindBadgeClass(ev.kind)"
									x-text="ev.kind ?? 'UNKNOWN'"
								></span>
								<span class="text-[var(--muted)] text-[11px] font-mono" x-show="ev.namespace" x-text="ev.namespace"></span>
								<span class="text-[var(--muted)] text-[11px] font-mono ml-auto" x-text="fmtTime(ev.occurred_at)"></span>
								<button type="button" class="text-[var(--muted)] hover:text-[var(--text)] text-xs px-1" x-text="ev._expanded ? '▲' : '▼'"></button>
							</div>
							<div class="text-[var(--text)] break-all font-mono text-[11px] pl-2 border-l-2 border-[var(--accent)]/30" x-text="summaryLine(ev)"></div>

							<!-- Detalhes JSON do Evento -->
							<div x-show="ev._expanded" x-cloak class="mt-2 p-3 rounded-lg bg-[var(--panel-sub)] border border-[var(--border)] text-[11px] font-mono space-y-2">
								<div class="flex justify-between items-center border-b border-[var(--border-subtle)] pb-1.5">
									<span class="text-[var(--muted)]">JSON do Evento</span>
									<button
										type="button"
										class="px-2 py-0.5 rounded bg-white/[0.06] text-[var(--accent)] hover:bg-white/[0.1] text-[10px] font-semibold transition-all cursor-pointer"
										x-on:click.stop="copyEventJSON(ev)"
									>
										📋 Copiar JSON
									</button>
								</div>
								<pre class="overflow-x-auto text-[var(--muted)] text-[11px] whitespace-pre-wrap" x-text="JSON.stringify(ev, null, 2)"></pre>
							</div>
						</div>
					</template>
				</div>
			}
		</div>

		<script>
			function eventsState() {
				return {
					events: [],
					loading: false,
					filterKind: '',
					filterNamespace: '',
					searchText: '',
					liveTail: true,
					sse: null,
					statusLine: '',

					get metrics() {
						let errs = 0, warns = 0;
						for (const e of this.events) {
							const k = (e.kind || '').toLowerCase();
							if (k.includes('error') || k.includes('fail')) errs++;
							else if (k.includes('warn')) warns++;
						}
						return { errors: errs, warnings: warns };
					},

					get lastSeq() {
						if (!this.events.length) return 0;
						return Math.max(...this.events.map(e => e.sequence || 0));
					},

					get knownKinds() {
						const set = new Set();
						for (const e of this.events) {
							if (e.kind) set.add(e.kind);
						}
						return Array.from(set).sort();
					},

					get visibleEvents() {
						const q = this.searchText.trim().toLowerCase();
						return this.events.filter(e => {
							if (this.filterKind && e.kind !== this.filterKind) return false;
							if (this.filterNamespace && !(e.namespace || '').toLowerCase().includes(this.filterNamespace.toLowerCase())) return false;
							if (q) {
								const str = JSON.stringify(e).toLowerCase();
								if (!str.includes(q)) return false;
							}
							return true;
						});
					},

					async fetchLatest() {
						this.loading = true;
						try {
							const res = await fetch('/dash/api/events?limit=100');
							const data = await res.json();
							this.events = (data?.events ?? []).map(e => ({ ...e, _expanded: false }));
							this.statusLine = `${this.events.length} eventos carregados`;
						} catch (err) {
							this.statusLine = 'Erro ao carregar log';
						} finally {
							this.loading = false;
						}
					},

					reload() {
						this.fetchLatest();
					},

					resetFilters() {
						this.filterKind = '';
						this.filterNamespace = '';
						this.searchText = '';
						this.reload();
					},

					toggleTail() {
						this.liveTail = !this.liveTail;
						if (this.liveTail) {
							this.startSSE();
							if (window.notify) window.notify('Stream SSE conectada', 'info');
						} else {
							this.stopSSE();
							if (window.notify) window.notify('Stream SSE pausada', 'warning');
						}
					},

					startSSE() {
						if (this.sse) return;
						this.sse = new EventSource('/dash/api/events/stream');
						this.sse.onmessage = (msg) => {
							try {
								const ev = JSON.parse(msg.data);
								ev._expanded = false;
								this.events.unshift(ev);
								if (this.events.length > 200) this.events.pop();
							} catch {}
						};
						this.sse.onerror = () => {
							this.statusLine = 'SSE reconectando...';
						};
					},

					stopSSE() {
						if (this.sse) {
							this.sse.close();
							this.sse = null;
						}
					},

					copyEventJSON(ev) {
						const jsonStr = JSON.stringify(ev, null, 2);
						navigator.clipboard.writeText(jsonStr).then(() => {
							if (window.notify) window.notify('JSON do evento copiado!', 'success');
						}).catch(() => {
							if (window.notify) window.notify('Erro ao copiar JSON', 'error');
						});
					},

					kindBadgeClass(kind) {
						const k = (kind || '').toLowerCase();
						if (k.includes('error') || k.includes('fail')) return 'bg-[var(--err)]/15 text-[var(--err)]';
						if (k.includes('warn')) return 'bg-[var(--warn)]/15 text-[var(--warn)]';
						return 'bg-[var(--accent)]/15 text-[var(--accent)]';
					},

					summaryLine(ev) {
						if (ev.payload && typeof ev.payload === 'object') {
							if (ev.payload.summary) return ev.payload.summary;
							if (ev.payload.message) return ev.payload.message;
						}
						return JSON.stringify(ev.payload || {}).slice(0, 140);
					},

					fmtTime(t) {
						if (!t) return '–';
						const d = new Date(t);
						return isNaN(d) ? '–' : d.toLocaleTimeString('pt-BR');
					},

					start() {
						this.fetchLatest();
						if (this.liveTail) this.startSSE();
					}
				};
			}
		</script>
	}
}
