package views

templ Overview() {
	@layout("Overview", "/dash", StandardNav("/dash")) {
		<div x-data="overviewState()" x-init="start()" class="space-y-4">

			<!-- Status de conexão -->
			<div class="flex items-center gap-3 text-sm">
				<span class="inline-flex items-center gap-1.5">
					<span
						class="w-2 h-2 rounded-full"
						x-bind:class="connected ? 'bg-[var(--ok)]' : 'bg-[var(--err)]'"
					></span>
					<span x-text="connected ? 'Conectado à Inspect API' : 'Sem conexão com Inspect API'"></span>
				</span>
				<span class="text-[var(--muted)]" x-show="generatedAt">
					atualizado <span x-text="generatedAgo"></span>
				</span>
				<button
					class="ml-auto px-2 py-1 rounded border border-[var(--border)] text-[var(--muted)] hover:text-[var(--text)]"
					x-on:click="refresh()"
				>↻ Atualizar</button>
			</div>

			<!-- Contadores operacionais -->
			<div class="grid gap-4 grid-cols-2 lg:grid-cols-4">
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-lg p-4 flex flex-col justify-between">
					<div class="text-xs uppercase tracking-widest text-[var(--muted)] font-medium mb-1">Comandos pendentes</div>
					<div class="text-3xl font-bold text-[var(--accent)] font-mono tracking-tight my-0.5" x-text="fmt(ov.pending_commands)"></div>
					<div class="text-xs text-[var(--muted)] mt-1">aguardando o kernel</div>
				</div>
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-lg p-4 flex flex-col justify-between">
					<div class="text-xs uppercase tracking-widest text-[var(--muted)] font-medium mb-1">Perguntas pendentes</div>
					<div class="text-3xl font-bold text-[var(--warn)] font-mono tracking-tight my-0.5" x-text="fmt(ov.pending_operator_questions)"></div>
					<div class="text-xs text-[var(--muted)] mt-1">human input required</div>
				</div>
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-lg p-4 flex flex-col justify-between">
					<div class="text-xs uppercase tracking-widest text-[var(--muted)] font-medium mb-1">Subagents evictos</div>
					<div class="text-3xl font-bold text-[var(--err)] font-mono tracking-tight my-0.5" x-text="fmt(ov.evicted_subagents)"></div>
					<div class="text-xs text-[var(--muted)] mt-1">lease perdido</div>
				</div>
				<div class="bg-[var(--panel)] border border-[var(--border)] rounded-lg p-4 flex flex-col justify-between">
					<div class="text-xs uppercase tracking-widest text-[var(--muted)] font-medium mb-1">Head de eventos</div>
					<div class="text-3xl font-bold text-[var(--ok)] font-mono tracking-tight my-0.5" x-text="fmt(ov.event_head_sequence)"></div>
					<div class="text-xs text-[var(--muted)] mt-1">sequência do log</div>
				</div>
			</div>

			<!-- Controle Operacional do Runtime e Missão -->
			@card("Controle Operacional & Execução") {
				<div class="space-y-3 text-sm">
					<div class="flex flex-wrap items-center gap-3">
						<span class="font-medium text-[var(--text)]">Estado do Despacho:</span>
						<span
							class="px-2 py-0.5 rounded text-xs font-mono font-semibold uppercase"
							x-bind:class="ov.process_mode === 'PAUSED' ? 'bg-[var(--warn)]/20 text-[var(--warn)]' : 'bg-[var(--ok)]/20 text-[var(--ok)]'"
							x-text="ov.process_mode ?? 'STANDBY'"
						></span>
						<span class="text-xs text-[var(--muted)]" x-show="ov.mission && ov.mission.mission_id">
							Missão: <strong x-text="ov.mission.mission_id"></strong> (Rev <span x-text="ov.mission.active_revision"></span>)
						</span>
					</div>

					<div class="flex flex-wrap items-center gap-2 pt-2 border-t border-[var(--border)]">
						<button
							type="button"
							class="px-3 py-1.5 rounded bg-[var(--warn)]/20 text-[var(--warn)] border border-[var(--warn)]/40 hover:bg-[var(--warn)]/30 font-medium text-xs flex items-center gap-1.5"
							x-bind:disabled="cmdLoading || !ov.mission || !ov.mission.mission_id || ov.process_mode === 'PAUSED'"
							x-on:click="pauseMission()"
						>
							⏸ Pausar Despacho
						</button>
						<button
							type="button"
							class="px-3 py-1.5 rounded bg-[var(--ok)]/20 text-[var(--ok)] border border-[var(--ok)]/40 hover:bg-[var(--ok)]/30 font-medium text-xs flex items-center gap-1.5"
							x-bind:disabled="cmdLoading || !ov.mission || !ov.mission.mission_id || ov.process_mode !== 'PAUSED'"
							x-on:click="resumeMission()"
						>
							▶ Retomar Despacho
						</button>
						<button
							type="button"
							class="px-3 py-1.5 rounded bg-[var(--err)]/20 text-[var(--err)] border border-[var(--err)]/40 hover:bg-[var(--err)]/30 font-medium text-xs flex items-center gap-1.5 ml-auto"
							x-bind:disabled="cmdLoading || !ov.mission || !ov.mission.mission_id"
							x-on:click="cancelMission()"
						>
							⏹ Cancelar Missão
						</button>
					</div>

					<!-- Feedback de comandos -->
					<div x-show="cmdStatus" class="mt-2 text-xs font-mono p-2 rounded bg-[var(--bg)] border border-[var(--border)]" x-bind:class="cmdIsErr ? 'text-[var(--err)]' : 'text-[var(--ok)]'" x-text="cmdStatus"></div>
				</div>
			}

			<!-- Perguntas Pendentes do Operador -->
			<div x-show="questions && questions.length > 0">
				@card("Perguntas Pendentes do Operador") {
					<div class="space-y-3 text-sm">
						<template x-for="q in questions" x-bind:key="q.id">
							<div class="p-3 rounded border border-[var(--warn)]/40 bg-[var(--warn)]/5 space-y-2">
								<div class="flex justify-between items-start">
									<div class="font-medium text-[var(--text)]" x-text="q.prompt"></div>
									<span class="text-xs font-mono text-[var(--muted)]" x-text="q.id"></span>
								</div>
								<div class="flex gap-2 items-center" x-data="{ ansText: '' }">
									<input
										type="text"
										class="flex-1 px-3 py-1 text-xs rounded bg-[var(--bg)] border border-[var(--border)] text-[var(--text)]"
										placeholder="Digite sua resposta..."
										x-model="ansText"
										x-on:keydown.enter="submitAnswer(q, ansText)"
									/>
									<button
										type="button"
										class="px-3 py-1 rounded bg-[var(--accent)] text-white text-xs font-medium hover:opacity-90"
										x-on:click="submitAnswer(q, ansText)"
									>
										Responder
									</button>
								</div>
							</div>
						</template>
					</div>
				}
			</div>

			<!-- Saúde do runtime e alertas -->
			<div class="grid gap-4 md:grid-cols-2">
				@card("Runtime") {
					<div class="space-y-1.5 text-sm">
						<div class="flex justify-between">
							<span class="text-[var(--muted)]">Health</span>
							<span x-text="health.status ?? '—'"></span>
						</div>
						<div class="flex justify-between">
							<span class="text-[var(--muted)]">Versão</span>
							<span x-text="(ov.runtime && ov.runtime.version) ?? '—'"></span>
						</div>
						<div class="flex justify-between">
							<span class="text-[var(--muted)]">Modo</span>
							<span x-text="ov.process_mode ?? '—'"></span>
						</div>
						<div class="flex justify-between">
							<span class="text-[var(--muted)]">Revisão de controle</span>
							<span x-text="fmt(ov.control_revision)"></span>
						</div>
						<div class="flex justify-between">
							<span class="text-[var(--muted)]">Missão</span>
							<span x-text="(ov.mission && ov.mission.mission_id) ?? 'nenhuma'"></span>
						</div>
					</div>
				}
				@card("Alertas") {
					<template x-if="alerts.length === 0">
						<p class="text-sm text-[var(--muted)]">Nenhum alerta ativo.</p>
					</template>
					<ul class="space-y-1.5 text-sm" x-show="alerts.length > 0">
						<template x-for="a in alerts.slice(0, 8)" x-bind:key="a.id ?? a.message">
							<li class="flex gap-2 items-start">
								@templ.Raw(`<span class="mt-0.5 w-2 h-2 shrink-0 rounded-full"
									x-bind:class="({
										critical:'bg-[var(--err)]', warning:'bg-[var(--warn)]',
										info:'bg-[var(--accent)]'
									})[a.severity] ?? 'bg-[var(--muted)]'"></span>`)
								<span x-text="a.message ?? JSON.stringify(a)"></span>
							</li>
						</template>
					</ul>
				}
			</div>

			<!-- Feed de eventos ao vivo (SSE) -->
			@card("Eventos ao vivo") {
				<div class="flex items-center gap-2 mb-3 text-xs">
					<span
						class="inline-flex items-center gap-1"
						x-bind:class="sseOn ? 'text-[var(--ok)]' : 'text-[var(--muted)]'"
					>
						<span
							class="w-1.5 h-1.5 rounded-full"
							x-bind:class="sseOn ? 'bg-[var(--ok)]' : 'bg-[var(--muted)]'"
						></span>
						<span x-text="sseOn ? 'SSE ativo' : 'SSE desconectado'"></span>
					</span>
					<span class="text-[var(--muted)] ml-auto" x-text="events.length + ' recentes'"></span>
				</div>
				<div class="mono text-xs space-y-1 max-h-80 overflow-y-auto">
					<template x-if="events.length === 0">
						<p class="text-[var(--muted)]">Aguardando eventos…</p>
					</template>
					<template x-for="e in events" x-bind:key="e.seq ?? Math.random()">
						<div class="flex gap-2 items-baseline">
							<span class="text-[var(--muted)] shrink-0" x-text="'#' + (e.sequence ?? '?')"></span>
							<span
								class="shrink-0 px-1 rounded"
								x-bind:class="({
									error: 'text-[var(--err)]',
									warning: 'text-[var(--warn)]'
								})[e.type] ?? 'text-[var(--accent)]'"
								x-text="e.type"
							></span>
							<span class="truncate" x-text="e.summary ?? JSON.stringify(e).slice(0, 120)"></span>
						</div>
					</template>
				</div>
			}
		</div>

		<script>
			function overviewState() {
				return {
					connected: false,
					generatedAt: null,
					ov: {},
					health: {},
					alerts: [],
					events: [],
					questions: [],
					sseOn: false,
					cmdLoading: false,
					cmdStatus: '',
					cmdIsErr: false,

					get generatedAgo() {
						if (!this.generatedAt) return '';
						const s = Math.max(0, (Date.now() - this.generatedAt) / 1000 | 0);
						return s < 60 ? `${s}s atrás` : `${s/60|0}min atrás`;
					},

					fmt(v) { return v == null ? '–' : String(v); },

					async refresh() {
						try {
							const [h, o, a, q] = await Promise.all([
								fetch('/dash/api/health').then(r => r.json()),
								fetch('/dash/api/overview').then(r => r.json()),
								fetch('/dash/api/alerts').then(r => r.json()),
								fetch('/dash/api/control/questions').then(r => r.json()).catch(() => ({ questions: [] }))
							]);
							this.health = h ?? {};
							this.ov = o ?? {};
							this.alerts = Array.isArray(a) ? a : (a?.alerts ?? []);
							this.questions = q?.questions ?? [];
							this.generatedAt = Date.now();
							this.connected = true;
						} catch (e) {
							this.connected = false;
						}
					},

					async submitCommand(kind, reason) {
						if (!this.ov.mission || !this.ov.mission.mission_id) return;
						this.cmdLoading = true;
						this.cmdStatus = 'Enviando comando ' + kind + '...';
						this.cmdIsErr = false;
						try {
							const payload = {
								schema_version: 1,
								idempotency_key: 'cmd-' + Date.now() + '-' + Math.random().toString(36).substring(2, 7),
								actor_type: 'OPERATOR',
								actor_id: 'dashboard-ui',
								kind: kind,
								target: { mission_id: this.ov.mission.mission_id },
								expected_revision: Number(this.ov.mission.active_revision || 1),
								reason: reason || ('comando ' + kind + ' via dashboard v2')
							};
							const res = await fetch('/dash/api/control/commands', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify(payload)
							});
							const data = await res.json();
							if (!res.ok) throw new Error(data.error?.message || data.message || ('HTTP ' + res.status));
							this.cmdStatus = 'Comando ' + kind + ' enviado com sucesso! Receipt ID: ' + (data.command_id || 'OK');
							await this.refresh();
						} catch (err) {
							this.cmdStatus = 'Erro ao enviar comando: ' + err.message;
							this.cmdIsErr = true;
						} finally {
							this.cmdLoading = false;
						}
					},

					pauseMission() {
						this.submitCommand('PAUSE_MISSION', 'Pausa manual solicitada via painel v2');
					},

					resumeMission() {
						this.submitCommand('RESUME_MISSION', 'Retomada manual solicitada via painel v2');
					},

					cancelMission() {
						if (confirm('Tem certeza que deseja CANCELAR a missão ativa? Esta ação não pode ser desfeita.')) {
							this.submitCommand('CANCEL_MISSION', 'Cancelamento manual solicitado via painel v2');
						}
					},

					async submitAnswer(q, text) {
						if (!text.trim()) return;
						try {
							const payload = {
								schema_version: 1,
								idempotency_key: 'ans-' + Date.now() + '-' + Math.random().toString(36).substring(2, 7),
								expected_question_revision: q.revision || 1,
								kind: 'TEXT',
								text: text.trim()
							};
							const res = await fetch('/dash/api/control/questions/' + encodeURIComponent(q.id) + '/answers', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify(payload)
							});
							const data = await res.json();
							if (!res.ok) throw new Error(data.error?.message || ('HTTP ' + res.status));
							await this.refresh();
						} catch (err) {
							alert('Erro ao responder pergunta: ' + err.message);
						}
					},

					connectSSE() {
						const es = new EventSource('/dash/api/events/stream');
						es.onopen = () => { this.sseOn = true; };
						es.onerror = () => { this.sseOn = false; };
						es.onmessage = (m) => {
							try {
								const e = JSON.parse(m.data);
								this.events.unshift(e);
								if (this.events.length > 60) this.events.length = 60;
							} catch {}
						};
					},

					start() {
						this.refresh();
						setInterval(() => this.refresh(), 5000);
						this.connectSSE();
					},
				};
			}
		</script>
	}
}
