{
  "schema_version": 1,
  "name": "simpler-format-recovery-campaign-groq",
  "timeout_seconds": 90,
  "max_calls": 3,
  "injected_failures": 2,
  "max_output_tokens": 192,
  "probe_prompt": "You are completing an integration test for the SimplerFormat JSON recovery stage. Return a valid JSON matching the exact output schema but simplified to just the data required without the outer wrapper.",
  "bindings": [
    {
      "provider": "nim",
      "provider_kind": "openai_compatible",
      "binding_id": "nim",
      "base_url": "https://integrate.api.nvidia.com/v1",
      "model": "mistralai/mistral-small-4-119b-2603",
      "api_key_env": "NVIDIA_NIM_API_KEY",
      "max_output_field": "max_tokens",
      "context_tokens": 8000,
      "priority": 1
    },
    {
      "provider": "groq",
      "provider_kind": "openai_compatible",
      "binding_id": "groq",
      "base_url": "https://api.groq.com/openai/v1",
      "model": "llama-3.1-8b-instant",
      "api_key_env": "GROQ_API_KEY",
      "max_output_field": "max_tokens",
      "context_tokens": 8000,
      "priority": 2
    }
  ]
}
