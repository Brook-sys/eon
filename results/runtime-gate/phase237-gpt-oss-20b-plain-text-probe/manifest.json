{
  "schema_version": 1,
  "name": "phase237-gpt-oss-20b-plain-text-probe",
  "timeout_seconds": 45,
  "max_calls": 1,
  "max_output_tokens": 64,
  "output_schema": "exact_text",
  "probe_prompt": "Reply with exactly the text: Hello\n\nNo markdown, no explanation, just the word Hello.",
  "expected_response": "Hello",
  "seed_primary_circuit_seconds": 1,
  "bindings": [
    {
      "provider": "nim",
      "provider_kind": "nvidia_nim",
      "binding_id": "nim-seeded-open",
      "base_url": "https://integrate.api.nvidia.com/v1",
      "model": "mistralai/mistral-small-4-119b-2603",
      "api_key_env": "NVIDIA_NIM_API_KEY",
      "max_output_field": "max_tokens",
      "context_tokens": 8192,
      "priority": 1
    },
    {
      "provider": "groq",
      "provider_kind": "groq",
      "binding_id": "groq-gpt-oss-20b",
      "base_url": "https://api.groq.com/openai/v1",
      "model": "openai/gpt-oss-20b",
      "api_key_env": "GROQ_API_KEY",
      "max_output_field": "max_completion_tokens",
      "context_tokens": 8192,
      "priority": 2
    }
  ]
}
