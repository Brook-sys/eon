{
  "schema_version": 1,
  "name": "phase444-deepseek_evaluation",
  "timeout_seconds": 45,
  "max_calls": 1,
  "max_output_tokens": 512,
  "probe_prompt": "Analyze the following sequence: 2, 4, 8, 16. What is the next number?\nYou must output strictly this exact text and nothing else:\nREADY",
  "expected_response": "READY",
  "seed_primary_circuit_seconds": 30,
  "bindings": [
    {
      "provider": "nim-deepseek",
      "provider_kind": "openai_compatible",
      "binding_id": "b1",
      "base_url": "https://integrate.api.nvidia.com/v1",
      "model": "deepseek-ai/deepseek-v4-flash-0731",
      "api_key_env": "NVIDIA_NIM_API_KEY",
      "max_output_field": "max_tokens",
      "context_tokens": 128000,
      "priority": 100
    },
    {
      "provider": "nim-llama31",
      "provider_kind": "openai_compatible",
      "binding_id": "b2",
      "base_url": "https://integrate.api.nvidia.com/v1",
      "model": "meta/llama-3.1-8b-instruct",
      "api_key_env": "NVIDIA_NIM_API_KEY",
      "max_output_field": "max_tokens",
      "context_tokens": 8192,
      "priority": 50
    }
  ]
}
