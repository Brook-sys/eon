{
  "schema_version": 1,
  "name": "Phase 470 Simpler Format Recovery Live",
  "timeout_seconds": 60,
  "max_calls": 3,
  "injected_failures": 2,
  "max_output_tokens": 256,
  "probe_prompt": "Are you ready? Reply 'READY'",
  "bindings": [
    {
      "provider": "groq",
      "provider_kind": "groq",
      "binding_id": "simpler_recovery_target",
      "base_url": "https://api.groq.com/openai/v1",
      "model": "llama-3.1-8b-instant",
      "api_key_env": "GROQ_API_KEY",
      "max_output_field": "max_tokens",
      "context_tokens": 8000,
      "priority": 1
    },
    {
      "provider": "nvidia",
      "provider_kind": "nvidia_nim",
      "binding_id": "fallback",
      "base_url": "https://integrate.api.nvidia.com/v1",
      "model": "meta/llama-3.1-8b-instruct",
      "api_key_env": "NVIDIA_NIM_API_KEY",
      "max_output_field": "max_tokens",
      "context_tokens": 8000,
      "priority": 2
    }
  ]
}
