{
  "schema_version": 1,
  "name": "massive-fire-sweep-v1",
  "limits": {
    "max_calls_total": 2000,
    "max_calls_per_model": 500,
    "concurrency": 3,
    "timeout_per_call_seconds": 45,
    "max_tokens_per_call": 256,
    "inter_call_min_delay_ms": 250,
    "retry_after_429_respect_header": true,
    "max_retries_per_call": 2,
    "budget_usd_ceiling": 0
  },
  "temperatures": [
    0.0,
    0.3,
    0.7,
    1.0
  ],
  "repetitions": 10,
  "providers": [
    {
      "id": "groq",
      "base_url": "https://api.groq.com/openai/v1",
      "api_key_env": "GROQ_API_KEY",
      "models": [
        "llama-3.3-70b-versatile",
        "llama-3.1-8b-instant",
        "openai/gpt-oss-20b",
        "openai/gpt-oss-120b",
        "qwen/qwen3.6-27b",
        "allam-2-7b"
      ]
    },
    {
      "id": "nvidia_nim",
      "base_url": "https://integrate.api.nvidia.com/v1",
      "api_key_env": "NVIDIA_NIM_API_KEY",
      "models": [
        "meta/llama-3.1-8b-instruct",
        "meta/llama-3.3-70b-instruct",
        "nvidia/llama-3.1-nemotron-70b-instruct",
        "nvidia/llama-3.3-nemotron-super-49b-v1.5"
      ]
    }
  ]
